					<Body><![CDATA[// This method will call the API for the results of MAPE which are stored in the db_results database
traceln("Call API");]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResultSet]]></ReturnType>
					<Id>1751195561529</Id>
					<Name><![CDATA[retrieveEvents_execute]]></Name>
					<X>180</X><Y>3850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return db_events.getResultSet("SELECT * FROM Table_Events");]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1751195561531</Id>
					<Name><![CDATA[retrieveEvents_executeAndMap]]></Name>
					<X>180</X><Y>3820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try (var rs = retrieveEvents_execute()) {
	while (rs.next()) {
		var item = new Events();
		item.event_id = rs.getInt("EVENT_ID");
		item.event_name = rs.getString("EVENT_NAME");
		item.event_type = rs.getString("EVENT_TYPE");
		item.policy_id = rs.getInt("PROCESS_ID");
		item.actual_result = rs.getDouble("ACTUAL_RESULT");
		item.included = rs.getBoolean("INCLUDED");
		item.agent_id = rs.getString("AGENT_ID");
		
		ActualEvents.add(item);
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1751395316782</Id>
					<Name><![CDATA[fAddStock]]></Name>
					<X>180</X><Y>4550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int counter = 0;
int cycle = 0;
int I = 0;
int IO = 0;
int S = 0;
int B = 0;
int O = 0;
int ITI1 = 0;
int ITI2 = 0;
int WIPI1 = 0;
int WIPI2 = 0;
int PSR = 0;
double uihc = 0.0;
double ubc = 0.0;
//double TC = 0.0;

for (int i = 0; i< this.cBeerGameResults.size(); i++){

if (this.cBeerGameResults.get(i).t == agent.vCycle_id
	&& this.cBeerGameResults.get(i).i.equals(agent.id)){
//	&& this.cBeerGameResults.get(i).Sim_id.equals("")){//only write the results for the execution space
	
	String agent_id = agent.id;
	cycle = agent.vCycle_id;
//	if (agent.type.equals("AT2")){
///		IO = cBeerGameResults.get(i).ENDCD;//for retailer IO = ENDCD
//	} else {
		IO = cBeerGameResults.get(i).IO;
//	}
	S = this.cBeerGameResults.get(i).S;
	I = this.cBeerGameResults.get(i).I;
	B = this.cBeerGameResults.get(i).B;
	O = this.cBeerGameResults.get(i).O;
	WIPI1 = this.cBeerGameResults.get(i).WIPI1;
	WIPI2 = this.cBeerGameResults.get(i).WIPI2;
	ITI1 = this.cBeerGameResults.get(i).ITI1;
	ITI2 = this.cBeerGameResults.get(i).ITI2;
	PSR = this.cBeerGameResults.get(i).PSR;
	uihc = this.cBeerGameResults.get(i).uihc;
	ubc = this.cBeerGameResults.get(i).ubc;
	double TC = this.cBeerGameResults.get(i).TC;
	double sl_des = this.cBeerGameResults.get(i).SL_des;
	double eecd = this.cBeerGameResults.get(i).EECD;
	int ei = this.cBeerGameResults.get(i).EI;
	double eo = 0;// select EO below for the next cycle
	double ia = this.cBeerGameResults.get(i).IA;
	int sl = this.cBeerGameResults.get(i).SL;
	double sla = this.cBeerGameResults.get(i).SLA;
	int ti = this.cBeerGameResults.get(i).TI;
	
	TTC = TTC + TC;//add agent cost to total cost

//retrieve the eo value

for (int k = 0; k< this.cBeerGameResults.size(); k++){

if (this.cBeerGameResults.get(k).t == agent.vCycle_id+1 //EO for next cycle
	&& this.cBeerGameResults.get(k).i.equals(agent.id)){
	
		eo = this.cBeerGameResults.get(k).EO;
		}
	}	
	
	if (counter == 0){
	 // Create a new Result object
		if (agent.vCycle_id == 0){	 
	 		sl = 0;
	 		sla = 0;
	 		ia = 0;
	 		ei = 0;
	 	}


        Result newResult = new Result(agent_id, cycle, IO, S,I, B, O, ITI1, ITI2, WIPI1, WIPI2, PSR, uihc, ubc, TC, sl_des, eecd, ei, eo, ia, sl, sla, ti);

        // Add the Result object to the ArrayList
        this.cOperationsOutcome.add(newResult);
        counter = 1;//mark that there is a record for this agent in the OperationsOutcome dataset
        
    } else {
    
    
    for (int j = 0; j < this.cOperationsOutcome.size(); j++){
   	if (this.cOperationsOutcome.get(j).agent_id.equals(agent.id)
	   	&&this.cOperationsOutcome.get(j).cycle == agent.vCycle_id){
	   	this.cOperationsOutcome.get(j).IO = IO;
	   	this.cOperationsOutcome.get(j).S = S;
    	this.cOperationsOutcome.get(j).I = I;
    	this.cOperationsOutcome.get(j).B = B; 
    	this.cOperationsOutcome.get(j).ITI1 = ITI1;
     	this.cOperationsOutcome.get(j).ITI2 = ITI2;
     	this.cOperationsOutcome.get(j).WIPI1 = WIPI1;
     	this.cOperationsOutcome.get(j).WIPI2 = WIPI2; 
     	this.cOperationsOutcome.get(j).PSR = PSR;   	   	
//    	this.cBeerGameResults.get(i).ITI1 = ITI1;//CHECK
//    	this.cBeerGameResults.get(i).ITI2 = ITI2;//CHECK
//    	this.cBeerGameResults.get(i).WIPI1 = WIPI1;//CHECK
//    	this.cBeerGameResults.get(i).WIPI2 = WIPI2;//CHECK
//    	this.cBeerGameResults.get(i).PSR = PSR;   	
    	this.cOperationsOutcome.get(j).uihc = uihc;
    	this.cOperationsOutcome.get(j).ubc = ubc;
    	this.cOperationsOutcome.get(j).TC = TC;
    	this.cOperationsOutcome.get(j).sl_des = sl_des;
    	this.cOperationsOutcome.get(j).eecd = eecd;
    	this.cOperationsOutcome.get(j).ei = ei;
    	this.cOperationsOutcome.get(j).eo = eo;
    	this.cOperationsOutcome.get(j).ia = ia;
    	this.cOperationsOutcome.get(j).sl = sl;
    	this.cOperationsOutcome.get(j).sla = sla;
    	this.cOperationsOutcome.get(j).ti = ti;
    	}    	   	
      }   	
    }
  }
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1751483180747</Id>
					<Name><![CDATA[fWriteResultsDB]]></Name>
					<X>180</X><Y>4620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Start of storing in DB");



for (int i = 0; i < this.cOperationsOutcome.size(); i++){


if (agent.type.equals("AT1")
	&& (agent.main.cOperationsOutcome.get(i).cycle == 0)){//customer
	agent.main.cOperationsOutcome.get(i).IO = 0;//repair ENDCD for customer
}
//if (this.cOperationsOutcome.get(i).agent_id.equals(agent.id)){
insertInto(db_beergame_results).columns(
	db_beergame_results.cycle_id,
	db_beergame_results.agent,
	db_beergame_results.incoming_order,
	db_beergame_results.shipment,
	db_beergame_results.inventory,
	db_beergame_results.backlog,
	db_beergame_results.order_quantity,
	db_beergame_results.iti1,
	db_beergame_results.iti2,
	db_beergame_results.wipi1,
	db_beergame_results.wipi2,
	db_beergame_results.psr,
	db_beergame_results.stock_costs,
	db_beergame_results.backlog_costs,
	db_beergame_results.total_costs,
	db_beergame_results.sl_des,
	db_beergame_results.eecd,
	db_beergame_results.ei,
	db_beergame_results.eo,
	db_beergame_results.ia,
	db_beergame_results.sl,
	db_beergame_results.sla,
	db_beergame_results.ti
	)
	.values(
	this.cOperationsOutcome.get(i).cycle,
	this.cOperationsOutcome.get(i).agent_id,
	this.cOperationsOutcome.get(i).IO,
	this.cOperationsOutcome.get(i).S,
	this.cOperationsOutcome.get(i).I,
	this.cOperationsOutcome.get(i).B,
	this.cOperationsOutcome.get(i).O,
	this.cOperationsOutcome.get(i).ITI1,
	this.cOperationsOutcome.get(i).ITI2,
	this.cOperationsOutcome.get(i).WIPI1,
	this.cOperationsOutcome.get(i).WIPI2,
	this.cOperationsOutcome.get(i).PSR,
	this.cOperationsOutcome.get(i).uihc,
	this.cOperationsOutcome.get(i).ubc,
	this.cOperationsOutcome.get(i).TC,
	this.cOperationsOutcome.get(i).sl_des,
	this.cOperationsOutcome.get(i).eecd,
	this.cOperationsOutcome.get(i).ei,
	this.cOperationsOutcome.get(i).eo,
	this.cOperationsOutcome.get(i).ia,
	this.cOperationsOutcome.get(i).sl,
	this.cOperationsOutcome.get(i).sla,
	this.cOperationsOutcome.get(i).ti
	
	)
	.execute();

//	}
}

traceln("START EVALUATION");
for (int i = 0; i < Orders.size(); i++){
	traceln(Orders.get(i));
}
//traceln(cOperationsOutcome);
//traceln(Orders);
// Save the Excel file to a specific path
//excelFile.save("C:\Users\GuidoWillemsen\OneDrive - ISCTE-IUL\CRP Model\Anylogic\BG_Results.xlsx");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1752000513183</Id>
					<Name><![CDATA[fFillGraphics]]></Name>
					<X>180</X><Y>4740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Start to fill Graphics");
for (int i = 0; i< agent.main.cOperationsOutcome.size(); i++){
	if (agent.main.cOperationsOutcome.get(i).agent_id.equals(agent.id)
		&& agent.main.cOperationsOutcome.get(i).cycle == agent.vCycle_id - 1){
		Result resultGraphic = new Result();
		resultGraphic.cycle = agent.main.cOperationsOutcome.get(i).cycle;
		resultGraphic.agent_id = agent.main.cOperationsOutcome.get(i).agent_id;
		resultGraphic.I = agent.main.cOperationsOutcome.get(i).I;
		resultGraphic.B = agent.main.cOperationsOutcome.get(i).B;
		resultGraphic.uihc = agent.main.cOperationsOutcome.get(i).uihc;
		resultGraphic.ubc = agent.main.cOperationsOutcome.get(i).ubc;
		resultGraphic.TC = agent.main.cOperationsOutcome.get(i).TC;
	
	cSourceGraphics.add(resultGraphic);

	
//fill graphic parameters
if (agent.type.equals("AT2")){//retailer
    vBeerGame_I_Ret = agent.main.cOperationsOutcome.get(i).I;
	vBeerGame_B_Ret = agent.main.cOperationsOutcome.get(i).B;
	vBeerGame_O_Ret = agent.main.cOperationsOutcome.get(i).O;
	vBeerGame_uihc_Ret = agent.main.cOperationsOutcome.get(i).uihc;
	vBeerGame_ubc_Ret = agent.main.cOperationsOutcome.get(i).ubc;
	vBeerGame_TC_Ret = agent.main.cOperationsOutcome.get(i).TC;
	vCycle_Ret = agent.vCycle_id;
} else if (agent.type.equals("AT3")){//wholesaler
    vBeerGame_I_Whol = agent.main.cOperationsOutcome.get(i).I;
	vBeerGame_B_Whol = agent.main.cOperationsOutcome.get(i).B;
	vBeerGame_O_Whol = agent.main.cOperationsOutcome.get(i).O;
	vBeerGame_uihc_Whol = agent.main.cOperationsOutcome.get(i).uihc;
	vBeerGame_ubc_Whol = agent.main.cOperationsOutcome.get(i).ubc;
	vBeerGame_TC_Whol = agent.main.cOperationsOutcome.get(i).TC; 
	vCycle_Whol = agent.vCycle_id; 
} else if (agent.type.equals("AT4")){//distributor
    vBeerGame_I_Dis = agent.main.cOperationsOutcome.get(i).I;
	vBeerGame_B_Dis = agent.main.cOperationsOutcome.get(i).B;
	vBeerGame_O_Dis = agent.main.cOperationsOutcome.get(i).O;
	vBeerGame_uihc_Dis = agent.main.cOperationsOutcome.get(i).uihc;
	vBeerGame_ubc_Dis = agent.main.cOperationsOutcome.get(i).ubc;
	vBeerGame_TC_Dis = agent.main.cOperationsOutcome.get(i).TC;	
	vCycle_Dis = agent.vCycle_id; 
} else if (agent.type.equals("AT5")){//factory
    vBeerGame_I_Fac = agent.main.cOperationsOutcome.get(i).I;
	vBeerGame_B_Fac = agent.main.cOperationsOutcome.get(i).B;
	vBeerGame_uihc_Fac = agent.main.cOperationsOutcome.get(i).uihc;
	vBeerGame_ubc_Fac = agent.main.cOperationsOutcome.get(i).ubc;
	vBeerGame_TC_Fac = agent.main.cOperationsOutcome.get(i).TC;
	vCycle_Fac = agent.vCycle_id;
} else if (agent.type.equals("AT1")){//Consumer
	vBeerGame_O_Con = agent.main.cOperationsOutcome.get(i).O;
	vCycle_Con = agent.vCycle_id; 
	} else {
	traceln("No results to be added to graphic parameter"); 
	}
 }
}	]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1757621601539</Id>
					<Name><![CDATA[fCalculateTotalResult]]></Name>
					<X>180</X><Y>4940</Y>
					<Label><X>5</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int I = 0;
int B = 0;
double TCa = 0.0;

String agent_type = selectFirstValue(
		"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
		agent.id);	
if (!agent_type.equals("AT1")
	&&agent.vCycle_id > 0){//not for consumers


for (int i = 0; i < this.cBeerGameResults.size(); i++){
	if (this.cBeerGameResults.get(i).agent_id.equals(agent.id)
	&& this.cBeerGameResults.get(i).t == agent.vCycle_id){
//	&& this.cBeerGameResults.get(i).Sim_id.equals("")){//exclude simulation results
		I = this.cBeerGameResults.get(i).I;
		B = this.cBeerGameResults.get(i).B;
		}
	if (this.cBeerGameResults.get(i).agent_id.equals(agent.id)
	&& this.cBeerGameResults.get(i).t == agent.vCycle_id-1){
//	&& this.cBeerGameResults.get(i).Sim_id.equals("")){//exclude simulation results
		TCa = this.cBeerGameResults.get(i).TC;
		}	
}
//TTC = TTC + (agent.uihc_i * I + agent.ubc_i);//[70] Add the agent costs to the total costs
//agent.TC = agent.TC + (agent.uihc_i * agent.I + agent.ubc_i * agent.B);//[69] Calculate Total cost for this agent
agent.TC = TCa + agent.uihc_i * I + agent.ubc_i * B;//[69] Calculate Total cost for this agent


for (int k = 0; k < this.cBeerGameResults.size();k++){
		if (this.cBeerGameResults.get(k).t == (agent.vCycle_id)
			&& this.cBeerGameResults.get(k).agent_id.equals(agent.id)){
//			&& this.cBeerGameResults.get(k).Sim_id.equals("")) {//exclude simulation results
			this.cBeerGameResults.get(k).TC = agent.TC;
		}
	}
			
		
//agent.TTCagent = agent.TTCagent+agent.TC;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
