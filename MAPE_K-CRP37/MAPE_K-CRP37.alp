	 String agent_type = "";
	 
	 String i = "";

	 int t = 0;
	 
	 String order_id = "";

	 double sat = 1.0;

	 double mdt = 1.0;

	 double st = 1.0;

	 double plt = 2.0;

	 double wsl = 1.0;

	 double θ = 0.2;

	 int I_des = 0;

	 double SL_des = 0.0;

	 double uihc_i = 0.5;

	 double ubc_i = 1;

	 int ENDCD = 0;

	 double EECD = 0.0;

	 double EO = 0.0;

	 int B = 0;

	 int I = 0;

	 int ITI1 = 0;

	 int ITI2 = 0;

	 int WIPI1 = 0;

	 int WIPI2 = 0;

	 int O = 0;

	 int PSR = 0;

	 int S = 0;

