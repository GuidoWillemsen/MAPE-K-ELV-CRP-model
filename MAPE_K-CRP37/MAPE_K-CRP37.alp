			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1745074386874</Id>
					<Name><![CDATA[fSendGesture]]></Name>
					<X>410</X><Y>560</Y>
					<Label><X>5</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[

int subject_index = 0;
Gesture tmp_msg = new Gesture();
Subject tmp_receiver = new Subject();
ArrayList agents_In_TG = new ArrayList<>();

//loop through all the gestures to publish
for (int i = 0; i < agent.gestureList.size(); i++){//1
 if((agent.gestureList.get(i) != null)
 	&& (agent.gestureList.get(i).requestor.equals(agent.id))
 	&& (agent.gestureList.get(i).status.equals("New"))){//2

int policyInTG = 0;

//loop through all the agents that have to be published to
	for (int j = 0; j < agent.publish_TrustGroups.size(); j++){//3
	
//	boolean isPresent = agents_In_TG.contains(agent.publish_TrustGroups.get(i).agent_id);
	
//	if((agent.publish_TrustGroups.get(j) != null)&& isPresent == false){
	if((agent.publish_TrustGroups.get(j) != null)&& !agent.publish_TrustGroups.get(j).agent_id.equals(agent.id)){//4
	Gesture add_message_old = new Gesture();
		for (int k = 0; k < main.subject.size(); k++){//5
			if ((main.subject.get(k).id.equals(agent.publish_TrustGroups.get(j).agent_id))){//6
				subject_index = k; 
		
		
		String sagent = agent.publish_TrustGroups.get(j).agent_id;
	
	Gesture add_message = new Gesture();
	
	add_message.message_id = agent.gestureList.get(i).message_id;

	add_message.policy_id = agent.gestureList.get(i).policy_id;
	
	add_message.requestor = agent.id;
	
	add_message.policy_name = agent.gestureList.get(i).policy_name;
	
	add_message.object_type = agent.gestureList.get(i).object_type;

	add_message.attribute = agent.gestureList.get(i).attribute;

	add_message.value = agent.gestureList.get(i).value;

	add_message.score = agent.gestureList.get(i).score;

//	add_message.source = agent.id;	

	add_message.source = agent.gestureList.get(i).source;

	add_message.status = "Requested";
	
 //select only the relevant Trustgroup for this policy
 
 if ((add_message.object_type.equals(agent.gestureList.get(i).object_type))
 	&& (add_message.attribute.equals(agent.gestureList.get(i).attribute))){//7	
		
	if (add_message_old.message_id != add_message.message_id){//8
	if (main.subject.get(subject_index).crp_Workspace != null &&
    !main.subject.get(subject_index).crp_Workspace.isEmpty()){//9
    
    	boolean addCRP = false;//initialize the parameter to add a record to the local CRP workspace of the agent


// Check if the gesture should be added to the CRP workspace
boolean shouldAddGesture = false;
List<Gesture> agentsInTrustGroup = main.subject.get(subject_index).crp_Workspace;


for (int m = 0; m < agentsInTrustGroup.size(); m++) {//10
    Gesture  currentEntry = agentsInTrustGroup.get(m);

    // Check if the policy_id does not match and the subject IDs are equal
    if (currentEntry.policy_id != agent.gestureList.get(i).policy_id
        && main.subject.get(subject_index).id.equals(main.subject.get(k).id)
        && add_message.policy_id != policyInTG) {//11
        shouldAddGesture = true;
        break; // Early termination if condition is met
    }//11
}//10

if (shouldAddGesture == true) {//12
    // Add the gesture to the CRP workspace
    main.subject.get(subject_index).crp_Workspace.add(add_message);

    // Add the agent ID to the trust group list
    agents_In_TG.add(agent.publish_TrustGroups.get(j).agent_id);
    
    policyInTG = add_message.policy_id;
}//12
/*		for (int m = 0; m < (main.subject.get(subject_index).crp_Workspace.size()); m++){
		if (main.subject.get(subject_index).crp_Workspace.get(m).policy_id != agent.gestureList.get(i).policy_id
			&& main.subject.get(subject_index).id.equals(main.subject.get(k).id)){
			addCRP = true;	
			}
			}
		if (addCRP == true){
			main.subject.get(subject_index).crp_Workspace.add(add_message);//add this gesture to all related agents in the CRP workspace
	
			agents_In_TG.add(agent.publish_TrustGroups.get(j).agent_id);			
		}*/
	} else {//9	
// add when no CRP Workspace for other agent exists
			main.subject.get(subject_index).crp_Workspace.add(add_message);//add this gesture to all related agents in the CRP workspace
	
			agents_In_TG.add(agent.publish_TrustGroups.get(j).agent_id);
	}//9
		
	}//8
	add_message_old = add_message; //keep this record for the The previous process is already processed sequence

	} else {//7
		traceln("No relevant object types have to be requested");
	}//7	
	}//7	
	}//5
	}//4
	}//3
  }	//2	
 }//1
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1745074538230</Id>
					<Name><![CDATA[fSelectTrustGroup]]></Name>
					<X>410</X><Y>480</Y>
					<Label><X>5</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// Clear existing collections
agent.agent_TrustGroups.clear();
agent.selected_TrustGroups.clear();
agent.publish_TrustGroups.clear();

    // Track added trust groups to avoid duplicates
   Set<Integer> addedTrustGroups = new HashSet<>();

// Fetch trust groups for the current agent
List<Tuple> agent_trustGroup = selectFrom(tg_agent)
    .where(tg_agent.agent_id.eq(agent.id))
    .list();

// Populate agent_TrustGroups
for (Tuple row : agent_trustGroup) {
    int trustGroup_Id = row.get(tg_agent.trustgroup_id);
    String trustAgent = row.get(tg_agent.agent_id);
    agent.agent_TrustGroups.add(new trustgroup(trustGroup_Id, trustAgent));
}

// For each workspace policy, find matching trust groups
for (Gesture workspacePolicy : agent.crp_Workspace) {
    if (workspacePolicy == null) continue;

    List<Tuple> selected_TrustGroup = selectFrom(trustgroups)
        .where(
            trustgroups.object_type.eq(workspacePolicy.object_type)
                .and(trustgroups.attribute.eq(workspacePolicy.attribute))
        )
        .list();

    // Track added trust groups to avoid duplicates
//    Set<Integer> addedTrustGroups = new HashSet<>();

    for (Tuple selection : selected_TrustGroup) {
        int tg = selection.get(trustgroups.trustgroup_id);
        

        // Check if the current agent is in this trust group
        for (trustgroup agentTG : agent.agent_TrustGroups) {
            if (agentTG.trustgroup_id == tg && !addedTrustGroups.contains(tg)) {
                agent.selected_TrustGroups.add(new trustgroup(tg, agent.id));
                addedTrustGroups.add(tg);
                break; // No need to check other agent trust groups for this tg
            }
        }
    }
 }

// For each selected trust group, find all agents (excluding self) to publish to
for (trustgroup selectedTG : agent.selected_TrustGroups) {
    List<Tuple> publish_Agents = selectFrom(tg_agent)
        .where(tg_agent.trustgroup_id.eq(selectedTG.trustgroup_id))
        .list();

    for (Tuple p_agent : publish_Agents) {
        String agent_id = p_agent.get(tg_agent.agent_id);
        if (!agent_id.equals(agent.id)) { // Exclude self
            agent.publish_TrustGroups.add(
                new trustgroup(selectedTG.trustgroup_id, agent_id)
            );
        }
    }
//add a random agent to this selection to promote new entrants
//for now this functionality is ommitted.    
    
  }



]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764534186704</Id>
					<Name><![CDATA[fFillCRPWorkspace]]></Name>
					<X>410</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//agent.crp_Workspace.clear();

for (int i = 0; i < agent.learningWorkspace.size(); i++){

	if (agent.learningWorkspace.get(i).agent_id.equals(agent.id)){	

	String message_id ="";
	String requestor = agent.id;
	int policy_id = agent.learningWorkspace.get(i).policy_id;
	String policy_name = agent.learningWorkspace.get(i).policy_name;
	String object_type = agent.learningWorkspace.get(i).object_type;
	String attribute = agent.learningWorkspace.get(i).attribute;
	double value = agent.learningWorkspace.get(i).policy_value;
	double score = agent.learningWorkspace.get(i).policy_score;
	double expected_result = agent.learningWorkspace.get(i).expected_result;
	String source = agent.learningWorkspace.get(i).source;
	String status = "New";
	
	Gesture CRP = new Gesture (
		message_id,
		requestor,
		policy_id,
		policy_name,
		object_type,
		attribute,
		value,
		score,
		expected_result,
		source,
		status);
//	for (int k = 0; k < agent.crp_Workspace.size(); k++){
//		if (agent.crp_Workspace.get(k).policy_id != policy_id){
		
		agent.crp_Workspace.add(CRP);
//	}
//	}
}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764764631929</Id>
					<Name><![CDATA[fDefineGesture]]></Name>
					<X>410</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int counter = 0;
agent.gestureList.clear();//initialize the gesture list

for (int i = 0; i< agent.crp_Workspace.size(); i++){

if ((agent.crp_Workspace.get(i).requestor.equals(agent.id)) 
	&& (agent.crp_Workspace.get(i).status.equals("New"))){
	
// find the highest score of the policy in the agents table.
	
	List<Tuple> highest_policy = selectFrom(policy)
	.orderBy(policy.score.desc())
	.where(policy.agent_id.eq(agent.id))
	.where(policy.object_type.eq(agent.crp_Workspace.get(i).object_type))
	.where(policy.attribute.eq(agent.crp_Workspace.get(i).attribute))
	.list();

	counter = 0;//reset counter
	
	for (Tuple hp_record : highest_policy) {
		if(counter == 0){//pick the highest value from the sorted list
	
	Gesture applyGesture = new Gesture();
	String uuid = java.util.UUID.randomUUID().toString();
	
	applyGesture.message_id = uuid;
	applyGesture.requestor = agent.crp_Workspace.get(i).requestor;
	applyGesture.policy_id = agent.crp_Workspace.get(i).policy_id;
	applyGesture.policy_name = agent.crp_Workspace.get(i).policy_name;
	applyGesture.object_type = agent.crp_Workspace.get(i).object_type;
	applyGesture.attribute = agent.crp_Workspace.get(i).attribute;
	applyGesture.value = agent.crp_Workspace.get(i).value;
	applyGesture.score = agent.crp_Workspace.get(i).score;
	applyGesture.source = agent.id;
	applyGesture.status = "New";
	
	// Add the Gesture object to the ArrayList
    agent.gestureList.add(applyGesture);
    counter++; //increase the counter, so that it will only select the highest record
	}
   }
   agent.crp_Workspace.get(i).status = "Requested";
  }
}
if (agent.gestureList.isEmpty()){
	traceln ("No CRP messages selected");
	agent.noCRPPossible = true;
	}]]></Body>
				</Function>
