					</Parameter>
					<Body><![CDATA[boolean newResult = false;

traceln("Execution of the Production Order");

//EXECUTION SPACE
for (int i = 0; i < agent.executionWorkspace.size(); i++){
	if (agent.executionWorkspace.get(i).status.equals("Active")){
		if (agent.executionWorkspace.get(i).start_event.equals("E3")){
		
		if (agent.executionWorkspace.get(i).attribute.equals("plt")){//CHECK TO REMOVE - NOT USED
			vplt = agent.executionWorkspace.get(i).value;
		  agent.executionWorkspace.get(i).status = "Processed";					
	  } else {
	  	traceln("No parameter is relevant for execution");
	 }
   } 




// agent.executionWorkspace.get(i).status = "Processed";
 }
/* moved to calculate stock
if (agent.vCycle_id == 0){
	traceln("Initialization");
	} else if (agent.vCycle_id == 1){
	  agent.PSR = 4;//[22] Production Start rate is fixed
	  agent.WIPI1 = agent.PSR;// [38]
	  newResult = true;
	} else {
		agent.WIPI1 = agent.PSR;// [38]
	  newResult = true;
	  }
	  	
	//add the parameters to the results table
	
if (newResult == true){	
 for (int k = 0 ; k < this.cBeerGameResults.size();k++){
 
 if (this.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.cBeerGameResults.get(k).t == agent.vCycle_id){
	
		this.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
		this.cBeerGameResults.get(k).PSR = agent.PSR;
		this.cBeerGameResults.get(k).Status = "Produced";
 	} else {
 	
	traceln("No records found in BeerGame results");
  }	
 } 
} */
}
]]></Body>
