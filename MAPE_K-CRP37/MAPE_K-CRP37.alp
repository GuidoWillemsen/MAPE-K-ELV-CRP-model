			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1743754494336</Id>
					<Name><![CDATA[fLaunchProcess]]></Name>
					<X>90</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//activate image

isActive = true;
/*
//define agent type of active agent

	String agent_type = selectFirstValue(
			"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
			agent.id);	
int i = ei;

if (vSim_id != null){
try {
   pProcess_id =    selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E5");//for each process define the start event here as a variable
	
	pPolicy_id = selectFirstValue(//Check the policy that is related to the MRP process
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E5");
  } catch (Exception e) {
    traceln("No process for this start event E5 for agent "+agent.id );
  } 

if (vSim_id != null){//only for simulation
	pPolicy_type = agent.simulationWorkspace.get(i).policy_type_id;
	pObject_type = agent.simulationWorkspace.get(i).object_type;
	pAttribute = agent.simulationWorkspace.get(i).attribute;
	pValue = agent.simulationWorkspace.get(i).policy_value;
	return;
 }
} else {//execution spaces	
		
	

}*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1743754494338</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>5</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
traceln("Execution of the MRP run");

//EXECUTION WORKSPACE
	for (int i = 0; i < agent.executionWorkspace.size(); i++){
		if (agent.executionWorkspace.get(i).status.equals("Active")){
			if (agent.executionWorkspace.get(i).start_event.equals("E5")){
		
			if (agent.executionWorkspace.get(i).attribute.equals("sat")){
				agent.vsat = agent.executionWorkspace.get(i).value;
			} else if (agent.executionWorkspace.get(i).attribute.equals("theta")){
				agent.vtheta = agent.executionWorkspace.get(i).value;
			} else if (agent.executionWorkspace.get(i).attribute.equals("mdt")){
				agent.vmdt = agent.executionWorkspace.get(i).value;
			} else if (agent.executionWorkspace.get(i).attribute.equals("plt")){
				agent.vplt = agent.executionWorkspace.get(i).value;
			} else if (agent.executionWorkspace.get(i).attribute.equals("st")){
				agent.vst = agent.executionWorkspace.get(i).value;
			} else if (agent.executionWorkspace.get(i).attribute.equals("wsl")){
				agent.vwsl = agent.executionWorkspace.get(i).value;
	  		} else {
	  		traceln("No parameter is relevant for execution");
			}
		    agent.executionWorkspace.get(i).status = "Processed";			
  		} else if (agent.executionWorkspace.get(i).start_event.equals("E1")){
  			 if (agent.executionWorkspace.get(i).attribute.equals("theta")){
				agent.vtheta = agent.executionWorkspace.get(i).value;
			}
  		}
 	}

	}


//CONTINUE FOR BOTH SIMULATION AND EXECUTION	
int incoming_order = 0;
String status = "";
double theta = 0.0;
double EO = 0.0;
double EECD= 0.0;

if (agent.vCycle_id == 0){
	traceln("Initialization");
}
	//calculate the expected order quantity 									
	if (agent.type.equals("AT1")){//when the agent is a customer)
		traceln("No action to be done");
	
			
 		} else if (agent.type.equals("AT2")){
 			if (agent.vCycle_id == 0 ){
 
			agent.EECD = main.pStartOrderQty;//4;//[8] expected end customer demand at the start
 		  	agent.EO = main.pStartOrderQty;//4;// [9] expected orders			
			} else {
/* 		    for (int i = 0;i < this.main.Orderse();i++){
 		    if (main.Orders.get(i).Status.equals("Assigned")
 		  	  && main.Orders.get(i).Agent_id.equals(agent.id)){
 		  	  String supplier = main.Orders.get(i).Partner;
 		  	  
 		  		for (int k = 0; k < main.subject.size(); k++){//find all the IO quantities of suppliers
 		  			if (main.subject.get(k).id == supplier){
 		  				incoming_order = incoming_order + main.subject.get(k).IO;
 		  				}
 		  			}
 		  		}
 		  		}*/			
/*		if (agent.vCycle_id <= 1){//CHECK if this is cover at the order registration
				  incoming_order = 4;
		} else {	
		    for (int i = 0;i < this.main.Orders.size();i++){
 		    if (this.main.Orders.get(i).Status.equals("Assigned")
 		      && this.main.Orders.get(i).Cycle_id == agent.vCycle_id-1 //outgoing order for customer in previous cycle	
 			  && this.main.Orders.get(i).Agent_type.equals("AT1")){
 		  	  	incoming_order = incoming_order + (int) this.main.Orders.get(i).Quantity;
 		  	   		}
 		  		}
 		  	}*/
//			agent.EECD = (int) Math.ceil(agent.EECD + (agent.vtheta * (incoming_order - agent.EECD))); //[47] agent.EECD is the value of previous cycle
			agent.EECD = agent.EECD + (agent.vtheta * (agent.ENDCD - agent.EECD)); //[47] agent.EECD is the value of previous cycle


// agent.EECD + (agent.vtheta * (agent.ENDCD - agent.EECD)); //[47] agent.EECD is the value of previous cycle
//add EECD to results table

		BeerGame_Results addEECD = new BeerGame_Results();
   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		addEECD.agent_id = "A8";//for now hard coded, should be dynamic
 		addEECD.agent_type = "AT1";//for now hard coded, should be dynamic
