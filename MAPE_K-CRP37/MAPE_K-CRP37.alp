					<Body><![CDATA[
String previous_attribute = ""; //initialization of the attribute loop to select the highest score  


List<Learning> sortedByAttributeScore = agent.learningWorkspaceTemp.stream()
    .sorted(Comparator.comparing(Learning::getAttribute) // First sort by 'attribute'
            .thenComparing(Learning::getPolicyScore, Comparator.reverseOrder()))    // Then sort by 'policy_score'
    .collect(Collectors.toList());

                                      
agent.learningWorkspaceTemp.clear();

//List sortedByAttributeAsc = sortAscending( agent.learningWorkspace, a -> a.attribute );

for (int j = 0; j < sortedByAttributeScore.size(); j++) {//(1)
		
    if (!sortedByAttributeScore.get(j).attribute.equals(previous_attribute)){//(2)

//		only the first record of the learningWorkspace is selected. As the selection is sorted based on the highest score, the first record for each unique attribute is sufficient
	  	agent.learningWorkspaceTemp.add(sortedByAttributeScore.get(j));

		}
			   
	   previous_attribute = sortedByAttributeScore.get(j).attribute;
	 }//(1)



//double old_policy_value = 0.0;


for (int i = 0; i < agent.learningWorkspaceTemp.size(); i++) {//(1)

	// when new policy is created from the exploration
	// phase, it will be added to the policy and the
	// symptom_policy table
//	if (agent.learningWorkspaceTemp
//			.get(i).status == "Explored" || agent.learningWorkspaceTemp
//			.get(i).status == "Exploited") {//(2)

		// define the highest value in the policy table
		// ############################################
		int max_p = 0;
		int old_policy_id = agent.learningWorkspaceTemp.get(i).policy_id;
		List<Tuple> p_rows = selectFrom(policy).list();

		for (Tuple p_row : p_rows) {//(3)
			traceln(p_row.get(policy.policy_id));
			if (p_row.get(policy.policy_id) > max_p)
				max_p = p_row.get(policy.policy_id);
		}

		if ((agent.learningWorkspaceTemp.get(i).status == "Exploited" || 
			agent.learningWorkspaceTemp.get(i).status == "Explored") && 
			agent.learningWorkspaceTemp.get(i).policy_type_id == 1) {//(4) select
															// the explore records for policies type 1 (policies)
															
//			old_policy_value = agent.learningWorkspaceTemp.get(i).policy_value;
			
			int value1 = max_p + 1;
			String value2 = agent.learningWorkspaceTemp
					.get(i).policy_name;
			String value3 = agent.learningWorkspaceTemp
					.get(i).agent_id;
			int value4 = agent.learningWorkspaceTemp
					.get(i).policy_type_id;
			String value5 = agent.learningWorkspaceTemp
					.get(i).script;
			String value6 = agent.learningWorkspaceTemp
					.get(i).object_type;
			String value7 = agent.learningWorkspaceTemp
					.get(i).attribute;
			double value8 = agent.learningWorkspaceTemp
					.get(i).policy_value;
			double value9 = agent.learningWorkspaceTemp
				.get(i).previous_policy_value;		
			double value10 = agent.learningWorkspaceTemp
					.get(i).policy_score;
			double value11 = agent.learningWorkspaceTemp
					.get(i).expected_result;
			String value12 = agent.learningWorkspaceTemp
					.get(i).optimization_indicator;
			String value13 = agent.learningWorkspaceTemp
					.get(i).source;
			Integer value14 = agent.learningWorkspaceTemp
					.get(i).higher_level_policy_id;
			String value15 = "New";// set moved policy to new. After validation this is set to active

			int value16 = agent.learningWorkspaceTemp
					.get(i).version;
			int value17 = agent.learningWorkspaceTemp
					.get(i).change_pointer;
			double value18 = 0;
			double value19 = 0;
			String value20 = "None";

			try {
				if (agent.learningWorkspaceTemp
						.get(i) != null 
						&& agent.learningWorkspaceTemp.get(i).previous_policy_value !=
						 agent.learningWorkspaceTemp.get(i).policy_value) { //(5) &&
											// agent.learningWorkspaceTemp.get(i).policy_id
											// != null) {
				insertInto(policy).columns(
						policy.policy_id,//1
						policy.policy_name,//2 
						policy.agent_id,//3
						policy.policy_type_id,//4
						policy.script, //5
						policy.object_type,//6
						policy.attribute,//7
						policy.policy_value,//8
						policy.previous_policy_value,//9 
						policy.score,//10
						policy.expected_result,//11
						policy.optimization_indicator,//12
						policy.source,//13
						policy.higher_level_policy_id,//14
						policy.status, //15
						policy.version,//16
						policy.change_pointer,//17
						policy.actual_result,//18
						policy.simulated_result,//19
						policy.learning_method)//20
							.values(value1, value2, value3,
									value4, value5, value6,
									value7, value8, value9,
									value10, value11,
									value12, value13,
									value14, value15,
									value16, value17,
									value18, value19, value20)
							.execute();
//add selected and hold policy to log

// Create a new SelectedPolicy object with the desired values
SelectedPolicy newPolicy = new SelectedPolicy(
    0,
    value1,
    "",
    "New"
);

// Add the object to the ArrayList
agent.cUpdatedPolicies.add(newPolicy);	

// Add changes to change log
			UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
          		changelog.old_value,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.learningWorkspaceTemp.get(i).policy_id,
          		date(),
          		agent.learningWorkspaceTemp.get(i).previous_policy_value,
          		agent.learningWorkspaceTemp.get(i).policy_value,
          		"-",
          		"New",
          		0,
          		0,
         		"Guido Willemsen")
          		.execute();


				}/*(5)*/ else {//(6)
					traceln("Null value encountered at index "
							+ tvi);
				}//(6)
			} catch (Exception e) {//(7)
				traceln("Error inserting data at index " + i
						+ " with policy_id "
						+ (agent.learningWorkspaceTemp.get(i) != null ? agent.learningWorkspaceTemp.get(i).policy_id: "null")
						+ ": " + e.getMessage());
			}//(7)
		// define the highest value in the symptom_policy
		// table
		// ############################################
		int max_ps = 0;

		List<Tuple> sp_rows = selectFrom(symptom_policy)
				.list();



		for (Tuple sp_row : sp_rows) {//(8)
			traceln(sp_row.get(
					symptom_policy.symptom_policy_id) + "\t"
					+ sp_row.get(symptom_policy.symptom_id)
					+ "\t"
					+ sp_row.get(symptom_policy.policy_id));
			if (sp_row.get(
					symptom_policy.symptom_policy_id) > max_ps)
				max_ps = sp_row.get(symptom_policy.symptom_policy_id);
			//check if the policy already exists
			
/*			if (sp_row.get(
//					(symptom_policy.policy_id).eq(max_p + 1))) {
  			  // Retrieve the policy_id
  			  Integer policyId = sp_row.get(symptom_policy.policy_id);

  			  // Check if policyId is null to avoid NullPointerException
  			  if (policyId == null) {
  			      traceln("policy_id is null for this tuple.");
  			      continue; // Skip to the next tuple if policy_id is null
  			  }

 			   // Compare policy_id with max_p + 1
   			 if (policyId.equals(max_p + 1)) {
     			   traceln("policy_id is equal to max_p + 1 for this tuple.");
      			  // Additional logic can be added here
   			 }

   			 // Log the values
    			traceln(sp_row.get(symptom_policy.symptom_policy_id) + "\t"
     			       + sp_row.get(symptom_policy.symptom_id) + "\t"
      			      + policyId);

   			 // Update max_ps if the current symptom_policy_id is greater
   			 Integer symptomPolicyId = sp_row.get(symptom_policy.symptom_policy_id);
   			 if (symptomPolicyId != null && symptomPolicyId > max_ps) {
     			   max_ps = symptomPolicyId;
    			}*/					
			}//(8)		
				//for this policy retrieve the symptom and add this to the table)
			traceln("Maximum policy symptom id: "+max_ps);		
	
				// write the new symptom to the policy_symptom table
		traceln("Old policy id: "+old_policy_id);		
	try {
	if (agent.learningWorkspaceTemp.get(i).policy_type_id == 0){
    int add_symptom = selectFirstValue(
        "SELECT symptom_id FROM symptom_policy WHERE policy_id = ?",
//        agent.learningWorkspaceTemp.get(i).policy_id
		old_policy_id
    );
    insertInto(symptom_policy)
        .columns(symptom_policy.agent_id,
        		symptom_policy.symptom_policy_id,
                symptom_policy.symptom_id,
                symptom_policy.policy_id,
                symptom_policy.status)
        .values(agent.id, max_ps + 1, add_symptom, max_p + 1, "New")
        .execute();
      }
} catch (Exception e) {
    // Handle other types of exceptions
    System.err.println("An error occurred: " + e.getMessage() + old_policy_id);
    e.printStackTrace();
}

				
					//Change the new policy in the learningWorkspaceTemp table
					agent.learningWorkspaceTemp.get(i).policy_id = max_p + 1;

	
	agent.learningWorkspaceTemp.get(i).status = "Processed";
	
// Add changes to change log
			UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
          		changelog.old_value,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Symptom_Policy",
         		agent.id,
         		agent.learningWorkspaceTemp.get(i).policy_id,
          		date(),
          		0,
          		max_ps + 1,
          		"-",
          		"New",
          		0,
          		0,
         		"Guido Willemsen")
          		.execute();

		}/*(4)*/ else {
		
		traceln("No new policy to be processed");
		
		}
		
		
		
//	}//(2)
//	if (agent.learningWorkspaceTemp
//			.get(i).status.equals("Exploited")) {//(9)
		
	
// Activate policy
//		update(policy)
//				.where(policy.policy_id
//						.eq(agent.learningWorkspaceTemp
//								.get(i).policy_id))
//				.set(policy.status, "Active").execute();
	
//	}//(9)

  } //(1)

// set Learning completed when all the records in the learning workspace has been processed
//if (vi+1 > agent.learningWorkspace.size()) {
//	pLearningCompleted = true;
//}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737491975767</Id>
					<Name><![CDATA[fExploitSolutions]]></Name>
					<X>260</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[if (agent.vi < agent.learningWorkspace.size()) {

pProcessChange = false;
double actual_result = 0.0;
double expected_result = 0.0;
double previous_result = 0.0;
double minValue = 0.0;
double maxValue = 0.0;
//int i = agent.vi;
int RC = 0;

agent.vResult_Tolerance = selectUniqueValue(
					"SELECT dblearningtechnique.result_tolerance FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
					agent.id);
List <Object> list_policy_values = new ArrayList<>();

//define list of existing policy values
//for (int i = 0; i < agent.learningWorkspace.size();i++) {//(10)
 	Object selected_policy_values = selectFrom (policy).
 	where(policy.policy_type_id.eq(agent.learningWorkspace.get(agent.vi).policy_type_id)).
 	list(policy.policy_value);
 	
 	list_policy_values.add(selected_policy_values);
//}//(10)

for (int i = 0; i < agent.learningWorkspace.size();i++) {//1
//	if (i == vi) { //(5) select the instance from the learning workspace collection that is subject to analyze
	for (int j = 0; j < agent.actualOutcome.size(); j++){
///		if (agent.actualOutcome.get(j).policy_id == agent.learningWorkspace.get(i).higher_level_policy_id){
		if (agent.actualOutcome.get(j).policy_id == agent.learningWorkspace.get(i).policy_id){ 		 
 	actual_result = agent.actualOutcome.get(j).actual_result;
 	
 	expected_result = agent.actualOutcome.get(j).expected_result;
 	
 	previous_result = agent.actualOutcome.get(j).previous_result;
 	 } 
 	}
 	
 minValue = selectUniqueValue(
					"SELECT policy_value_range.min_value FROM policy_value_range WHERE policy_value_range.policy_type_id = ? AND policy_value_range.object_type = ? AND policy_value_range.attribute = ?",
					agent.learningWorkspace.get(i).policy_type_id, agent.learningWorkspace.get(i).object_type, agent.learningWorkspace.get(i).attribute);
 maxValue = selectUniqueValue(
					"SELECT policy_value_range.max_value FROM policy_value_range WHERE policy_value_range.policy_type_id = ? AND policy_value_range.object_type = ? AND policy_value_range.attribute = ?",
					agent.learningWorkspace.get(i).policy_type_id, agent.learningWorkspace.get(i).object_type, agent.learningWorkspace.get(i).attribute);				


 
 	
 if (expected_result > 0.0){	//only for relation with the higher level process	
 	if (agent.learningWorkspace.get(i).optimization_indicator.equals("MAX")){//4
 	
 		if (actual_result > previous_result) {//(11)when maximizing the new result should be higher than the previous result -> stimulate this behavior
 			if (agent.learningWorkspace.get(i).previous_policy_value < agent.learningWorkspace.get(i).policy_value){ //(12) if the positive outcome resulted from an increase in the policy value -> stimulate
 				agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
 				
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value + 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value + 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}
				 				

 			}/*(12)*/ else { //(13) otherwise dampen
 				agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
				
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value - 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value - 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}
 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				}
 			} //(13)
 		}/*(11)*/ else { //(14) in this case  the result is equal or lower)
 				if (actual_result < previous_result) { //(15) result is lower
 		 			if (agent.learningWorkspace.get(i).previous_policy_value < agent.learningWorkspace.get(i).policy_value){//(16) when the previous value was lower and te result is negative then lower the policy
 						agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
						Object value = agent.learningWorkspace.get(i).policy_value;
						if (value instanceof Integer) {
						    int newValue = (Integer) value - 1;
						    agent.learningWorkspace.get(i).policy_value = newValue;
						} else if (value instanceof Double) {
						    double newValue = (Double) value - 0.1;
						    agent.learningWorkspace.get(i).policy_value = newValue;
						} else {
						    // Handle unexpected types (e.g., String, boolean, etc.)
						    System.err.println("policy_value is not a number: " + value);
						}

 					}/*(16)*/ else { // (17)or otherwise stimulate the policy
 						agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value + 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value + 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}
 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				}	 
 					}//(17) 
 				}/*(15*/ else {//(19)
 				traceln("no policy change needed for policy "+agent.learningWorkspace.get(i).policy_id);
			}//19)
 		}//(14)
 		// add to the learningWorkspace Temp
 		agent.learningWorkspace.get(i).status = "Exploited";
 		agent.learningWorkspaceTemp.add(agent.learningWorkspace.get(i));
// 		tvi++;
 		
 	}/*4*/ else {//3
 	 	if (agent.learningWorkspace.get(i).optimization_indicator.equals("MIN")){
 	
 		if (actual_result < previous_result) {//when minimizing the new result should be lower than the previous result -> stimulate this behavior
 			if (agent.learningWorkspace.get(i).previous_policy_value < agent.learningWorkspace.get(i).policy_value){ // if the positive outcome resulted from an increase in the policy value -> stimulate
 				agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value + 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value + 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}

 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				} 			 
 			} else { // otherwise dampen
 				agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value - 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value - 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}
 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				}
 			} 
 		} else { // in this case  the result is equal or lower)
 				if (actual_result > previous_result) { // result is higher
 		 			if (agent.learningWorkspace.get(i).previous_policy_value < agent.learningWorkspace.get(i).policy_value){// when the previous value was higher and te result is negative then lower the policy
 						agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
						Object value = agent.learningWorkspace.get(i).policy_value;
						if (value instanceof Integer) {
						    int newValue = (Integer) value - 1;
						    agent.learningWorkspace.get(i).policy_value = newValue;
						} else if (value instanceof Double) {
						    double newValue = (Double) value - 0.1;
						    agent.learningWorkspace.get(i).policy_value = newValue;
						} else {
						    // Handle unexpected types (e.g., String, boolean, etc.)
						    System.err.println("policy_value is not a number: " + value);
						}
 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				}
 					} else { // or otherwise stimulate the policy
 						agent.learningWorkspace.get(i).previous_policy_value = agent.learningWorkspace.get(i).policy_value;
				Object value = agent.learningWorkspace.get(i).policy_value;
				if (value instanceof Integer) {
				    int newValue = (Integer) value + 1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else if (value instanceof Double) {
				    double newValue = (Double) value + 0.1;
				    agent.learningWorkspace.get(i).policy_value = newValue;
				} else {
				    // Handle unexpected types (e.g., String, boolean, etc.)
				    System.err.println("policy_value is not a number: " + value);
				}

 				if (agent.learningWorkspace.get(i).policy_value < minValue){
 					agent.learningWorkspace.get(i).policy_value = minValue;
 				} else if (agent.learningWorkspace.get(i).policy_value > maxValue){
 					agent.learningWorkspace.get(i).policy_value = maxValue; 
 				}
 				}
 		// do nothing an change status
     }//2
    }
   }  else {
 	traceln("no policy change needed for policy "+agent.learningWorkspace.get(i).policy_id);
   } 
    // add to the learningWorkspace Temp
 		agent.learningWorkspace.get(i).status = "Exploited";    
 		agent.learningWorkspaceTemp.add(agent.learningWorkspace.get(i));
// 		tvi++;
  }//3
    agent.learningWorkspace.get(i).status = "Exploited";
//}//5

	
  if (agent.learningWorkspace.get(i).policy_type_id == 0) { // only when the policy was a process, the process configuration has been changed.
		pProcessChange = true;
	}
 }//end of if statement
}//1
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1739020783442</Id>
					<Name><![CDATA[fRetrieveLearningReq]]></Name>
					<X>260</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//initialize the VI index to manage the learning workspace loop
agent.vi = -1;
//tvi = -1;
agent.learningWorkspaceTemp.clear();
// Sort by 'Policy Type Id'. 0 = Process and 1 = Decision. First the processes are used to fill the learningWorkspace

List<Learning> sortedByPolicyType = agent.learningWorkspace.stream()
    .sorted(Comparator.comparing(Learning::getPolicyTypeId)) 
    .collect(Collectors.toList());

agent.learningWorkspace.clear();

for (int i = 0; i < sortedByPolicyType.size(); i++) {

	agent.learningWorkspace.add(sortedByPolicyType.get(i));	
}]]></Body>
				</Function>
