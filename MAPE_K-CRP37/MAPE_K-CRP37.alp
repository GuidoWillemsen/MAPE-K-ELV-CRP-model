//		agent.SLA = (int)Math.ceil(agent.vwsl * ((agent.SL_des - agent.SL)/agent.vsat));//[63]
		agent.SLA = agent.vwsl * ((agent.SL_des - agent.SL)/agent.vsat);//[63]
//		agent.IA = Math.max((int)Math.ceil((agent.I_des - agent.EI)/agent.vsat), 0);//[64]//CHECK - it seems that this formula is wrong as it results in negative stock.
		//this will bring the supply chain to a stand still -> corrected that when negative it will be rounded to 0
//		agent.IA = (int)Math.ceil((agent.I_des - agent.EI)/agent.vsat);	
		agent.IA = (agent.I_des - agent.EI)/agent.vsat;	
		status = "MRP Completed";

		
 		if (agent.type.equals("AT2")){//for the retailer
			
//			agent.SL = agent.IO + agent.B + agent.ITI1+ agent.ITI2;
			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vCycle_id ) < 5){//plain orders for first cycles -> recovered to =< 5  - was cycle id +1
				agent.O = 4;//[65]
			} else {
//			agent.O = Math.max((int)Math.ceil(agent.EECD + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0	
			agent.O = Math.max((int)Math.round(agent.EECD + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0
			}
			status = "MRP Completed";

				
		} else if (agent.type.equals("AT3")){//for the wholesaler
			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vCycle_id )< 5){//plain orders for first cycles -> recovered to =< 5  - was cycle id +1
				agent.O = 4;//[66]
			} else {
//					agent.O = Math.max((int)Math.ceil(agent.EO + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0	
					agent.O = Math.max((int)Math.round(agent.EO + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0		
			}	
			status = "MRP Completed";

			
		} else if (agent.type.equals("AT4")){//for the distributor
			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vCycle_id) < 5){//plain orders for first cycles -> recovered to =< 5 - was cycle id +1
				agent.O = 4;//[67]
			} else {
//					agent.O = Math.max((int)Math.ceil(agent.EO + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0	
					agent.O = Math.max((int)Math.round(agent.EO + agent.IA + agent.SLA), 0);//[65]correction on paper -> not an absolute value but negative values become 0
			}	
			status = "MRP Completed";

				
		} else if (agent.type.equals("AT5")){//for the producer
			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the production order
			if ((agent.vCycle_id )< 5){//plain orders for first cycles -> recovered to=< 5  - was cycle id +1
				agent.PSR = 4;//[68]
			} else {
//					agent.PSR = Math.max((int)Math.ceil(agent.EO + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0	
					agent.PSR = Math.max((int)Math.round(agent.EO + agent.IA + agent.SLA), 0);//[65]/correction on paper -> not an absolute value but negative values become 0				
				  }				
			//moved from Produce Goods -> as the factory does not receive, the PSR is used in the MRP as receipt
//			agent.I = agent.I + agent.WIPI2;//[28]
//			agent.WIPI2 = agent.WIPI1;//[30]
	 		agent.WIPI1 = agent.PSR;// [38]
//	 		agent.SL_des = (int)Math.ceil(agent.EO * agent.plt);//[57] CHECK IF THIS IS CORRECTLY DEACTIVATED
//		    agent.SL = agent.WIPI1 + agent.WIPI2;//[62]
	 		
			status = "Produced";

		} else {
		traceln("No agents to be processed");
		}	
   }
//}
}
//add the parameters to the results table
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
	

//add results to a new BeerGame record for this cycle

		this.main.cBeerGameResults.get(k).sat = agent.vsat;//sat
		this.main.cBeerGameResults.get(k).mdt = agent.vmdt;//mdt
		this.main.cBeerGameResults.get(k).st = agent.vst;//st
		this.main.cBeerGameResults.get(k).plt = agent.vplt;//plt
		this.main.cBeerGameResults.get(k).wsl = agent.vwsl;//wsl
		this.main.cBeerGameResults.get(k).θ = agent.vtheta;//θ
//		this.main.cBeerGameResults.get(k).ENDCD = agent.ENDCD;//ENDCD
		this.main.cBeerGameResults.get(k).EECD = agent.EECD;//EECD
		this.main.cBeerGameResults.get(k).EO = agent.EO;//EO
//		this.main.cBeerGameResults.get(k).O = agent.O;//O  ->? DeActivated again
//		this.main.cBeerGameResults.get(k).PSR = agent.PSR;//PSR deactivated, see below
//		this.main.cBeerGameResults.get(k).IO = agent.IO;//IO
//		this.main.cBeerGameResults.get(k).TC = agent.TC;//TC
		this.main.cBeerGameResults.get(k).SL = agent.SL;//SL
		this.main.cBeerGameResults.get(k).SLA = agent.SLA;//SLA
		this.main.cBeerGameResults.get(k).EI = agent.EI;//EI
		this.main.cBeerGameResults.get(k).IA = agent.IA;//IA
		this.main.cBeerGameResults.get(k).Status = status;//
		this.main.cBeerGameResults.get(k).order_id = agent.order_id;
		this.main.cBeerGameResults.get(k).I_des = agent.I_des;//I_des [10]
		this.main.cBeerGameResults.get(k).SL_des = agent.SL_des;//SL_des			
		this.main.cBeerGameResults.get(k).B = agent.B;//B
		this.main.cBeerGameResults.get(k).I = agent.I;//I
		this.main.cBeerGameResults.get(k).uihc = agent.I * agent.uihc_i;// calculate Inventory Holding cost for this cycle
		this.main.cBeerGameResults.get(k).ubc = agent.B * agent.ubc_i;// calculate Backlog olding cost for this cycle
		this.main.cBeerGameResults.get(k).WIPI2 = agent.WIPI2;//WIPI2
//		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;//WIPI1
		this.main.cBeerGameResults.get(k).TI = agent.TI;
	if (agent.vCycle_id <= 1){
		this.main.cBeerGameResults.get(k).ITI1 = agent.ITI1;//ITI1 - activated
		this.main.cBeerGameResults.get(k).ITI2 = agent.ITI2;//ITI2 - activated
	}
//	}
  }
 } 		
boolean addRecord = true;
if (agent.vCycle_id == 0){//initialize for the first cycle

//for initialization
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){  
		if (agent.type.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameResults.get(k).O = agent.O;
		}
		this.main.cBeerGameResults.get(k).PSR = agent.PSR;
		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
// 		addRecord = false;
  	}
  }
//for the first cycle
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1){  
		if (agent.type.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameResults.get(k).O = agent.O;
		}
		this.main.cBeerGameResults.get(k).PSR = agent.PSR;
		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
		this.main.cBeerGameResults.get(k).EO = agent.EO;
  		addRecord = false;
  	}
  }
}
//cycle > 0

for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){ //CHANGE was +1 
		if (agent.type.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameResults.get(k).O = agent.O;
		}
//		this.main.cBeerGameResults.get(k).PSR = agent.PSR;
//		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
  		addRecord = false;
  	}
  }
  	
if (addRecord == true){		
		BeerGame_Results orderNextCycle = new BeerGame_Results();
   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		orderNextCycle.agent_id = agent.id;
 		orderNextCycle.agent_type = agent.type;
 		orderNextCycle.i = agent.id;
		orderNextCycle.t = (agent.vCycle_id);//CHANGE was +1 
		orderNextCycle.order_id = agent.order_id;
		if (agent.type.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			orderNextCycle.O = agent.O;
		}
// 		orderNextCycle.PSR = agent.PSR;
// 		orderNextCycle.PSR = agent.WIPI1;
// 		orderNextCycle.WIPI1 = agent.WIPI1;
  		orderNextCycle.EO = agent.EO;		
		orderNextCycle.Status = "SO Created";
//		if (vSim_id != null) {
//			orderNextCycle.Sim_id = vSim_id.toString();
//		}
		this.main.cBeerGameResults.add(orderNextCycle);
	}	

addRecord = true;

for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1
 	&& agent.type.equals("AT5")){
		this.main.cBeerGameResults.get(k).PSR = agent.PSR;
		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
		this.main.cBeerGameResults.get(k).EO = agent.EO;
  		addRecord = false;
  	}
  }
if (addRecord == true
	&& agent.type.equals("AT5")){		
		BeerGame_Results orderNextCycle = new BeerGame_Results();
   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		orderNextCycle.agent_id = agent.id;
 		orderNextCycle.agent_type = agent.type;
 		orderNextCycle.i = agent.id;
		orderNextCycle.t = (agent.vCycle_id+1);
		orderNextCycle.order_id = agent.order_id;
		orderNextCycle.PSR = agent.PSR;
 		orderNextCycle.WIPI1 = agent.WIPI1;
 		orderNextCycle.EO = agent.EO;
//		if (vSim_id != null) {
//		orderNextCycle.Sim_id = vSim_id.toString();
//		}
		this.main.cBeerGameResults.add(orderNextCycle);
	}

	if (vSim_id == null){
				agent.executionWorkspace.get(agent.ei).status = "Processed";
	}
		]]></Body>
