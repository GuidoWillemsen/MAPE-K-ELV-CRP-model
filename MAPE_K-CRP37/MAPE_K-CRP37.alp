				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1747581486147</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[boolean newResult = false;
boolean existingResult = false;
boolean addResult = false;
int WIPI2 = 0;

//start execution space

//			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase

agent.ENDCD = 0;//initialize the ENDCD value for this new cycle
//retrieve current order book
if (vSim_id == null){
	agent.executionWorkspace.get(ei).status = "Processed";	
}
	agent.IO = 0;//reset IO
	agent.ENDCD = 0;//reset ENDCD
//for first cycle
if (agent.vCycle_id == 0){
	traceln("Initialization");
	
	agent.IO = main.pStartOrderQty;//4;	
	
for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 

 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id
 	||this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1)){
	
	this.main.cBeerGameResults.get(k).agent_id = agent.id;
	this.main.cBeerGameResults.get(k).agent_type = agent.type;
	this.main.cBeerGameResults.get(k).i = agent.id;
	this.main.cBeerGameResults.get(k).t = agent.vCycle_id;
	this.main.cBeerGameResults.get(k).IO = agent.IO;	//CORRECTED
	this.main.cBeerGameResults.get(k).Status = "Processed";
	existingResult = true;
 }
}	

if (!existingResult == true){
	 BeerGame_Results new_result = new BeerGame_Results();
	 new_result.agent_id = agent.id;
	 new_result.agent_type = agent.type;
	 new_result.i = agent.id; //changed from agent type
	 new_result.t = agent.vCycle_id;
//	 new_result.order_id = this.main.Orders.get(j).Order_id;
	 new_result.IO = agent.IO;
	 new_result.Status = "Processed";//To be processed
	 if (vSim_id != null) {
		new_result.Sim_id = vSim_id.toString();
		}	
	this.main.cBeerGameResults.add(new_result);
	}
  		
	} else if (agent.vCycle_id == 1) {	
	//calculate ti value
if (agent.type.equals("AT5")){//for factory
	agent.TI = agent.I + agent.WIPI2;//I and ITI2 are the values of the previous cycle	
} else {	
	agent.TI = agent.I + agent.ITI2;//I and ITI2 are the values of the previous cycle
}
	  agent.IO = main.pStartOrderQty;
	  agent.ENDCD = agent.IO;
	  newResult = true;		
	} else {// cycle > 1

//calculate ti value
if (agent.type.equals("AT5")){//for factory
	agent.TI = agent.I + agent.WIPI2;//I and ITI2 are the values of the previous cycle	
} else {
	agent.TI = agent.I + agent.ITI2;//I and ITI2 are the values of the previous cycle
}	

//sort the this.main.Orders collection   
this.main.Orders.sort(new Comparator<Order>() {
    @Override
    public int compare(Order o1, Order o2) {
        // First compare by Cycle_id
        int cycleCompare = Integer.compare(o1.Cycle_id, o2.Cycle_id);
        if (cycleCompare != 0) {
            return cycleCompare;
        }   
        // If Cycle_id is the same, compare by Agent_type
        return o1.Agent_type.compareTo(o2.Agent_type);
    }
});   

for (int j = 0; j < this.main.Orders.size();j++){// only for the retailer ENDCD

	if (this.main.Orders.get(j).Partner == null
		&& this.main.Orders.get(j).Cycle_id == (agent.vCycle_id)//CHANGE to 0 retrieve the order from the previous cycle
		&& agent.vCycle_id > 1){
		
		//assign the order to te active agent
		if (this.main.Orders.get(j).Agent_type.equals("AT1")
			&&agent.type.equals("AT2")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//customer orders for retailer 
			this.main.Orders.get(j).Partner = agent.id;
			agent.ENDCD = (int) Math.ceil(agent.ENDCD + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			this.main.Orders.get(j).Status = "Assigned";
			newResult = true;
		}
	}
}

   	
for (int j = 0; j < this.main.Orders.size();j++){

	if (this.main.Orders.get(j).Partner == null
		&& this.main.Orders.get(j).Cycle_id == (agent.vCycle_id)-1//CHANGE to -1 retrieve the order from the previous cycle
		&& agent.vCycle_id > 1){
		
		//assign the order to te active agent
		if (this.main.Orders.get(j).Agent_type.equals("AT1")
			&&agent.type.equals("AT2")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//customer orders for retailer 
			this.main.Orders.get(j).Partner = agent.id;
//			agent.ENDCD = (int) Math.ceil(agent.ENDCD + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			this.main.Orders.get(j).Status = "Assigned";
			newResult = true;
		} else if (this.main.Orders.get(j).Agent_type.equals("AT2")
			&&agent.type.equals("AT3")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//retailer orders for wholesaler	
			this.main.Orders.get(j).Partner = agent.id;
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);
			this.main.Orders.get(j).Status = "Assigned";
			newResult = true;							
		} else if (this.main.Orders.get(j).Agent_type.equals("AT3")
			&&agent.type.equals("AT4")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//wholesaler orders for distributor	
			this.main.Orders.get(j).Partner = agent.id;
			agent.IO = (int) Math.ceil (agent.IO + this.main.Orders.get(j).Quantity);//[51]add order to Incoming Orders 
			this.main.Orders.get(j).Status = "Assigned";
			newResult = true;				
		} else if (this.main.Orders.get(j).Agent_type.equals("AT4")
			&&agent.type.equals("AT5")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//distributor orders for manufacturer	
			this.main.Orders.get(j).Partner = agent.id;
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);//[52]add order to Incoming Orders 
			this.main.Orders.get(j).Status = "Assigned";
			newResult = true;
		}		
	} else if (this.main.Orders.get(j).Partner != null
		&& this.main.Orders.get(j).Cycle_id == (agent.vCycle_id)//retrieve the order from the previous cycle
		&& agent.vCycle_id > 1){
		
		//assign the order to te active agent
		if (this.main.Orders.get(j).Agent_type.equals("AT1")
			&&agent.type.equals("AT2")){
//			agent.ENDCD = (int) Math.ceil(agent.ENDCD + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
		} else if (this.main.Orders.get(j).Agent_type.equals("AT2")
			&&agent.type.equals("AT3")){
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);
		} else if (this.main.Orders.get(j).Agent_type.equals("AT3")
			&&agent.type.equals("AT4")){
			agent.IO = (int) Math.ceil (agent.IO + this.main.Orders.get(j).Quantity);//[51]add order to Incoming Orders 
		} else if (this.main.Orders.get(j).Agent_type.equals("AT4")
			&&agent.type.equals("AT5")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//distributor orders for manufacturer	
			agent.IO = (int) Math.ceil(agent.IO + this.main.Orders.get(j).Quantity);//[52]add order to Incoming Orders 
	 	}
	  } else {
	traceln("No orders in the supply chain");
		 }
   		}
 }

//}

 //for the factory only as they don't receive goods in the regular process
		if (agent.type.equals("AT5")){
			
 			for (int m = 0 ; m < this.main.cBeerGameResults.size();m++){
 				if ( this.main.cBeerGameResults.get(m).agent_id == agent.id
 					&& this.main.cBeerGameResults.get(m).t == (agent.vCycle_id-1)){
// 					agent.WIPI2 = this.main.cBeerGameResults.get(m).WIPI1;//[30]
 					agent.WIPI2 = this.main.cBeerGameResults.get(m).WIPI1;//[30]
 					WIPI2 = this.main.cBeerGameResults.get(m).WIPI2;
 					}			
				}	
				agent.I = agent.I + WIPI2;//[28]
				agent.WIPI1 = 0;//[32] after delivery WIPI becomes empty-> Consider to this after delivery
				newResult = true;
	}
// add record to Beer Game results 	

//if (newResult == true
//	&& !agent.type.equals("AT1")
//	&& agent.vCycle_id > 0){//create record for this agent in this cycle ->removed as it always should create a record expect for the first cycle

	//add the shipment to the results table of the current cycle
if (newResult == true){
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 

 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id)){
 	this.main.cBeerGameResults.get(k).S = agent.S;
 	this.main.cBeerGameResults.get(k).WIPI2 = agent.WIPI2;
 	this.main.cBeerGameResults.get(k).ENDCD = agent.ENDCD;//Corrected on 20-11
 	this.main.cBeerGameResults.get(k).Status = "Processed";
 	existingResult = true;
	}
}
}

if (newResult == true
	&& !existingResult == true){
	 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){	
	
 	if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&& !existingResult == true){
 	 			if (this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
 	
				traceln("No action required");
				} else {
				addResult = true;	

    	 }	
		}
 	 }

if (addResult == true){  
  	BeerGame_Results new_result = new BeerGame_Results();
	 new_result.agent_id = agent.id;
	 new_result.agent_type = agent.type;
	 new_result.i = agent.id;//CHANGED from agent.type to agent.id
	 new_result.t = agent.vCycle_id;
//	 new_result.order_id = this.main.Orders.get(j).Order_id;
//	 new_result.order_id = agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase
//	 new_result.IO = agent.IO;
	 new_result.S = agent.S;
	 new_result.WIPI2 = agent.WIPI2;
	 new_result.ENDCD = agent.ENDCD;
	if (vSim_id != null) {
		new_result.Sim_id = vSim_id.toString();
		}	
	 new_result.Status = "Processed";//To be processed
		
	this.main.cBeerGameResults.add(new_result);
//	newResult = false;//reset newResult
  }	  
 traceln("New record added to cBeerGameResults"); 
//}
}

//reset
existingResult = false;
addResult = false;

//for the first cycle the data should be added to cycle 0
if (agent.vCycle_id == 0){
	if (newResult = true){
	
//for the initial cycle	
		 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 

 		if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id)){
 			this.main.cBeerGameResults.get(k).order_id = agent.order_id;
			this.main.cBeerGameResults.get(k).IO = 0;//only for the initiation
			this.main.cBeerGameResults.get(k).ENDCD = 0;//only for the initiation
 			this.main.cBeerGameResults.get(k).Status = "Processed";
		}
		}
// for the first cycle
		 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 

 		if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1)){//CHANGE was 0
 			this.main.cBeerGameResults.get(k).order_id = agent.order_id;
			this.main.cBeerGameResults.get(k).IO = main.pStartOrderQty;//4;//only for the first cycle
			this.main.cBeerGameResults.get(k).ENDCD = main.pStartOrderQty;//4;//only for the first cycle
 			this.main.cBeerGameResults.get(k).Status = "Processed";
 			existingResult = true;
		}
		}		
		
		}

	if (newResult == true
		&& !existingResult == true){
		 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){	
	
 		if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&& !existingResult == true){
 	 			if (this.main.cBeerGameResults.get(k).t == agent.vCycle_id){//CHANGE was +1
 	
				traceln("No action required");
				} else {
				addResult = true;	

    	 }	
		}
 	 }

	if (addResult == true){ 
/*// for cycle 0;	
	 
  		BeerGame_Results new_result0 = new BeerGame_Results();
		 new_result0.agent_id = agent.id;
	 	new_result0.agent_type = agent.type;
	 	new_result0.i = agent.id;//CHANGED from agent.type to agent.id
	 	new_result0.t = agent.vCycle_id;
//	 	new_result0.order_id = this.main.Orders.get(j).Order_id;
		 new_result0.order_id = agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase
	 	new_result0.IO = 0;//only for the iniyial cycle
	 	new_result0.Status = "Processed";//To be processed
		
		this.main.cBeerGameResults.add(new_result0);
*/
// for cycle 1
  		BeerGame_Results new_result = new BeerGame_Results();
		 new_result.agent_id = agent.id;
	 	new_result.agent_type = agent.type;
	 	new_result.i = agent.id;//CHANGED from agent.type to agent.id
	 	new_result.t = agent.vCycle_id;//CHANGE was +1
//	 	new_result.order_id = this.main.Orders.get(j).Order_id;
		 new_result.order_id = agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase
	 	new_result.IO = main.pStartOrderQty;//4;//only for the first cycle
	 	new_result.ENDCD = main.pStartOrderQty;//4;//only for the first cycle
	 	new_result.Status = "Processed";//To be processed
//		if (vSim_id != null) {
//			new_result.Sim_id = vSim_id.toString();
//		}
		this.main.cBeerGameResults.add(new_result);
		newResult = false;//reset newResult		
		
  	}	  
 	traceln("New record added to cBeerGameResults"); 
//}
}
//add the incoming order for the next cycle
} else {
if (newResult == true){
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 

 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id)){//CHANGE was +1 CHECK NEXT TIME
 	this.main.cBeerGameResults.get(k).order_id = agent.order_id;
	this.main.cBeerGameResults.get(k).IO = agent.IO;
	this.main.cBeerGameResults.get(k).ENDCD = agent.ENDCD;
 	this.main.cBeerGameResults.get(k).Status = "Processed";
 	existingResult = true;
	}
}
}

if (newResult == true
	&& !existingResult == true){
	 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){	
	
 	if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&& !existingResult == true){
 	 			if (this.main.cBeerGameResults.get(k).t == agent.vCycle_id){//CHANGE was +1
 	
				traceln("No action required");
				} else {
				addResult = true;	

    	 }	
		}
 	 }

if (addResult == true){  
  	BeerGame_Results new_result = new BeerGame_Results();
	 new_result.agent_id = agent.id;
	 new_result.agent_type = agent.type;
	 new_result.i = agent.id;//CHANGED from agent.type to agent.id
	 new_result.t = agent.vCycle_id+1;//CHANGE was0
//	 new_result.order_id = this.main.Orders.get(j).Order_id;
	 new_result.order_id = agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase
	 new_result.IO = agent.IO;
	 new_result.IO = agent.ENDCD;
	 new_result.ENDCD = agent.ENDCD;//CORRECTED on 20-11
	 new_result.Status = "Processed";//To be processed
//	if (vSim_id != null) {
//		new_result.Sim_id = vSim_id.toString();
//		}
	this.main.cBeerGameResults.add(new_result);
	newResult = false;//reset newResult
  }	  
 traceln("New record added to cBeerGameResults"); 
//}
}
}


