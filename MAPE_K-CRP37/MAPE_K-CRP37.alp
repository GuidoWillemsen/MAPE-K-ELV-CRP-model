		<JavaClass>
			<Id>1745259559170</Id>
			<Name><![CDATA[Gesture]]></Name>
			<Text><![CDATA[/**
 * Gesture
 */	
public class Gesture implements Serializable {

	public String message_id = "";
	
	public String requestor = "";

	public int policy_id = 0;
	
	public String policy_name = "";

	public String object_type = "";

	public String attribute = "";

	public Double value = 0.0;

	public Double score = 0.0;
	
	public Double expected_result = 0.0;

	public String source = "";
	
	public String status = "New";

    /**
     * Default constructor
     */
    public Gesture() {
    }

    /**
     * Constructor initializing the fields
     */
    public Gesture(String message_id, String requestor, int policy_id, String policy_name, String object_type, String attribute, Double value, Double score, Double expected_result, String source, String status) {
		this.message_id = message_id;
		this.requestor = requestor;
		this.policy_id = policy_id;
		this.policy_name = policy_name;
		this.object_type = object_type;
		this.attribute = attribute;
		this.value = value;
		this.score = score;
		this.expected_result = expected_result;
		this.source = source;
		this.status = status;
    }

	@Override
	public String toString() {
		return  
			"message_id = " + message_id +" " +
			"requestor = " + requestor + " " +
			"policy_id = " + policy_id +" " +
			"policy_name = " + policy_name + " " +
			"object_type = " + object_type +" " +
			"attribute = " + attribute +" " +
			"value = " + value +" " +
			"score = " + score +" " +
			"expected_result = " + expected_result + " " +
			"source = " + source +" "+
			"status = " + status +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
