				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737223691557</Id>
					<Name><![CDATA[fOrchestrateValidation]]></Name>
					<X>160</X><Y>760</Y>
					<Label><X>10</X><Y>-5</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Process orchestrater at Validation");
//main.fromSimulation.take(agent);//start MAPE again REPLACED by main.p_out.take(agent); on 22-11
//clean policy table for temporary status

for (int i = 0; i < agent.cUpdatedPolicies.size(); i++){
try {
 String selected_policy_status = selectUniqueValue(
			"SELECT status FROM policy WHERE policy.agent_id = ? AND policy.policy_id = ?",
			 agent.id, agent.cUpdatedPolicies.get(i).oldPolicy);
 if (!selected_policy_status.equals(agent.cUpdatedPolicies.get(i).newStatus)){//repair the status in the policy table
 	if (agent.cUpdatedPolicies.get(i).oldStatus.equals("Active")){
 		update(policy)
    		.where(policy.policy_id.eq(agent.cUpdatedPolicies.get(i).oldPolicy))
   			.set(policy.status, "Active")
   			.execute();
   			
   		UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,

         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.cUpdatedPolicies.get(i).oldPolicy,
          		date(),

          		selected_policy_status,
          		"Active",
         		"Guido Willemsen"
         		)
         		.execute();	
   			
   			
   			
   	} else {
 		update(policy)
    		.where(policy.policy_id.eq(agent.cUpdatedPolicies.get(i).oldPolicy))
   			.set(policy.status, "Inactive")
   			.execute();
   		UUID uniqueID2 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,

         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID2,
         		"Policy",
         		agent.id,
         		agent.cUpdatedPolicies.get(i).oldPolicy,
          		date(),

          		selected_policy_status,
          		"Inactive",
         		"Guido Willemsen"
         		)
          		.execute();	   			
   			  				 	
	}
	}
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }
 }  
  
main.p_out.take(agent);
//clear execution workspace
agent.executionWorkspace.clear();
agent.simulationWorkspace.clear();
this.main.cBeerGameSim.clear();

//main.p_out.take(agent);
//main.validateIn.take(agent);CHANGE and replaced by the trigger of Execution
//main.controlIn.take(agent);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737309056854</Id>
					<Name><![CDATA[fSimulateProcess]]></Name>
					<X>160</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//initialize vSimulationTriggered
vSimulationTriggered = false;
agent.sli++;

String sim_Id = java.util.UUID.randomUUID().toString();

// if(agent.sli < agent.simulationWorkspaceInit.size()){//for each record in the simulationWorkspace, start the execution of the process
for (int i = 0; i < agent.simulationWorkspaceInit.size(); i++){
 if (agent.simulationWorkspaceInit.get(i).agent_id.equals(vSimAgent)){	
  agent.simulationWorkspaceInit.get(i).sim_id = sim_Id;
  agent.vProcess_Sim_Id = agent.simulationWorkspaceInit.get(i).higher_level_policy_id;
   agent.vStartEventSimulate = selectFirstValue(//Check the start event for the process related to the higher level policy (process id - where type = 0)
		"SELECT process_repository.start_event FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ?",
		vSimAgent, agent.vProcess_Sim_Id);
   agent.vProcessSimulate = selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.process_name FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		vSimAgent, agent.vStartEventSimulate);
	vSimulationTriggered = true;//start the simulation process
	agent.vPolicy_Triggered = agent.simulationWorkspaceInit.get(i).policy_id;//retrieve the initital policy
	agent.si = -1; //Initializing the process instance
	return;//exit this loop
 }
}
//initialize agent simulation variables
agent.vProcess_Instance = 0;
agent.vSimulated_End_Event = "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737367781055</Id>
					<Name><![CDATA[fOrchestrateSimulation]]></Name>
					<X>160</X><Y>830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[	traceln("End of simulation run");
	spolicy = -1;
 	main.validate.Next_Process.take(agent);//when the simulation workspace is a process (type 0), this is currently out of scope]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737367857847</Id>
					<Name><![CDATA[fAnalyzeResults]]></Name>
					<X>160</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[agent.ai++;//increase the index for the next record

for(int i = 0; i < agent.simulationWorkspace.size(); i++) {
	if (agent.simulationWorkspace.get(i).agent_id.equals(agent.id)
		&& agent.simulationWorkspace.get(i).start_event.equals("E1")){
		agent.vExpectedResult = agent.simulationWorkspace.get(i).expected_result;

		break;
	   }
    }

//for now all comparisons are based on MIN logic
if (agent.TTCagentSim < agent.vExpectedResult){
//	&&agent.TTCagentSim > 0.0){//TTCAgent are the total cost of the last execution run. Take care that it has at least a positive value
	agent.vOutcome_Improved = true;
} else {
	agent.vOutcome_Improved = false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737369094450</Id>
					<Name><![CDATA[fDeactivateProcess]]></Name>
					<X>160</X><Y>930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int tmpPolicy = 0;
int selected_policy = 0;
double new_avg_score = 0.0;
int updated_cound_scores = 0;
int temp_count_scores = 0;
double temp_avg_score  = 0;
int trustgroupId = 0;
String tmp_object_type = "";
String tmp_attribute = "";
int updated_count_scores = 0;


for(int i = 0; i < agent.simulationWorkspace.size(); i++) {
//Deactivate process
if (agent.simulationWorkspace.get(i).agent_id.equals(agent.id)){
try {
		update(policy)
    		.where(
   		     policy.higher_level_policy_id.eq(agent.simulationWorkspace.get(i).policy_id)
            .and(policy.status.eq("New"))
            .and(policy.policy_type_id.eq(0))
    		)
    		.set(policy.status, "Inactive")
    		.execute();	


selected_policy = selectUniqueValue(
			"SELECT policy_id FROM policy WHERE policy.agent_id = ? AND policy.higher_level_policy = ? AND policy.poliy_type = ?",
			 agent.id, agent.simulationWorkspace.get(i).policy_id, 1);
    		
    	update(symptom_policy)
    		.where(
   		     symptom_policy.agent_id.eq(agent.id)
   		     .and(symptom_policy.policy_id.eq(selected_policy)
            .and(symptom_policy.status.eq("New"))))
    		.set(symptom_policy.status, "Inactive")
    		.execute();	
 
 	 	tmp_object_type = selectFirstValue(
 		"SELECT policy.object_type FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, selected_policy);
 	
 	 	tmp_attribute = selectFirstValue(
 		"SELECT policy.attribute FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, selected_policy);

// Collection to store the selected trustgroup_ids
		List<Integer> trustgroupIds = new ArrayList<>();
		
		// Execute the query
		List<Tuple> resultsTrust = selectFrom(trustgroups)
		    .where(trustgroups.object_type.eq(tmp_object_type))
		    .where(trustgroups.attribute.eq(tmp_attribute))
		    .list();
		
		// Iterate over the ResultSet and collect all trustgroup_ids
		for (Tuple row : resultsTrust){
		trustgroupId = row.get(5, Integer.class);
try {
// retrieve the avg for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP. THIS SHOULD BE MULTIPLE IN THE FUTURE
 	temp_avg_score = selectFirstValue(
		"SELECT policy_score.avg_policy_score FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id = ?;",
		selected_policy, trustgroupId);
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy score could be found: " + e.getMessage());
		insertInto(policy_score)
        	  .columns(
          		policy_score.trustgroup_id,
          		policy_score.policy_id,
          		policy_score.avg_policy_score,
          		policy_score.count_scores)
          	.values(
         		trustgroupId,
         		selected_policy,
         		100,
         		1)
          		.execute();	       
    } 		
// retrieve the counted scores for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP.THIS SHOULD BE MULTIPLE IN THE FUTURE
	temp_count_scores = selectFirstValue(
	"SELECT policy_score.count_scores FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id =?;",
	selected_policy, trustgroupId); 


//update tables
	new_avg_score  = ((temp_avg_score * temp_count_scores)-100) /(temp_count_scores+1);//negative results
							updated_count_scores = temp_count_scores + 1;
							
							executeStatement("UPDATE policy_score SET avg_policy_score = ?, count_scores = ? WHERE policy_id = ? AND trustgroup_id = ?;"
							, new_avg_score, updated_count_scores, selected_policy, trustgroupId);
							
							executeStatement("UPDATE policy SET score = ? WHERE policy_id = ?;"
							, new_avg_score, selected_policy);	
	} 
    		
	//add changes to log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		selected_policy,
          		date(),
          		"New",
          		"Inactive",
         		"Guido Willemsen")
          		.execute();	
          		
  
   	UUID uniqueID2 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID2,
         		"Symtpom_Policy",
         		agent.id,
         		selected_policy,
          		date(),
          		"New",
          		"Inactive",
         		"Guido Willemsen")
          		.execute();	
	tmpPolicy = agent.simulationWorkspace.get(i).policy_id;
 
          		
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }						
//vSimulationReady = true; //identify that the learning cycle can be ended	

//retrieve previous policy
try {



selected_policy = selectUniqueValue(
			"SELECT policy_id FROM policy WHERE policy.agent_id = ? AND policy.policy_type_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status = ?" ,
			 agent.id,
			 agent.simulationWorkspace.get(i).policy_type_id,
			 agent.simulationWorkspace.get(i).object_type,
			 agent.simulationWorkspace.get(i).attribute,
			 "Inactive");

   //activate previous policy
	
	update(policy)
		.where(policy.policy_id.eq(selected_policy)
				.and(policy.status.eq("Inactive"))
				.and(policy.policy_type_id.eq(0)))
				.set(policy.status, "Active")
				.execute();


	 	update(symptom_policy)
	 			.where(
				symptom_policy.agent_id.eq(agent.id)
   		     	.and(symptom_policy.policy_id.eq(selected_policy))
				.and(symptom_policy.status.eq("Inactive"))
				)
				.set(symptom_policy.status, "Active")
				.execute();
   } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }

}
//Deactivate policy id to agent.confChange collection

for (int j = 0; j < this.main.subject.size(); j++){
	if (this.main.subject.get(j).id != null
		&& this.main.subject.get(j).id.equals(agent.id)){
//		agent.confChanged.add(tmpPolicy, -1); //-1 is remove and 1 is added
		agent.confChanged.add(selected_policy); //-1 is remove and 1 is added
	} 
 }

}
traceln("Deactivate Process Pattern completed");

//if (agent.ai+1 >= agent.simulationWorkspaceLog.size())
if (agent.ai+1 >= agent.simulationWorkspace.size())
  agent.vNo_More_Simulation_Results = true;
traceln("More simulation? "+vNo_More_Simulation_Results);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1737369114331</Id>
					<Name><![CDATA[fDeactivatePolicy]]></Name>
					<X>160</X><Y>960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int tmpPolicy = 0;
int selected_policy = 0;
String vStatus = "";
double new_avg_score = 0.0;
int updated_cound_scores = 0;
int temp_count_scores = 0;
double temp_avg_score  = 0;
int trustgroupId = 0;
String tmp_object_type = "";
String tmp_attribute = "";
int updated_count_scores = 0;


for(int i = 0; i < agent.simulationWorkspace.size(); i++) {
//Deactivate policy
if (agent.simulationWorkspace.get(i).agent_id.equals(agent.id)){


try {
	update(policy)
		.where(policy.higher_level_policy_id.eq(agent.simulationWorkspace.get(i).policy_id)
				.and(policy.status.eq("New")
				.or(policy.status.eq("Selected")))
				.and(policy.policy_type_id.eq(1)))
				.set(policy.status, "Inactive")
				.execute();

selected_policy = selectUniqueValue(
			"SELECT policy_id FROM policy WHERE policy.agent_id = ? AND policy.higher_level_policy = ? AND policy.policy_type = ?",
			 agent.id, agent.simulationWorkspace.get(i).policy_id, 1);
				
 	 	tmp_object_type = selectFirstValue(
 		"SELECT policy.object_type FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, selected_policy);
 	
 	 	tmp_attribute = selectFirstValue(
 		"SELECT policy.attribute FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, selected_policy);

// Collection to store the selected trustgroup_ids
		List<Integer> trustgroupIds = new ArrayList<>();
		
		// Execute the query
		List<Tuple> resultsTrust = selectFrom(trustgroups)
		    .where(trustgroups.object_type.eq(tmp_object_type))
		    .where(trustgroups.attribute.eq(tmp_attribute))
		    .list();
		
		// Iterate over the ResultSet and collect all trustgroup_ids
		for (Tuple row : resultsTrust){
		trustgroupId = row.get(5, Integer.class);

try {
// retrieve the avg for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP. THIS SHOULD BE MULTIPLE IN THE FUTURE
 	temp_avg_score = selectFirstValue(
		"SELECT policy_score.avg_policy_score FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id = ?;",
		selected_policy, trustgroupId);
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy score could be found: " + e.getMessage());
		insertInto(policy_score)
        	  .columns(
          		policy_score.trustgroup_id,
          		policy_score.policy_id,
          		policy_score.avg_policy_score,
          		policy_score.count_scores)
          	.values(
         		trustgroupId,
         		selected_policy,
         		100,
         		1)
          		.execute();	       
    } 		
// retrieve the counted scores for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP.THIS SHOULD BE MULTIPLE IN THE FUTURE
	temp_count_scores = selectFirstValue(
	"SELECT policy_score.count_scores FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id =?;",
	selected_policy, trustgroupId); 

//update tables
	new_avg_score  = ((temp_avg_score * temp_count_scores)-100) /(temp_count_scores+1);//negative results
							updated_count_scores = temp_count_scores + 1;
							
							executeStatement("UPDATE policy_score SET avg_policy_score = ?, count_scores = ? WHERE policy_id = ? AND trustgroup_id = ?;"
							, new_avg_score, updated_count_scores, selected_policy, trustgroupId);
							
							executeStatement("UPDATE policy SET score = ? WHERE policy_id = ?;"
							, new_avg_score, selected_policy);	
	}
				
		//add changes to log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.learningWorkspace.get(i).policy_id, //was learningWorkspaceTemp
          		date(),
//          		old_policy_value,
//         		agent.learningWorkspaceTemp.get(i).policy_value,
          		"New/Selected",
          		"Inactive",
         		"Guido Willemsen")
          		.execute();	
				
		
	tmpPolicy = agent.simulationWorkspace.get(i).policy_id;
				
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }											
//vSimulationReady = true; //identify that the learning cycle can be ended	

//retrieve previous policy
try {



/*	selected_policy = selectUniqueValue(
//			"SELECT policy_id FROM policy WHERE policy.policy_type_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status = ?" ,
			"SELECT policy_id FROM policy WHERE policy.agent_id = ? AND policy.policy_type_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status = ?" ,
			 agent.id,
			 agent.simulationWorkspace.get(i).policy_type_id,
			 agent.simulationWorkspace.get(i).object_type,
			 agent.simulationWorkspace.get(i).attribute,
			 "Inactive");*/

   //activate previous policy
List<Tuple> results = selectFrom(policy).
	where(policy.agent_id.eq(agent.id)).
	where(policy.object_type.eq("1")).
	where(policy.status.eq("Hold"))	
    .list();
    
for (Tuple tuple : results){
		
Integer policyId = tuple.get(policy.policy_id);

Double actualResult = tuple.get(policy.actual_result);
if (actualResult != null && actualResult > 0.0) {
	vStatus = "Inactive";
	} else {
	vStatus = "Active";
	}    
	
	update(policy)
		.where(policy.policy_id.eq(policyId))
				.set(policy.status, vStatus)
				.execute();

	UUID uniqueID3 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID3,
         		"Policy",
         		agent.id,
         		selected_policy,
          		date(),
//          		old_policy_value,
//         		agent.learningWorkspaceTemp.get(i).policy_value,
          		"Hold",
          		vStatus,
         		"Guido Willemsen")
          		.execute();	
}

   } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }				
				
}
//Deactivate policy id to agent.confChange collection
tmpPolicy = agent.simulationWorkspace.get(i).policy_id;

for (int j = 0; j < this.main.subject.size(); j++){
	if (this.main.subject.get(j).id != null
		&& this.main.subject.get(j).id.equals(agent.id)){
//		agent.confChanged.add(tmpPolicy, -1); //-1 is remove and 1 is added
		agent.confChanged.add(tmpPolicy); //-1 is remove and 1 is added

	} 
 }
}
								



traceln("Deactivate Policy completed");

//if (agent.ai+1 >= agent.simulationWorkspaceLog.size())
if (agent.ai+1 >= agent.simulationWorkspace.size())
  agent.vNo_More_Simulation_Results = true;
traceln("More simulation? "+vNo_More_Simulation_Results);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1742568687503</Id>
					<Name><![CDATA[fUpdatePolicy]]></Name>
					<X>160</X><Y>1050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int tmpPolicy = 0;
String vStatus = "";
double new_avg_score = 0.0;
int updated_cound_scores = 0;
int temp_count_scores = 0;
double temp_avg_score  = 0;
int trustgroupId = 0;
String tmp_object_type = "";
String tmp_attribute = "";
int updated_count_scores = 0;

if (agent.vCycle_id >0){

for(int i = 0; i < agent.simulationWorkspace.size(); i++) {
if (agent.simulationWorkspace.get(i).agent_id.equals(agent.id)){
// Activate policy for each simulation result
try {
	int vInactivePolicy = selectFirstValue(
		"SELECT policy.policy_id FROM policy WHERE policy.agent_id = ? AND policy.policy_type_id = ? AND policy.object_type = ? AND policy.attribute = ?",
		agent.id, agent.simulationWorkspace.get(i).policy_type_id, agent.simulationWorkspace.get(i).object_type, agent.simulationWorkspace.get(i).attribute );
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    }

	tmpPolicy = agent.simulationWorkspace.get(i).policy_id;

for (int j = 0; j < this.main.subject.size(); j++){
	if (this.main.subject.get(j).id != null
		&& this.main.subject.get(j).id.equals(agent.id)){
//			agent.confChanged.add(tmpPolicy, 1); //-1 is remove and 1 is added
			agent.confChanged.add(tmpPolicy); //-1 is remove and 1 is added
	} 
 }
// }
//update policy expectation
//try {

List<Tuple> results = selectFrom(policy).
	where(policy.agent_id.eq(agent.id)).
	where(policy.status.eq("New").
	or(policy.status.eq("Selected")))	
    .list();

for (Tuple tuple : results){
		
//for (int policyId : oldPolicy){
Integer policyId = tuple.get(policy.policy_id);

Double actualResult = tuple.get(policy.actual_result);

if (agent.TTCagentSim == 0.0){
	agent.TTCagentSim = tuple.get(policy.expected_result);
}

	vStatus = "Active";




 	 	tmp_object_type = selectFirstValue(
 		"SELECT policy.object_type FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, policyId);
 	
 	 	tmp_attribute = selectFirstValue(
 		"SELECT policy.attribute FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, policyId);

// Collection to store the selected trustgroup_ids
		List<Integer> trustgroupIds = new ArrayList<>();
		
		// Execute the query
		List<Tuple> resultsTrust = selectFrom(trustgroups)
		    .where(trustgroups.object_type.eq(tmp_object_type))
		    .where(trustgroups.attribute.eq(tmp_attribute))
		    .list();
		
		// Iterate over the ResultSet and collect all trustgroup_ids
		for (Tuple row : resultsTrust){
		trustgroupId = row.get(5, Integer.class);

try{		
// retrieve the avg for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP. THIS SHOULD BE MULTIPLE IN THE FUTURE
 	temp_avg_score = selectFirstValue(
		"SELECT policy_score.avg_policy_score FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id = ?;",
		policyId, trustgroupId);
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy score could be found: " + e.getMessage());
		insertInto(policy_score)
        	  .columns(
          		policy_score.trustgroup_id,
          		policy_score.policy_id,
          		policy_score.avg_policy_score,
          		policy_score.count_scores)
          	.values(
         		trustgroupId,
         		policyId,
         		100,
         		1)
          		.execute();	       
    } 			
// retrieve the counted scores for the policy. BE AWARE: AN AGENT CAN ONLY BE PART OF ONE TRUST GROUP.THIS SHOULD BE MULTIPLE IN THE FUTURE
	temp_count_scores = selectFirstValue(
	"SELECT policy_score.count_scores FROM policy_score WHERE policy_score.policy_id = ? AND policy_score.trustgroup_id =?;",
	policyId, trustgroupId); 

//update tables
	new_avg_score  = ((temp_avg_score * temp_count_scores)+100) /(temp_count_scores+1);//positive results
							updated_count_scores = temp_count_scores + 1;
							
							executeStatement("UPDATE policy_score SET avg_policy_score = ?, count_scores = ? WHERE policy_id = ? AND trustgroup_id = ?;"
							, new_avg_score, updated_count_scores, policyId, trustgroupId);
							
							executeStatement("UPDATE policy SET score = ? WHERE policy_id = ?;"
							, new_avg_score, policyId);	
	}
	
	update(policy)
		.where(policy.policy_id.eq(policyId))
				.set(policy.status, vStatus)
				.set(policy.expected_result, agent.TTCagentSim)
				.set(policy.score, new_avg_score)
				.set(policy.actual_result, 0.01)
				.set(policy.simulated_result,0.01)//update the policy expectation with the actual result
				.execute();
				
 		//add changes to log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.simulationWorkspace.get(i).policy_id, //was learningWorkspaceTemp
          		date(),
//          		old_policy_value,
//         		agent.learningWorkspaceTemp.get(i).policy_value,
          		"New/Selected",
          		vStatus,
         		"Guido Willemsen")
          		.execute();	
				
	}


List<Tuple> resultsOld = selectFrom(policy).
	where(policy.agent_id.eq(agent.id)).
	where(policy.status.eq("Hold"))	
    .list();

for (Tuple tuple : resultsOld){
		
//for (int policyId : oldPolicy){
Integer policyId = tuple.get(policy.policy_id);

Double actualResult = tuple.get(policy.actual_result);

	vStatus = "Inactive";

	update(policy)
		.where(policy.policy_id.eq(policyId))
				.set(policy.status, vStatus)
				.set(policy.expected_result, agent.TTCagentSim)
				.set(policy.actual_result, 0.01)
				.set(policy.simulated_result,0.01)//update the policy expectation with the actual result
				.execute();
				
 		//add changes to log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.simulationWorkspace.get(i).policy_id, //was learningWorkspaceTemp
          		date(),
//          		old_policy_value,
//         		agent.learningWorkspaceTemp.get(i).policy_value,
          		"Hold",
          		vStatus,
         		"Guido Willemsen")
          		.execute();	
				
	}				
	
	
				
try {
		update(policy)
		.where(policy.policy_id.eq(agent.simulationWorkspace.get(i).policy_id)
				.and(policy.policy_type_id.eq(0)))
				.set (policy.expected_result, agent.TTCagentSim)
				.set(policy.actual_result, 0.01)
				.set(policy.simulated_result, 0.01)//update the policy expectation with the actual result
				.execute();			
				
    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No policy could be found: " + e.getMessage());
    } 
 }
}



//if (agent.ai+1 >= agent.simulationWorkspaceLog.size())
if (agent.ai+1 >= agent.simulationWorkspace.size())
  agent.vNo_More_Simulation_Results = true;
traceln("More simulation? "+vNo_More_Simulation_Results);

}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1742656093664</Id>
					<Name><![CDATA[fExecuteProcess]]></Name>
					<X>160</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[    UUID vSim_id = UUID.randomUUID();

    traceln("Start of process execution");    
    if ("E5".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_CalculateStock.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_CalculateStock.vSim_id = vSim_id;
        main.sim_CalculateStock.ei = agent.si;
        main.sim_CalculateStock.E5.take(agent);
    } else if ("E6".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_CreatePurchaseOrder.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_CreatePurchaseOrder.vSim_id = vSim_id;
        main.sim_CalculateStock.ei = agent.si;
        main.sim_CreatePurchaseOrder.E6.take(agent);
    } else if ("E1".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_RegisterSalesOrder.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_RegisterSalesOrder.vSim_id = vSim_id;
        main.sim_RegisterSalesOrder.ei = agent.si;
        main.sim_RegisterSalesOrder.E1.take(agent);
    } else if ("E4".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_DeliverGoods.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_DeliverGoods.ei = agent.si;
        main.sim_DeliverGoods.vSim_id = vSim_id;
        main.sim_DeliverGoods.E4.take(agent);  
    } else if ("E2".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_ReceiveGoods.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_ReceiveGoods.ei = agent.si;
        main.sim_ReceiveGoods.vSim_id = vSim_id;
        main.sim_ReceiveGoods.E2.take(agent);  
    } else if ("E3".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_ProduceGoods.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_ProduceGoods.vSim_id = vSim_id;
        main.sim_ProduceGoods.ei = agent.si;
        main.sim_ProduceGoods.E3.take(agent);
    } else if ("E10".equals(agent.simulationWorkspace.get(agent.si).start_event)) {
        main.sim_CalculatePrice.pPolicy_id = agent.simulationWorkspace.get(agent.si).policy_id;
        main.sim_CalculatePrice.vSim_id = vSim_id;
        main.sim_CalculatePrice.ei = agent.si;
        main.sim_CalculatePrice.E10.take(agent);
    } else {
        traceln("No other process could be found");
        agent.vProcessFinished = true;
 		agent.vNo_More_Simulation_Results = true; // in all cases the loop will be ended
 		main.validate.Next_Process.take(agent);//return to the si cycle and stop the simulation
    	}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1742656400728</Id>
					<Name><![CDATA[fMonitorSimulation]]></Name>
					<X>160</X><Y>720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//initialize the process instance record
	Process process_instance = new Process();
	Process process_instance_log = new Process();
	agent.processList.clear(); // reset the process list for this method
	int sCounter = 100;//default value of sequence counter for process sequence
	int aCounter = 0;
	int bCounter = 0;
	int iRootProcess = 0;
	int highest_process_id = 0;
	boolean noActiveProcess = false;
	this.main.validate.vSimCycle_id = 0;
	agent.simulationWorkspace.clear();
	agent.process_Instances.clear();
	boolean simAgentExists = false;
	boolean newAgent = true;//run the model for each agent
	String prevEvent = "";
	ArrayList<String> prevAgents = new ArrayList<>();//list of agents that have been added to the simulation workspace

	agent.vProcessFinished = false; //reset process indicator


//initialize the values that need to be written to the simulation Workspace
		String tmp_sim_id = "";
		int tmp_sim_cycle = 0;
		String tmp_start_event = "";
		int tmp_sequence = 0;
		String tmp_execute_process = "";
		String tmp_end_event = "";
		int tmp_policy_id = 0;
		String tmp_agent_id = "";
		String tmp_agent_type = "";
		String tmp_policy_name = "";
		int tmp_policy_type_id = 0;
		String tmp_script = "";
		String tmp_object_type = "";
		String tmp_attribute = "";
		double tmp_policy_value = 0.0;
	 	double tmp_previous_policy_value = 0.0;
	 	double tmp_policy_score = 0.0;
		double tmp_expected_result = 0.0;
		String tmp_optimization_indicator = "";
		String tmp_source = "";
		int tmp_version = 0;
		int tmp_change_pointer = 0;
		String tmp_status = "";
		int tmp_higher_level_policy_id = 0;
		double tmp_actual_result = 0.0;
		double tmp_simulated_result = 0.0;
		String tmp_learning_method = "";
		


//for (int j = 0; j < agent.process_Instances.size(); j++){
//if (agent.process_Instances.get(j).getAgent_Id().equals(vSimAgent)){


for (int k = 0; k < agent.simulationWorkspaceInit.size(); k++){
		String selAgent = selectFirstValue(
    		"SELECT agents.agent_id FROM agents WHERE agents.agent_id = ? AND agents.selected = ?",
    		agent.simulationWorkspaceInit.get(k).agent_id, true
//    		vSimAgent, true
			);
		boolean agentsel = false;	
		if(selAgent != null){
			agentsel = true;
		}	

			
	if (agentsel == true){
//		&&agent.simulationWorkspaceInit.get(k).agent_id.equals(vSimAgent)){//only select the simulation record for the current active simulation agent
		
		tmp_policy_id = selectFirstValue(
   		"SELECT policy.policy_id FROM policy WHERE policy.higher_level_policy_id = ? AND policy.agent_id = ?",
   		agent.simulationWorkspaceInit.get(k).higher_level_policy_id, agent.simulationWorkspaceInit.get(k).agent_id
		);
			
		String event = selectFirstValue(
			"SELECT process_repository.start_event FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ?",
//			agent.simulationWorkspaceInit.get(k).agent_id, tmp_policy_id);
			agent.simulationWorkspaceInit.get(k).agent_id, tmp_policy_id);			
	if(!prevEvent.equals(event)){
		 if(event.equals("E1")&&prevAgents.contains(agent.simulationWorkspaceInit.get(k).agent_id)){
		 	simAgentExists = true;
		 }
//			&& agent.simulationWorkspaceInit.get(k).policy_id == tmp_policy_id){
//			&& agent.simulationWorkspaceInit.get(k).policy_id == agent.process_Instances.get(j).getProcess_Id()){
//		 prevEvent = agent.simulationWorkspaceInit.get(k).start_event;	
		if (simAgentExists == false){
		 prevAgents.add(agent.simulationWorkspaceInit.get(k).agent_id);//add the current simulation agent to the list
		 prevEvent = event;
		 tmp_sim_id = "";
		 tmp_sim_cycle = agent.vN;
		 tmp_agent_id = agent.simulationWorkspaceInit.get(k).agent_id;
		 tmp_agent_type = agent.simulationWorkspaceInit.get(k).agent_type;	 
		 tmp_start_event = selectFirstValue(
   			"SELECT process_repository.start_event FROM process_repository WHERE process_repository.policy_id = ?",
   			agent.simulationWorkspaceInit.get(k).policy_id
			);
		 tmp_sequence = selectFirstValue(
   			"SELECT process_repository.sequence FROM process_repository WHERE process_repository.policy_id = ?",
   			agent.simulationWorkspaceInit.get(k).policy_id
			);
		 tmp_execute_process = selectFirstValue(
   			"SELECT process_repository.process_name FROM process_repository WHERE process_repository.policy_id = ?",
   			agent.simulationWorkspaceInit.get(k).policy_id
			);
		 tmp_end_event = selectFirstValue(
   			"SELECT process_repository.end_event FROM process_repository WHERE process_repository.policy_id = ?",
   			agent.simulationWorkspaceInit.get(k).policy_id
			);
		 tmp_policy_id = agent.simulationWorkspaceInit.get(k).policy_id;
	 	 tmp_policy_name = agent.simulationWorkspaceInit.get(k).policy_name; 
		 tmp_policy_type_id = agent.simulationWorkspaceInit.get(k).policy_type_id;	 
		 tmp_script = agent.simulationWorkspaceInit.get(k).script;	 
		 tmp_object_type = agent.simulationWorkspaceInit.get(k).object_type;
		 tmp_attribute = agent.simulationWorkspaceInit.get(k).attribute;
	 	 tmp_policy_value = agent.simulationWorkspaceInit.get(k).policy_value; 
		 tmp_previous_policy_value = agent.simulationWorkspaceInit.get(k).previous_policy_value; 
	 	 tmp_policy_score = agent.simulationWorkspaceInit.get(k).policy_score;
		 tmp_expected_result = agent.simulationWorkspaceInit.get(k).expected_result;	 
		 tmp_optimization_indicator = agent.simulationWorkspaceInit.get(k).optimization_indicator;	 
		 tmp_source = agent.simulationWorkspaceInit.get(k).source; 
		 tmp_version = agent.simulationWorkspaceInit.get(k).version;	 
	 	 tmp_change_pointer = agent.simulationWorkspaceInit.get(k).change_pointer;	 
	 	 tmp_status = agent.simulationWorkspaceInit.get(k).status;
	 	 tmp_higher_level_policy_id = agent.simulationWorkspaceInit.get(k).higher_level_policy_id; 
	 	 tmp_actual_result = agent.simulationWorkspaceInit.get(k).actual_result;
	 	 tmp_simulated_result = agent.simulationWorkspaceInit.get(k).simulated_result;	 
		 tmp_learning_method = agent.simulationWorkspaceInit.get(k).learning_method;	

	SimResults simResultTmp = new SimResults(
		tmp_sim_cycle,
		tmp_sim_id,
		tmp_start_event,
		tmp_sequence,	
		tmp_execute_process,
		tmp_end_event,
		tmp_policy_id,
		tmp_agent_id,
		tmp_agent_type,
		tmp_policy_name,
		tmp_policy_type_id,
		tmp_script,
		tmp_object_type,
		tmp_attribute,
		tmp_policy_value,
	 	tmp_previous_policy_value,
	 	tmp_policy_score,
		tmp_expected_result,
		tmp_optimization_indicator,
		tmp_source,
		tmp_version,
		tmp_change_pointer,
		tmp_status,
		tmp_higher_level_policy_id,
		tmp_actual_result,
		tmp_simulated_result,
		tmp_learning_method
		);
		
	agent.simulationWorkspace.add(simResultTmp)	;
//	agent.process_Instances_log.add(agent.process_Instances.get(j));
//	break;
	}
	}
	}
	 simAgentExists = false;//reset boolean	
	}


agent.si = -1;

// full Simulation Workspace added
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
