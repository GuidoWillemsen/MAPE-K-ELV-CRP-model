						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//show the image when this class is active

isActive = true;

/*try {
   pProcess_id =    selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.policy_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E6");//for each process define the start event here as a variable
  } catch (Exception e) {
    traceln("No process for this start event E6 for agent "+agent.id );
  }
  
//   int process_id = pProcess_id.substring(0);  	  

for (int i = 0; i < agent.simulationWorkspace.size(); i++){

// if (agent.simulationWorkspace.get(i).policy_type_id == 1 
//	&& agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){
 if (agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){

	pPolicy_id = agent.simulationWorkspace.get(i).policy_type_id;
	pPolicy_type = agent.simulationWorkspace.get(i).policy_type_id;
	pObject_type = agent.simulationWorkspace.get(i).object_type;
	pAttribute = agent.simulationWorkspace.get(i).attribute;
	if (agent.simulationWorkspace.get(i).object_type.equals("ROP")){
		vROP = agent.simulationWorkspace.get(i).policy_value;
	} else {
		if (agent.simulationWorkspace.get(i).object_type.equals("OS")){
		vOS = agent.simulationWorkspace.get(i).policy_value;
		}
	}
	return;
	
 }
}*/

/* if (agent.simulationWorkspace.get(agent.si).policy_type_id == 1)){
try {   
   pPolicy_type = selectUniqueValue(//retrieve the policy type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.policy_type_id FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?)",
		pProcess_id);
  } catch (Exception e) {
    traceln("An unexpected error occurred: " + e.getMessage());
    return;
 }
}

try {
   pObject_type = selectUniqueValue(//retrieve the object type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.object_type FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
} catch (Exception e) {
	traceln("An unexpected error occured: " + e.getMessage());
	return;
}

try {	
	pAttribute = selectUniqueValue(//retrieve the attribute from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.attribute FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
} catch (Exception e) {
	traceln("An unexpected error occured: " + e.getMessage());
	return;
}

try {		
	pValue = selectUniqueValue(//retrieve the value from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.value FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);		
 } catch (Exception e) {
	traceln("An unexpected error occured: " + e.getMessage());
	return;
}*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1739385589939</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<Description><![CDATA[This is a unique method for a specific use, in this case to redefine the Reorder Point]]></Description>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[boolean existingResult = false;
boolean newEntry = false;
boolean addResult = false;


//EXECUTION SPACE


 for (int i = 0; i < agent.executionWorkspace.size(); i++){
	if (agent.executionWorkspace.get(i).status.equals("Active")){
		if (agent.executionWorkspace.get(i).start_event.equals("E6")){
		
		if (agent.executionWorkspace.get(i).attribute.equals("wsl")){
			vwsl = agent.executionWorkspace.get(i).value;
		  agent.executionWorkspace.get(i).status = "Processed";					
		} else if (agent.executionWorkspace.get(i).attribute.equals("mdt")){
			vmdt = agent.executionWorkspace.get(i).value;
		  agent.executionWorkspace.get(i).status = "Processed";					
	  } else {
	  	traceln("No parameter is relevant for execution"); 
	  }
	}
  }
 agent.executionWorkspace.get(i).status = "Processed";
 } //REMOVED AS IT IS NOT USED IN EXECUTION SPACE/
if (agent.vCycle_id == 0){
	traceln("Initialization");
}

//	String agent_type = selectFirstValue(
//			"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
//			agent.id);
//  if (agent.vCycle_id == 0){
	if (agent.type.equals("AT1")){//when the agent is a consumer
		if ((agent.vCycle_id+1) < 5){//[7] 
//			agent.ENDCD = 0;
			agent.O = main.pStartOrderQty;//4;
//		} else if (agent.vCycle_id < 5){ //[7] 
//			agent.ENDCD = 4; 
//			agent.O = 4; 
		} else {
//			agent.ENDCD = 8;// and this is the value after 5 runs
			agent.O = main.pIncreasedOrderQty;//8;// and this is the value after 5 runs
		}
//	   		agent.O = agent.ENDCD;//copy quantity to Order
	   		
	   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			
			
			Order new_Order = new Order();
			new_Order.Quantity = agent.O;
			new_Order.Order_id = agent.order_id;
			new_Order.Agent_type = agent.type;
			new_Order.Agent_id = agent.id;
			new_Order.Cycle_id = (agent.vCycle_id+1);////
			new_Order.Status = "PO Created";
			newEntry = true;
		
			this.main.Orders.add(new_Order);//add the purchase order to orders
			
		
//			if (agent.vCycle_id == 0){
				//add the parameters to the results table
 				for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
				 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 				 	&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id)){
				 	this.main.cBeerGameResults.get(k).I = agent.I;
				 	this.main.cBeerGameResults.get(k).B = agent.B;
				 	this.main.cBeerGameResults.get(k).i = agent.id;
				 	this.main.cBeerGameResults.get(k).S = agent.S;

 					existingResult = true;
 					
 					if (agent.vCycle_id == 0){
 						this.main.cBeerGameResults.get(k).O = agent.O;
 						}
					}
				}	

 				for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
//For initalization cycle 0
				 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 				 	&& (this.main.cBeerGameResults.get(k).t == 0)){
				 	this.main.cBeerGameResults.get(k).ENDCD = agent.O;
 					this.main.cBeerGameResults.get(k).O = agent.O;
 					existingResult = true;
 					}			
 //for all other cycles 
				 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 				 	&& (this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1)){
				 	this.main.cBeerGameResults.get(k).ENDCD = agent.O;
 					this.main.cBeerGameResults.get(k).O = agent.O;
 					existingResult = true;
 					}
 				}
 								
			for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){		
				 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
				  	&& !existingResult == true){
 				 		if (this.main.cBeerGameResults.get(k).t == agent.vCycle_id+1){

 					//add the order quantity to a new record at t+1
					} else {
					
					addResult = true;

 				 		}					
					}
  				 }
				if(addResult == true){	
		   					BeerGame_Results orderNextCycleAT1 = new BeerGame_Results();
   	
   							orderNextCycleAT1.agent_id = agent.id;
   							orderNextCycleAT1.agent_type = agent.type;
   							orderNextCycleAT1.i = agent.id;
