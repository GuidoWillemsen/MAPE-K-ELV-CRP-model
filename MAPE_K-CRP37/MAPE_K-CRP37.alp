							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[traceln("Start importing new data");

//retrieve the events from the external excel file
ActualEvents.clear();//reset


executeStatement("DELETE FROM events e");
 

ModelDatabase op_events = getEngine().getModelDatabase();

Database myFile = new Database(this, "table_events", "C:/Users/GuidoWillemsen/OneDrive - ISCTE-IUL/CRP Model/Anylogic/Database_table_events.xlsx");

op_events.importFromExternalDB(myFile.getConnection(), "Table_Events", "events", true, false);//events will be added to the events table



List<Tuple> rows = selectFrom(events).list();

for (Tuple row : rows) {
    traceln(
        row.get(events.event_id) + "\t" +
        row.get(events.event_name)+ "\t" +
        row.get(events.event_type)+ "\t" +
        row.get(events.process_id)+ "\t" +
        row.get(events.actual_result)+ "\t" +
        row.get(events.included)+ "\t" +
        row.get(events.event_description)+ "\t" +
        row.get(events.agent_id)
    );

    // Assuming the first element of the tuple is the Events object
     Events event = new Events();
     event.event_id = row.get(events.event_id);
     event.event_name = row.get(events.event_name);
     event.event_type = row.get(events.event_type);     
     event.policy_id = row.get(events.process_id);     
     event.actual_result = row.get(events.actual_result);
     event.included = row.get(events.included);
     event.agent_id = row.get(events.agent_id);
//     event.event_description = row.get(events.event_description);             
    ActualEvents.add(event);
}

traceln("Transfer to Monitor");]]></Code>
							</Value>
