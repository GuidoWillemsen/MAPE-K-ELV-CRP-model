					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[List< Tuple > selected_policies = 
		selectFrom( policy ).
		where( policy.agent_id.eq( agent.id ),
		policy.policy_type_id.eq(1), //for this agent and only parameters CORRECTED
		policy.status.eq("Active")). 
   		list();

Random rand = new Random();
int random_number = rand.nextInt(selected_policies.size());


Tuple sel = selected_policies.get(random_number);

//fill in learning environment for the random choosen policy

	Learning le = 
		new Learning(
			sel.get( policy.policy_id ),
			sel.get( policy.agent_id ), 
			sel.get( policy.policy_name ), 
			sel.get( policy.policy_type_id ),
			sel.get( policy.script ),
			sel.get( policy.object_type ),
			sel.get( policy.attribute ),
			sel.get( policy.policy_value ),
			sel.get( policy.previous_policy_value),
			sel.get( policy.score ),
			sel.get( policy.expected_result ),
			sel.get( policy.optimization_indicator ),
			sel.get( policy.source ),
			sel.get( policy.version ),
			sel.get( policy.change_pointer ),
			sel.get( policy.status ),
			sel.get( policy.higher_level_policy_id ),
			sel.get( policy.actual_result ),
			sel.get( policy.simulated_result ),
			sel.get( policy.learning_method )
		);
	le.status = "New";
	le.learning_method = vLearningMethod;

//check if the policy is already in the learning workspace
		boolean new_value = true;
		
		for (int k = 0; k < agent.learningWorkspace.size(); k++){
			
			if (agent.learningWorkspace.get(k).policy_id == (le.policy_id)){
				new_value = false;
			}
		}	
		if (new_value == true){
			// add retrieved policy details and add to learning workspace
			agent.learningWorkspace.add( le );
		} else {
		traceln("Policy was already in the learning workspace Random: ");
		}	
	
	
//	agent.learningWorkspace.add( le );

	

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1736523191682</Id>
					<Name><![CDATA[fOrchestrateEvaluation]]></Name>
					<X>400</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Process orchestrater at Evaluation");
	main.ev_out.take(agent); // go to the learning process]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1741893002411</Id>
					<Name><![CDATA[fUpdatePolicyResult]]></Name>
					<X>400</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[ //for all records in the agent Learning Workspace, update the learning method and the expected reslt for each policy, based on the higher level policy (process)
 
 for (int i = 0; i < agent.learningWorkspace.size(); i++){
 		for(int j = 0; j < agent.actualOutcome.size(); j++){//retrieve the learning method from the higher level process
			if (agent.learningWorkspace.get(i).higher_level_policy_id == agent.actualOutcome.get(j).policy_id){
			agent.learningWorkspace.get(i).learning_method = agent.actualOutcome.get(j).learning_method;
			}
		}
	agent.learningWorkspace.get(i).optimization_indicator = selectUniqueValue(
					"SELECT policy.optimization_indicator FROM policy WHERE policy.policy_id = ?",
					agent.learningWorkspace.get(i).higher_level_policy_id);
	}
		
	]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764882822683</Id>
					<Name><![CDATA[fAddCRPPolicy]]></Name>
					<X>400</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[/*List<Tuple> crpPolicy = selectFrom(policy)
    .where(policy.agent_id.eq(agent.id)
    .and(policy.status).eq("New"))
    .list();

// add new policies to learninWorkspace
for (Tuple row : crpPolicy) {
    Learning addPolicy = row.get();
    agent.cLearningWorkspace.add(new Learning(addPolicy);
}*/

// Fetch policies for the agent with status "New"
List<Tuple> crpPolicy = selectFrom(policy)
    .where(policy.agent_id.eq(agent.id)
        .and(policy.status.eq("New")))
    .list();

// Add new policies to learningWorkspace
if (crpPolicy != null && !crpPolicy.isEmpty()) {
for (Tuple row : crpPolicy) {
    try {
        // Extract values from the Tuple row using the correct keys or indices
        int policy_id = row.get(policy.policy_id); 
        String agent_id = row.get(policy.agent_id);
        String policy_name = row.get(policy.policy_name);
        int policy_type_id = row.get(policy.policy_type_id);
        String script = row.get(policy.script);
        String object_type = row.get(policy.object_type);
        String attribute = row.get(policy.attribute);
        double policy_value = row.get(policy.policy_value);
        double previous_policy_value = row.get(policy.previous_policy_value);
        double score = row.get(policy.score);
        double expected_result = row.get(policy.expected_result);
        String optimization_indicator = row.get(policy.optimization_indicator);
        String source = row.get(policy.source);   
        int version = row.get(policy.version);
        int change_pointer = row.get(policy.change_pointer);
        String status = row.get(policy.status);
        int higher_level_policy_id = row.get(policy.higher_level_policy_id); 
        double actual_result = row.get(policy.actual_result);
        double simulated_result = row.get(policy.simulated_result);
        String learning_method = row.get(policy.learning_method);

        // Create the Learning object
        Learning addPolicy = new Learning(
            policy_id,
            agent_id,
            policy_name,
            policy_type_id,
            script,
            object_type,
            attribute,
            policy_value,
            previous_policy_value,
            score,
            expected_result,
            optimization_indicator,
            source,
            version,
            change_pointer,
            status,
            higher_level_policy_id,
            actual_result,
            simulated_result,
            learning_method
        );
        agent.learningWorkspace.add(addPolicy);
    } catch (Exception e) {
        System.err.println("Error creating or adding Learning object: " + e.getMessage());
    }
}

}
]]></Body>
				</Function>
