		<JavaClass>
			<Id>1723742457431</Id>
			<Name><![CDATA[Country]]></Name>
			<Text><![CDATA[/**
 * Country
 */	
public class Country implements java.io.Serializable {

	 public String name;
	
	 public String capital;
	
	 public int population;
	

    /**
     * Default constructor
     */
    public Country(){
    }

    /**
     * Constructor initializing the fields
     */     
    public Country(String name, String capital, int population){
		this.name = name;
		this.capital = capital;
		this.population = population;
    }     
	
	@Override
	public String toString() {
		return  
			"name = " + name +" " +
			"capital = " + capital +" " +
			"population = " + population +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1723742548654</Id>
			<Name><![CDATA[Events]]></Name>
			<Text><![CDATA[/**
 * Events
 */	
public class Events implements Serializable {

	public Integer event_id;

	public String event_name;

	public String event_type;
	
	public Integer count_duplicates = 0;
	
	public Integer symptom_id = null;
	
	public int policy_id = 0;
	
	public String normalized_event;
	
	public Boolean marker;
		
	public double actual_result = 0.0;
	
	public boolean deletion_indicator = false;
	
	public boolean included = false;
	
	public String agent_id;
	
	

    /**
     * Default constructor
     */
    public Events() {
    }

    /**
     * Constructor initializing the fields
     */
    public Events(Integer event_id, String event_name, String event_type, Integer count_duplicates, Integer symptom_id, int policy_id, String normalized_event, Boolean marker, Double actual_result, Boolean deletion_indicator, Boolean included, String agent_id) {
		this.event_id = event_id;
		this.event_name = event_name;
		this.event_type = event_type;
		this.count_duplicates = count_duplicates;
		this.symptom_id = symptom_id;
		this.policy_id = policy_id;
		this.normalized_event = normalized_event;
		this.marker = marker;
		this.actual_result = actual_result;
		this.deletion_indicator = false;
		this.included = false;
		this.agent_id = "";
    }

    // Getters and Setters

    public Integer getEvent_id() {
        return event_id;
    }

    public void setEvent_id(Integer event_id) {
        this.event_id = event_id;
    }

    public String getEvent_name() {
        return event_name;
    }

    public void setEvent_name(String event_name) {
        this.event_name = event_name;
    }

    public String getEvent_type() {
        return event_type;
    }

    public void setEvent_type(String event_type) {
        this.event_type = event_type;
    }

    public Integer getCount_duplicates() {
        return count_duplicates;
    }

    public void setCount_duplicates(Integer count_duplicates) {
        this.count_duplicates = count_duplicates;
    }

    public Integer getSymptom_id() {
        return symptom_id;
    }

    public void setSymptom_id(Integer symptom_id) {
        this.symptom_id = symptom_id;
    }

    public int getPolicy_id() {
        return policy_id;
    }

    public void setPolicy_id(int policy_id) {
        this.policy_id = policy_id;
    }

    public String getNormalized_event() {
        return normalized_event;
    }

    public void setNormalized_event(String normalized_event) {
        this.normalized_event = normalized_event;
    }

    public Boolean getMarker() {
        return marker;
    }

    public void setMarker(Boolean marker) {
        this.marker = marker;
    }

    public double getActual_result() {
        return actual_result;
    }

    public void setActual_result(double actual_result) {
        this.actual_result = actual_result;
    }

    public boolean isDeletion_indicator() {
        return deletion_indicator;
    }

    public void setDeletion_indicator(boolean deletion_indicator) {
        this.deletion_indicator = deletion_indicator;
    }

    public boolean isIncluded() {
        return included;
    }

    public void setIncluded(boolean included) {
        this.included = included;
    }
    
    public String getAgent_id() {
        return agent_id;
    }

    public void setAgent_id(String agent_id) {
        this.agent_id = agent_id;
    }
    
	@Override
	public String toString() {
		return  
			"event_id = " + event_id +" " +
			"event_name = " + event_name +" " +
			"event_type = " + event_type +" " +
			"count_duplicates = " + count_duplicates +" " +
			"symptom_id = " + symptom_id +" " +
			"policy_id = " + policy_id +" "+
			"normalized_event = "+ normalized_event +" "+
			"marker = " + marker + " " +
			"actual_result = " + actual_result + " " +
			"deletion_indocator = " + deletion_indicator + " "+
			"included = " + included + " "+
			"agent_id = " + agent_id + " ";
	}
	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1729515711106</Id>
			<Name><![CDATA[RFCs]]></Name>
			<Text><![CDATA[/**
 * RFCs
 */	
public class RFCs implements Serializable {

	public Integer policy_id = 0;
	
	public String agent_id;
	
	public Date execution_date;
	
	public String policy_name;
	
	public Integer policy_type_id = 0;
	
	public String script;
	
	public String object_type;
	
	public String attribute;
	
	public Double policy_value = 0.0;
	
	public Double score;
	
	public Double expected_result;
	
	public String source;
	
	public Integer higher_level_policy_id;
	
	public String status;
	
	public Integer version;
	
	public Integer change_pointer;
	
	

    /**
     * Default constructor
     */
    public RFCs() {
    }

    /**
     * Constructor initializing the fields
     */
    public RFCs(int policy_id, String agent_id, Date execution_date, String policy_name, int policy_type,  String object_type, String attribute, Double policy_value, Double score, Double expected_result, String source, Integer higher_level_policy_id, String status, int version, int change_pointer) {
		this.policy_id = policy_id;
		this.agent_id = agent_id;
		this.execution_date = execution_date;
		this.policy_name = policy_name;
		this.policy_type_id = policy_type_id;
		this.script = script;
		this.object_type = object_type;
		this.attribute = attribute;
		this.policy_value = policy_value;
		this.score = score;
		this.expected_result = expected_result;
		this.source = source;
		this.higher_level_policy_id = higher_level_policy_id;
		this.status = status;
		this.version = version;
		this.change_pointer = change_pointer;
    }

	@Override
	public String toString() {
		return  
			"policy_id = " + policy_id +" " +
			"agent_id = " + agent_id +" "+
			"execution_date = " + execution_date +" "+
			"policy_name = "+ policy_name +" "+
			"policy_type_id = " + policy_type_id +" "+
			"script = " + script +" "+
			"object_type = " + object_type + " "+
			"attribute = " + attribute + " "+
			"policy_value = " + policy_value + " "+
			"score = " + score + " "+
			"expected_result = " + expected_result + " " +
			"source = " + source + " " +
			"higher_level_policy_id = " + higher_level_policy_id + " " +
			"status = " + status + " "+
			"version = " + version + " " +
			"change_pointer = " + change_pointer + " ";
	}

	/*
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;
}
]]></Text>
