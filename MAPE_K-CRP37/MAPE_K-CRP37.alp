					<Body><![CDATA[ModelDatabase modelDB = getEngine().getModelDatabase();

Database myFile = new Database(this, "Database_table_results", "C:\\Users\\GuidoWillemsen\\Models\\Database_table_results.xlsx");
//add default content to policy and symptom_policy table
modelDB.importFromExternalDB(myFile.getConnection(), "policy", "policy", true, false);
modelDB.importFromExternalDB(myFile.getConnection(), "symptom_policy", "symptom_policy", true, false);
modelDB.importFromExternalDB(myFile.getConnection(), "policy_score", "policy_score", true, false);]]></Body>
