				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719426976339</Id>
					<Name><![CDATA[fOrchestrateMonitor]]></Name>
					<X>180</X><Y>3650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[/*//define highest sequence number for agents
int highestSeq = 0; //define the highest sequence number for agents
for (int i = 0; i < subject.size(); i++){
	if (subject.get(i).sequence > highestSeq){
		highestSeq = subject.get(i).sequence;
		subject.get(i).fDeactivate(agent);
	}
}



if (agent.sequence == agentSeq + 1 ){
	agentSeq++;
	monitor.mapeKTriggered.take(agent);
	
} else {
}		


if (cycleStatus == agent.vCycle_id){//only process the agent for the active cycle
	if (agent.type.equals("AT1"))
	monitor.mapeKTriggered.take(agent);
};*/
	monitor.mapeKTriggered.take(agent);	]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
