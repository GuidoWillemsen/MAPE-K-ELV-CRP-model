				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864448922</Id>
					<Name><![CDATA[fValidatePolicy]]></Name>
					<X>460</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//initialize active symptom

agent.activeSymptom = false;

for (int i = 0; i < agent.eventWorkspace.size(); i++) {
	Events eventList = (Events) agent.eventWorkspace.get(i);
	
	Integer symptomId = (Integer) eventList.symptom_id;
try{	
	//retrieve the status of the symptom. When active, proceed, otherwise, stop
	String status = selectFirstValue(
			"SELECT symptom.status FROM symptom WHERE symptom.symptom_id = ?",
			symptomId);
	//for now only one policy per symptom is possible
	Integer policyId = selectFirstValue(
			"SELECT symptom_policy.policy_id FROM symptom_policy WHERE symptom_policy.symptom_id = ? AND symptom_policy.agent_id = ?",
			symptomId, agent.id);	
	eventList.policy_id = policyId;

		
//	traceln("Validate Policy - policyid and status: " +policyId +status);
	if ("Active".equals(status)) {
		agent.activeSymptom = true;
		traceln("Validay Policy break out");
		//break; // Breaks out of the for-loop
	} else {
		 agent.activeSymptom = false ;	
	}
	
 } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No symptom policy records found");
 }	
 traceln("End of Validate Policy");
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864448924</Id>
					<Name><![CDATA[fRetrievePolicy]]></Name>
					<X>460</X><Y>720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("@Retrieve Policy - eventWorkspace: "+agent.eventWorkspace);
//initialize active policy parameter

	agent.activePolicy = false;

var row = new ArrayList<RFCs>();

//first replace the process id with the corresponding policy id for that process in the evenWorkspace

int counter = agent.eventWorkspace.size(); //fix the counter as records will be added to the workspace

for (int i = 0; i < agent.eventWorkspace.size(); i++) {
	
	String processId = String.valueOf(agent.eventWorkspace.get(i).policy_id);
	Integer processTypeId = 0;

try {	
	Integer policy_id = selectFirstValue(
		"SELECT policy.policy_id FROM policy WHERE policy.policy_type_id = ? AND policy.attribute = ? AND policy.agent_id = ?",
		processTypeId, processId, agent.id);
	agent.eventWorkspace.get(i).policy_id = policy_id;

    } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("Event is removed from eventWorkspace as this is not revelevant for this agent while no policy is available");
        agent.eventWorkspace.get(i).deletion_indicator = true;
    }
   
   }
  
  //remove all records from the eventWorkspace that are not relevant 	
for (int j = 0; j < counter; j++) {
	if (agent.eventWorkspace.get(j).deletion_indicator == true){
		agent.eventWorkspace.remove(j);
		j--;
		counter--;
	}
}

// Now retrieve the related decision policies for the process policies (via higher level policy) and add this to the workspace

	int counter2 = agent.eventWorkspace.size(); //fix the counter as records will be added to the workspace
	


List<Tuple> selected_policies = new ArrayList<>();

for (int j = 0; j < counter2; j++) {
    try {
        // Use the correct entity path for the selectFrom method
//        BooleanExpression notPolicyIdCondition = policy.policy_id.eq(agent.eventWorkspace.get(j).policy_id).not();
//	if (notPolicyIdCondition.equals(true)){
        selected_policies = selectFrom(policy)
                            .where(policy.higher_level_policy_id.eq(agent.eventWorkspace.get(j).policy_id),
                                   //notPolicyIdCondition,
                                   policy.agent_id.eq(agent.id), policy.status.eq("Active"))
                            .list();

        for (int k = 0; k < selected_policies.size(); k++) {
        	//do not add records that where the policy id equals the higher level policy id (as this is a proces type
        	
           
//        	if (!selected_policies.get(k).policy_id.equals(selected_policies.get(k).higher_level_policy_id)) {
        	
            Tuple sel = selected_policies.get(k);
            
			int policyId = sel.get(policy.policy_id);
   			int higherLevelPolicyId = sel.get(policy.higher_level_policy_id); // Adjust if necessary

    		if (policyId != higherLevelPolicyId) {

		    // Access elements using expressions
            int event_id = agent.eventWorkspace.get(j).event_id;
            String event_name = agent.eventWorkspace.get(j).event_name;
            String event_type = agent.eventWorkspace.get(j).event_type;
            int count_duplicates = agent.eventWorkspace.get(j).count_duplicates;
            int symptom_id = agent.eventWorkspace.get(j).symptom_id;
            int policy_id = sel.get(policy.policy_id); // Ensure policy_id is the correct field name
            String normalized_event = agent.eventWorkspace.get(j).normalized_event;
            boolean marker = false;
            double actual_result = agent.eventWorkspace.get(j).actual_result;
            boolean deletion_indicator = agent.eventWorkspace.get(j).deletion_indicator;
            boolean included = agent.eventWorkspace.get(j).included;

            // Create the Events object
            Events es = new Events(
                event_id,
                event_name,
                event_type,
                count_duplicates,
                symptom_id,
                policy_id,
                normalized_event,
                marker,
                actual_result,
                deletion_indicator,
                included,
                agent.id
            );

            agent.eventWorkspace.add(es);
        }
        }
//      }
    } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No higher level policy found");
    }
} 

//Now create the RFC workspace

for (int i = 0; i < agent.eventWorkspace.size(); i++) {
	Events eventList = (Events) agent.eventWorkspace.get(i);
	Integer policyId = (Integer) eventList.policy_id;
	Integer symptomId = (Integer) eventList.symptom_id;
	String status = selectFirstValue(
			"SELECT policy.status FROM policy WHERE policy.policy_id = ? AND policy.agent_id = ?",
			policyId, agent.id); // only one policy per symptom is now selected
	traceln("Retrieve Policy - symptom and status: " +symptomId +status);
	
	Integer policyType = selectFirstValue(
		"SELECT policy.policy_type_id FROM policy WHERE policy.policy_id = ? AND policy.agent_id = ?",
		policyId, agent.id);
		
	Integer hl_policy = selectFirstValue(
		"SELECT policy.higher_level_policy_id FROM policy WHERE policy.policy_id = ? AND policy.agent_id = ?",
		policyId, agent.id); 		
	
		RFCs rFC = new RFCs();
		rFC.policy_id = policyId;
		rFC.agent_id = agent.id;
		rFC.execution_date = date();
		rFC.policy_type_id = policyType;
		rFC.higher_level_policy_id = hl_policy;
		rFC.status = "New";
		traceln("Content of Row: "+rFC);
			
					
	if ("Active".equals(status)) {
		agent.activePolicy = true;
		agent.rFCWorkspace.add(rFC);
		//break; // Breaks out of the for-loop
	} else { 
		agent.activePolicy = false;	
		agent.configurationRemoved = agent.eventWorkspace.get(i).policy_id;
	}


	traceln("rFCWorkspace @Retrieve Policy: "+agent.rFCWorkspace);
} 

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864448926</Id>
					<Name><![CDATA[fDetectConflict]]></Name>
					<X>460</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[LinkedList<Integer> policyTypeCount = new LinkedList<Integer>();

agent.rFCConflict = false;

List sortedByTypeAsc = sortAscending( agent.rFCWorkspace, r -> r.policy_type_id );

for (int i = 0; i < agent.rFCWorkspace.size(); i++) {
	RFCs rFCList = (RFCs) agent.rFCWorkspace.get(i);
	Integer policyTypes = rFCList.policy_type_id; // In the Retrieve policy method it has been defined that only one policy per symmptom is possible
	traceln("Log for RFCList: "+rFCList);
		traceln("Detect Conflict Policy Type: " +rFCList);

	if (policyTypeCount.contains(policyTypes)) {
		agent.rFCConflict = true;
		break;
	}
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864448928</Id>
					<Name><![CDATA[fResolvePolicy]]></Name>
					<X>460</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[HashMap<Integer, Double> highestScoreRecord = new HashMap<Integer, Double>();

for (int i = 0; i < agent.rFCWorkspace.size(); i++) {
	traceln("Content rFCWorkspace: "+agent.rFCWorkspace);
	RFCs rFCList = (RFCs) agent.rFCWorkspace.get(i);
	Integer policyId = (Integer) rFCList.policy_id;
	Integer policyType = (Integer) rFCList.policy_type_id;
	
	if (agent.rFCConflict = true) {
	double score = selectUniqueValue(
			"SELECT policy.score FROM policy WHERE policy.policy_id = ?",
			policyId);
	if (!highestScoreRecord.containsKey(policyType)
			|| highestScoreRecord.get(policyType) < score) {
		highestScoreRecord.put(policyType, score);
	} else {
	}
}
}

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864448930</Id>
					<Name><![CDATA[fGenerateRfc]]></Name>
					<X>460</X><Y>810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
traceln("Agent RFC Workspace: "+agent.rFCWorkspace.size());
for (int i = 0; i < agent.rFCWorkspace.size(); i++) {
	agent.rFCWorkspace.get(i).agent_id = agent.id;
	agent.rFCWorkspace.get(i).status = "New";
	agent.rFCWorkspace.get(i).execution_date = date();
	agent.rFCCounter++;
}
]]></Body>
				</Function>
