					<Name><![CDATA[fLaunchProcess]]></Name>
					<X>90</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//activate image

isActive = true;

/*try {
   pProcess_id =    selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E6");//for each process define the star event here as a variable
  } catch (Exception e) {
    traceln("No process for this start event E6 for agent "+agent.id );
  } 
//   int process_id = pProcess_id.substring(0);  	  

for (int i = 0; i < agent.simulationWorkspace.size(); i++){

// if (agent.simulationWorkspace.get(i).policy_type_id == 1 
// 	&& agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){
 if (agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){
	
	pPolicy_id = agent.simulationWorkspace.get(i).policy_type_id;
	pPolicy_type = agent.simulationWorkspace.get(i).policy_type_id;
	pObject_type = agent.simulationWorkspace.get(i).object_type;
	pAttribute = agent.simulationWorkspace.get(i).attribute;
	pValue = agent.simulationWorkspace.get(i).policy_value;
	return;
   }
 }*/

/*  
   pPolicy_type = selectUniqueValue(//retrieve the policy type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.policy_type_id FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
   
   pObject_type = selectUniqueValue(//retrieve the object type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.object_type FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
		
	pAttribute = selectUniqueValue(//retrieve the attribute from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.attribute FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
		
	pValue = selectUniqueValue(//retrieve the value from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.value FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);		
*/
   ]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1747581493559</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[boolean newEntry = true;

traceln("Execution of the Delivery");
//Sales order simulation
//define agent type of active agent

	String agent_type = selectFirstValue(
			"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
			agent.id);	


//EXECUTION SPACE

for	(int p = 0; p < this.main.cBeerGameResults.size(); p++){
	if (this.main.cBeerGameResults.get(p).agent_id == agent.id
	&& this.main.cBeerGameResults.get(p).t == agent.vCycle_id){
		agent.IO = this.main.cBeerGameResults.get(p).IO;
	}
   }
for (int i = 0; i < agent.executionWorkspace.size(); i++){
	if (agent.executionWorkspace.get(i).status.equals("Active")){
		if (agent.executionWorkspace.get(i).start_event.equals("E4")){
		
			if (agent.executionWorkspace.get(i).attribute.equals("st")){
				vst = agent.executionWorkspace.get(i).value;
	 		 } else {
	  	traceln("No parameter is relevant for execution");
	}
	
if (agent.vCycle_id == 0){
	traceln("Initialization");
/*	if 	(agent_type.equals("AT2")){//for the retailer
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT3")){//for the wholesaler
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT4")){//for the distributor		
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT5")){//for the producer
		traceln("No initialization to be done");
	}	*/	
	
} else {

// calculate the shipment quantity -> specifiy this also for the orders
	if 	(agent_type.equals("AT2")){//for the retailer
	
		if (agent.I <= ( agent.B + agent.ENDCD )){//
			agent.S = agent.I;//[33}] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
			agent.S = ( agent.B + agent.ENDCD );//[33] When there is enough inventory, send over the full backlog and demand
		}
			agent.B = agent.B +( agent.ENDCD - agent.S);//[39] backlog after sending the shipment	
			agent.I = agent.I - agent.S;//[43] substratct the delivery from the stock
//			agent.IO = 0;//set the incoming orders to 0
        	agent.executionWorkspace.get(i).status = "Processed";
		
			for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
				if (this.main.cBeerGameResults.get(k).agent_type.equals("AT2")
					&& this.main.cBeerGameResults.get(k).t == (agent.vCycle_id)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT1")){//CHECK: when multiple ageents are allowed per echelon this must be changed
//							this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
							this.main.subject.get(l).ITI1 = agent.S;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
							}
						}
      }
     }				
	} else if (agent_type.equals("AT3")){//for the wholesaler
	
			if (agent.I <= ( agent.B + agent.IO )){
				agent.S = agent.I;//[34} When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S = ( agent.B + agent.IO );//34] When there is enough inventory, send over the full backlog and demand
		}
		agent.B = agent.B +( agent.IO - agent.S);//[40] backlog after sending the shipment	
		agent.I = agent.I - agent.S;//[44] substratct the delivery from the stock
//		agent.IO = 0;//set the incoming orders to 0
		agent.executionWorkspace.get(i).status = "Processed";		
		
			for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
				if (this.main.cBeerGameResults.get(k).agent_type.equals("AT3")
					&& this.main.cBeerGameResults.get(k).t == (agent.vCycle_id)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT2")){//CHECK: when multiple ageents are allowed per echelon this must be changed
//							this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
							this.main.subject.get(l).ITI1 = agent.S;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported						
							}
						}

		}
	}
						
	} else if (agent_type.equals("AT4")){//for the distributor
	
		if (agent.I <= ( agent.B + agent.IO )){
				agent.S = agent.I;//[35] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S = ( agent.B + agent.IO );//[35] When there is enough inventory, send over the full backlog and demand
		}
		agent.B = agent.B +( agent.IO - agent.S);//[41] backlog after sending the shipment		
		agent.I = agent.I - agent.S;//[45] substratct the delivery from the stock
//		agent.IO = 0;//set the incoming orders to 0
        agent.executionWorkspace.get(i).status = "Processed";		
		
			for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
				if (this.main.cBeerGameResults.get(k).agent_type.equals("AT4")
					&& this.main.cBeerGameResults.get(k).t == (agent.vCycle_id)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT3") ){//CHECK: when multiple ageents are allowed per echelon this must be changed
//							this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
							this.main.subject.get(l).ITI1 = agent.S;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
							}
						}

      }
    }				
	} else if (agent_type.equals("AT5")){//for the manufacturer
			if (agent.I <= ( agent.B + agent.IO)){
				agent.S = agent.I;//[36] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S = ( agent.B + agent.IO );//[36] When there is enough inventory, send over the full backlog and demand
		}
//		agent.WIPI1 = agent.PSR; //[38] -> moved to produce goods
		agent.B = agent.B +( agent.IO - agent.S);//[42] backlog after sending the shipment		
		agent.I = agent.I - agent.S;//[46] substratct the delivery from the stock
//		agent.IO = 0;//set the incoming orders to 0
        agent.executionWorkspace.get(i).status = "Processed";
        
		for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
			if (this.main.cBeerGameResults.get(k).agent_type.equals("AT5")
				&& this.main.cBeerGameResults.get(k).t == (agent.vCycle_id)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
				for (int l = 0; l < this.main.subject.size();l++){
					if (this.main.subject.get(l).active == true
						&& this.main.subject.get(l).type.equals("AT4")){//CHECK: when multiple ageents are allowed per echelon this must be changed
//						this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
						this.main.subject.get(l).ITI1 = agent.S;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
						}
					}

      }
    }				
	}	
   } 
  }//end of assigned
// agent.executionWorkspace.get(i).status = "Processed";

//add ITI1 of next agent to results for this cycle

for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
		if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 			&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
			this.main.cBeerGameResults.get(k).ITI1 = agent.ITI1;//write the ITI1 to the results table
			newEntry = false;			
		}			
	}

/*for(int k = 0; k < this.main.cBeerGameResults.size(); k++){
	if (agent.type.equals("AT5")){
		if (this.main.cBeerGameResults.get(k).agent_type.equals("AT4")
 			&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
			this.main.cBeerGameResults.get(k).ITI1 = agent.S;//write the ITI1 to the results table
			newEntry = false;			
						
			}
	} else if (agent.type.equals("AT4")){	
		if (this.main.cBeerGameResults.get(k).agent_type.equals("AT3")
 			&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
			this.main.cBeerGameResults.get(k).ITI1 = agent.S;//write the ITI1 to the results table
			newEntry = false;	
			}
	} else if (agent.type.equals("AT3")){	
		if (this.main.cBeerGameResults.get(k).agent_type.equals("AT2")
 			&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
			this.main.cBeerGameResults.get(k).ITI1 = agent.S;//write the ITI1 to the results table
			newEntry = false;	
			}
	} else if (agent.type.equals("AT2")){	
		if (this.main.cBeerGameResults.get(k).agent_type.equals("AT1")
 			&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
			this.main.cBeerGameResults.get(k).ITI1 = agent.S;//write the ITI1 to the results table
			newEntry = false;	
			}
	} else {
		traceln("No ITI1 can be stored");
		newEntry = true;
	}
 }*/
 
boolean addRecord = true;

 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){  

  		addRecord = false;
  	}
  } 
 
 
 if (newEntry == true){
 	if (agent.type.equals("AT5")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT4")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameResults.size();j++){
   						 if (this.main.cBeerGameResults.get(j).agent_type.equals("AT4")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameResults.get(j).t == agent.vCycle_id){  
   							this.main.cBeerGameResults.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameResults.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameResults.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameResults.get(j).t = agent.vCycle_id;
							this.main.cBeerGameResults.get(j).ITI1 = agent.ITI1;
							this.main.cBeerGameResults.get(j).Status = "ITI1 Added";
   						}
   					}
				} else {
	   		   			BeerGame_Results  newRecord = new BeerGame_Results();
						newRecord.agent_id = this.main.subject.get(k).id;
						newRecord.agent_type = this.main.subject.get(k).type;
						newRecord.i = this.main.subject.get(k).id; 	
   						newRecord.t = agent.vCycle_id;
   						newRecord.ITI1 = agent.ITI1;
						newRecord.Status = "ITI1 Added";
						if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
						}
   						this.main.cBeerGameResults.add(newRecord);
   				}
   				}
   			}				
 		
 	} else if (agent.type.equals("AT4")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT3")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameResults.size();j++){
   						 if (this.main.cBeerGameResults.get(j).agent_type.equals("AT3")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameResults.get(j).t == agent.vCycle_id){ 
   							this.main.cBeerGameResults.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameResults.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameResults.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameResults.get(j).t = agent.vCycle_id;
							this.main.cBeerGameResults.get(j).ITI1 = agent.ITI1;
							this.main.cBeerGameResults.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vCycle_id;
   					newRecord.ITI1 = agent.ITI1;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
					newRecord.Sim_id = vSim_id.toString();
					}
   					this.main.cBeerGameResults.add(newRecord);
   				}
   				}
   			}	
 	} else if (agent.type.equals("AT3")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT2")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameResults.size();j++){
   						 if (this.main.cBeerGameResults.get(j).agent_type.equals("AT2")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameResults.get(j).t == agent.vCycle_id){ 
   							this.main.cBeerGameResults.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameResults.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameResults.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameResults.get(j).t = agent.vCycle_id;
							this.main.cBeerGameResults.get(j).ITI1 = agent.ITI1;
							this.main.cBeerGameResults.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vCycle_id;
   					newRecord.ITI1 = agent.ITI1;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
					}					
   					this.main.cBeerGameResults.add(newRecord);
   				}
   				}
   			}	
 	} else if (agent.type.equals("AT2")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT1")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameResults.size();j++){
   						 if (this.main.cBeerGameResults.get(j).agent_type.equals("AT1")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameResults.get(j).t == agent.vCycle_id){ 
   							this.main.cBeerGameResults.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameResults.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameResults.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameResults.get(j).t = agent.vCycle_id;
							this.main.cBeerGameResults.get(j).ITI1 = agent.ITI1;
							this.main.cBeerGameResults.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vCycle_id;
   					newRecord.ITI1 = agent.ITI1;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
					}					
   					this.main.cBeerGameResults.add(newRecord);
   				}
   				}
   			}		 		
	} else {
		traceln("No records to be added");
	}
 }
	
 //add the result to the results collection
 
 for (int k = 0 ; k < this.main.cBeerGameResults.size();k++){
 
 if (this.main.cBeerGameResults.get(k).agent_id.equals(agent.id)
 	&&this.main.cBeerGameResults.get(k).t == agent.vCycle_id){
		this.main.cBeerGameResults.get(k).st = agent.vst;
 		this.main.cBeerGameResults.get(k).S = agent.S;
// 		this.main.cBeerGameResults.get(k).ITI1 = agent.ITI1;
 		this.main.cBeerGameResults.get(k).B = agent.B;
// 		this.main.cBeerGameResults.get(k).I = agent.I; //was already registered in previous cycle
// 		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
 		this.main.cBeerGameResults.get(k).Status = "Delivered";
 	} else{
 		traceln("No results to be processed");
 	}	
  }// end of result processing
  }	
 }//end of execution loop
//end of execution workspace]]></Body>
