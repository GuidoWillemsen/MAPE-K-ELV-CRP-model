				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864073100</Id>
					<Name><![CDATA[fReceiveRfc]]></Name>
					<X>480</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Receive RFC RFC Workspace: "+agent.rFCWorkspace);
for (int i = 0; i < agent.rFCWorkspace.size(); i++) {
	agent.rFCWorkspace.get(i).status = "Planning";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864073103</Id>
					<Name><![CDATA[fEmployPolicy]]></Name>
					<X>480</X><Y>720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[String selected_policy_name = "";
String selected_script = "";
String selected_object_type = "";
String selected_attribute = "";
Double selected_value = 0.0;
Double selected_score = 0.0;
Double selected_expected_result = 0.0;
String selected_source = "";
Integer selected_version = 0;
Integer selected_change_pointer = 0;

for (int i = 0; i < agent.rFCWorkspace.size(); i++) {
	if (agent.rFCWorkspace.get(i).status == "Planning") {


	Integer policyId = (Integer) agent.rFCWorkspace.get(i).policy_id;

//select missing value in RFC Workspace from Policy table
try {
	selected_policy_name = selectUniqueValue(
			"SELECT policy.policy_name FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId,"Active");
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.policy_name FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_script = selectUniqueValue(
			"SELECT policy.script FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.script FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}			
try {
	selected_object_type = selectUniqueValue(
			"SELECT policy.object_type FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.object_type FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}

try {
	selected_attribute = selectUniqueValue(
			"SELECT policy.attribute FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.attribute FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_value = selectUniqueValue(
			"SELECT policy.policy_value FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.policy_value FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_score = selectUniqueValue(
			"SELECT policy.score FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.score FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_expected_result = selectUniqueValue(
			"SELECT policy.expected_result FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.expected_result FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_source = selectUniqueValue(
			"SELECT policy.source FROM policy WHERE policy.policy_id = ?", policyId);
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.source FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_version = selectUniqueValue(
			"SELECT policy.version FROM policy WHERE policy.policy_id = ?", policyId);			
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.version FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}
try {
	selected_change_pointer = selectUniqueValue(
			"SELECT policy.change_pointer FROM policy WHERE policy.policy_id = ?", policyId);			
    } catch (Exception e) {
 			selected_policy_name = selectUniqueValue(
				"SELECT policy.change_pointer FROM policy WHERE policy.policy_id = ? AND policy.status = ?", policyId, "Inactive");   	
			traceln("The inactive policy is selected as a fall back");
	}

// Write the selected missing policy values to the RFC Workspace

	agent.rFCWorkspace.get(i).policy_name = selected_policy_name;
	agent.rFCWorkspace.get(i).script = selected_script;
	agent.rFCWorkspace.get(i).object_type = selected_object_type;
	agent.rFCWorkspace.get(i).attribute = selected_attribute;
	agent.rFCWorkspace.get(i).policy_value = selected_value;
	agent.rFCWorkspace.get(i).score = selected_score;
	agent.rFCWorkspace.get(i).expected_result = selected_expected_result;
	agent.rFCWorkspace.get(i).source = selected_source;
	agent.rFCWorkspace.get(i).version = selected_version;
	agent.rFCWorkspace.get(i).change_pointer= selected_change_pointer;

	}
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864073105</Id>
					<Name><![CDATA[fGenerateActionPlan]]></Name>
					<X>480</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Agent RFC Workspace: "+agent.rFCWorkspace);
//sort RFC WOrkspace based on policy type and then only keep the records with the highest score for each policy type
double selectedScore = 0.0;
int selectedPolicyType = 0;

List sortedByTypeDesc = sortDescending( agent.rFCWorkspace, p -> p.policy_type_id );

Iterator<RFCs> iterator = agent.rFCWorkspace.iterator();

while (iterator.hasNext()) {
    RFCs r = iterator.next();
    if ("Planning".equals(r.status)) { // Use .equals() for string comparison
        if (r.policy_type_id != selectedPolicyType) {
            selectedPolicyType = r.policy_type_id;
            if (r.score < selectedScore) {
                traceln("Test " + r);
                iterator.remove(); // Use iterator to safely remove
            } else {
                selectedScore = r.score;
            }
        }
    }
    r.status = "Completed";
}



for (int i = 0; i < agent.rFCWorkspace.size(); i++) {


agent.planWorkspace.add(agent.rFCWorkspace.get(i));
agent.planWorkspace.get(i).status = "New";

}

int vGuido = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1757685865619</Id>
					<Name><![CDATA[fOrchestrateExecution]]></Name>
					<X>480</X><Y>630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[ main.e_out.take(agent);

/*boolean learn = false;

if (agent.confChanged.size() > 0 
	&& main.ELV_Activated.isSelected()){
	agent.vLearn = true;
} else {

traceln("Start of checkNegativeOutcome");
Random rand = new Random();
int random_number = rand.nextInt(agent.vLearning_Sensitivity);//when distributed equally, change of x% on learning

if (random_number == 1  && main.ELV_Activated.isSelected() ){
	agent.vLearn = true;
 } 
}
//decide if ELV has to be triggered first, otherwise continue with exeution

boolean decision = agent.vLearn; // Capture the condition early
if (decision) {
//	fHold(agent);
    main.e_out.take(agent);
} else {
    main.p_out.take(agent);
}


if (vLearn == true){ //trigger of the ELV cycle
	main.e_out.take(agent);
} else {
main.p_out.take(agent);
}*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758050449791</Id>
					<Name><![CDATA[fCheckELV]]></Name>
					<X>480</X><Y>590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//boolean learn = false;

//if (agent.confChanged.size() > 0 
//	&& main.ELV_Activated.isSelected()
if (main.ELV_Activated.isSelected()
	&& main.vLearningCompleted == false){//this indicator is false when learning is required. When true, the learning cycle already has been executed
	agent.vLearn = true;
} else {

main.vLearningCompleted = false; // reset parameter

traceln("Start of checkNegativeOutcome");
Random rand = new Random();
int random_number = rand.nextInt(agent.learningsensitivity);//when distributed equally, change of x% on learning

if (random_number == 1  && main.ELV_Activated.isSelected() ){
	agent.vLearn = true;
 } 
}]]></Body>
				</Function>
