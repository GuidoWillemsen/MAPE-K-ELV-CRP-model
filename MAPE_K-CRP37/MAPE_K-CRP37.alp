		<JavaClass>
			<Id>1762375786441</Id>
			<Name><![CDATA[Policy]]></Name>
			<Text><![CDATA[/**
 * Policy
 */
public class Policy implements Serializable {
    int policy_id;
    boolean default_policy;
    String policy_name;
    String agent_id;
    int policy_type_id;
    String script;
    String object_type;
    String attribute;
    double policy_value;
    double previous_policy_value;
    int higher_level_policy_id;
    double score;
    double expected_result;
    String optimization_indicator;
    String source;
    String status;
    int version;
    int change_pointer;
    double actual_result;
    double simulated_result;
    String learning_method;

    /**
     * Default constructor
     */
    public Policy() {
    }

    /**
     * Constructor initializing the fields
     */
    public Policy(int policy_id, boolean default_policy, String policy_name, String agent_id, int policy_type_id, String script, String object_type, String attribute, double policy_value, double previous_policy_value, int higher_level_policy_id, double score, double expected_result, String optimization_indicator, String source, String status, int version, int change_pointer, double actual_result, double simulated_result, String learning_method) {
        this.policy_id = policy_id;
        this.default_policy = default_policy;
        this.policy_name = policy_name;
        this.agent_id = agent_id;
        this.policy_type_id = policy_type_id;
        this.script = script;
        this.object_type = object_type;
        this.attribute = attribute;
        this.policy_value = policy_value;
        this.previous_policy_value = previous_policy_value;
        this.higher_level_policy_id = higher_level_policy_id;
        this.score = score;
        this.expected_result = expected_result;
        this.optimization_indicator = optimization_indicator;
        this.source = source;
        this.status = status;
        this.version = version;
        this.change_pointer = change_pointer;
        this.actual_result = actual_result;
        this.simulated_result = simulated_result;
        this.learning_method = learning_method;
    }

    // Getters and Setters
    public int getPolicy_id() {
        return policy_id;
    }

    public void setPolicy_id(int policy_id) {
        this.policy_id = policy_id;
    }

    public boolean isDefault_policy() {
        return default_policy;
    }

    public void setDefault_policy(boolean default_policy) {
        this.default_policy = default_policy;
    }

    public String getPolicy_name() {
        return policy_name;
    }

    public void setPolicy_name(String policy_name) {
        this.policy_name = policy_name;
    }

    public String getAgent_id() {
        return agent_id;
    }

    public void setAgent_id(String agent_id) {
        this.agent_id = agent_id;
    }

    public int getPolicy_type_id() {
        return policy_type_id;
    }

    public void setPolicy_type_id(int policy_type_id) {
        this.policy_type_id = policy_type_id;
    }

    public String getScript() {
        return script;
    }

    public void setScript(String script) {
        this.script = script;
    }

    public String getObject_type() {
        return object_type;
    }

    public void setObject_type(String object_type) {
        this.object_type = object_type;
    }

    public String getAttribute() {
        return attribute;
    }

    public void setAttribute(String attribute) {
        this.attribute = attribute;
    }

    public double getPolicy_value() {
        return policy_value;
    }

    public void setPolicy_value(double policy_value) {
        this.policy_value = policy_value;
    }

    public double getPrevious_policy_value() {
        return previous_policy_value;
    }

    public void setPrevious_policy_value(double previous_policy_value) {
        this.previous_policy_value = previous_policy_value;
    }

    public int getHigher_level_policy_id() {
        return higher_level_policy_id;
    }

    public void setHigher_level_policy_id(int higher_level_policy_id) {
        this.higher_level_policy_id = higher_level_policy_id;
    }

    public double getScore() {
        return score;
    }

    public void setScore(double score) {
        this.score = score;
    }

    public double getExpected_result() {
        return expected_result;
    }

    public void setExpected_result(double expected_result) {
        this.expected_result = expected_result;
    }

    public String getOptimization_indicator() {
        return optimization_indicator;
    }

    public void setOptimization_indicator(String optimization_indicator) {
        this.optimization_indicator = optimization_indicator;
    }

    public String getSource() {
        return source;
    }

    public void setSource(String source) {
        this.source = source;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public int getVersion() {
        return version;
    }

    public void setVersion(int version) {
        this.version = version;
    }

    public int getChange_pointer() {
        return change_pointer;
    }

    public void setChange_pointer(int change_pointer) {
        this.change_pointer = change_pointer;
    }

    public double getActual_result() {
        return actual_result;
    }

    public void setActual_result(double actual_result) {
        this.actual_result = actual_result;
    }

    public double getSimulated_result() {
        return simulated_result;
    }

    public void setSimulated_result(double simulated_result) {
        this.simulated_result = simulated_result;
    }

    public String getLearning_method() {
        return learning_method;
    }

    public void setLearning_method(String learning_method) {
        this.learning_method = learning_method;
    }

    @Override
    public String toString() {
        return
            "policy_id = " + policy_id +" " +
            "default_policy = " + default_policy +" " +
            "policy_name = " + policy_name +" " +
            "agent_id = " + agent_id +" " +
            "policy_type_id = " + policy_type_id +" " +
            "script = " + script +" " +
            "object_type = " + object_type +" " +
            "attribute = " + attribute +" " +
            "policy_value = " + policy_value +" " +
            "previous_policy_value = " + previous_policy_value +" " +
            "higher_level_policy_id = " + higher_level_policy_id +" " +
            "score = " + score +" " +
            "expected_result = " + expected_result +" " +
            "optimization_indicator = " + optimization_indicator +" " +
            "source = " + source +" " +
            "status = " + status +" " +
            "version = " + version +" " +
            "change_pointer = " + change_pointer +" " +
            "actual_result = " + actual_result +" " +
            "simulated_result = " + simulated_result +" " +
            "learning_method = " + learning_method +" ";
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */
    private static final long serialVersionUID = 1L;
}


]]></Text>
		</JavaClass>
