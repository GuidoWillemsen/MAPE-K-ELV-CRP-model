			agent.id, policy_id);
			
			String role = selectFirstValue(
			"SELECT process_repository.role FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ?", 
			agent.id, policy_id);
		
			String event_type = selectFirstValue(
			"SELECT process_repository.event_type FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ?", 
			agent.id, policy_id);
			
			Double expected_result = selectFirstValue(
			"SELECT policy.expected_result FROM policy WHERE policy.policy_id = ? ", 
			policy_id);
				
		
			String status = "New";			
			
			Execution new_process = new Execution(
						process_id,
						process_name,
						process_type,
						role,
						"E10",
						"E11",
						event_type,
						policy_id,
						0,
						"",
						"",
						"",
						0.0,
						"",
						expected_result,
						date(),
						status);
						
			agent.executionWorkspace.add(new_process);
		}
	}
																																																		]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1749723752892</Id>
					<Name><![CDATA[fDispatchAction]]></Name>
					<X>430</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
int j = agent.ei;
int k = agent.ei;
int z = 0;//when 9, there is no record found
//sort execution workspace

Comparator<Execution> eventSorting = new Comparator<Execution>() {
    @Override
     public int compare(Execution e1, Execution e2) {
//    	int instanceComparison = int.compare(e1.getStart_Event(), e2.getStart_Event());
		int instanceComparison = e1.getStart_Event().compareTo(e2.getStart_Event());
        if (instanceComparison != 0) {
        	
        return instanceComparison;
    }
// If start events are equal, compare policy
        int policyComparison = Integer.compare(e1.getPolicy(), e2.getPolicy());
        if (policyComparison != 0) {
            return policyComparison;
        }
    
		return 0;
	  }
	};

// Sort the list using the comparator
	agent.executionWorkspace.sort(eventSorting);




for (int i = 0; i < agent.executionWorkspace.size(); i++){//first loop over the collection to activate all relevant records
	if (agent.executionWorkspace.get(i).status.equals("New")
	&& agent.executionWorkspace.get(i).start_event == agent.executionWorkspace.get(agent.ei).start_event){
		if (agent.executionWorkspace.get(agent.ei).start_event.equals("E1")){
		 		 agent.executionWorkspace.get(i).status = "Active";	
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E2")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E3")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E4")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E5")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E6")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else if (agent.executionWorkspace.get(agent.ei).start_event.equals("E10")){
		 agent.executionWorkspace.get(i).status = "Active";
	} else {
	traceln("No process found to be executed");
   }		
 }
}



if (agent.executionWorkspace.get(k).status == ("Active")){
	if (agent.executionWorkspace.get(k).start_event.equals("E1")){				
		main.bg_RegisterSalesOrder.E1.take(agent);
		
	} else if (agent.executionWorkspace.get(k).start_event.equals("E2")){
		main.bg_ReceiveGoods.E2.take(agent);
		
	} else if (agent.executionWorkspace.get(k).start_event.equals("E3")){				
		main.bg_ProduceGoods.E3.take(agent);
	} else if (agent.executionWorkspace.get(k).start_event.equals("E4")){				
		main.bg_DeliverGoods.E4.take(agent);
	} else if (agent.executionWorkspace.get(k).start_event.equals("E5")){				
		main.bg_CalculateStock.E5.take(agent);
	} else if (agent.executionWorkspace.get(k).start_event.equals("E6")){				
		main.bg_CreatePurchaseOrder.E6.take(agent);
	} else if (agent.executionWorkspace.get(k).start_event.equals("E10")){				
		main.bg_CalculatePrice.E10.take(agent);
	} else {
		traceln("No Process to be executed");
		z = 9;//no process to be executed
	}
} else {
		traceln("No process is active");
		z = 9;//no process to be executed
}

if (z == 9){
	agent.ei++;
	next_Execution.take(agent);
	}]]></Body>
				</Function>
