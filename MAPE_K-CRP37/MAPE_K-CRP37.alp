	String process_agent = selectFirstValue(
			"SELECT process_repository.agent_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ?", 
			agent.id, agent.planWorkspace.get(i).higher_level_policy_id);	
try {			
		process_active = selectFirstValue(
			"SELECT process_repository.in_scope FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.policy_id = ? AND process_repository.in_scope = ?", 
			agent.id, agent.planWorkspace.get(i).higher_level_policy_id, true);					
    } catch (Exception e) {
    	process_active = false;
    }

	if (process_agent == agent.id && process_active == true){

	if (agent.planWorkspace.get(i).policy_type_id == 1){
		
				
			int process_id = agent.planWorkspace.get(i).higher_level_policy_id;
				
