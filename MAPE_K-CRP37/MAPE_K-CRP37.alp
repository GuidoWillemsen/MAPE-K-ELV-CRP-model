		<JavaClass>
			<Id>1745261386563</Id>
			<Name><![CDATA[trustgroup]]></Name>
			<Text><![CDATA[/**
 * trustgroup
 */	
public class trustgroup implements Serializable {

	public int trustgroup_id = 0;

	public String agent_id = "";

    /**
     * Default constructor
     */
    public trustgroup() {
    }

    /**
     * Constructor initializing the fields
     */
    public trustgroup(int trustgroup_id, String agent_id) {
		this.trustgroup_id = trustgroup_id;
		this.agent_id = agent_id;
    }


    // Getter for trustgroup_id
    public int getTrustgroup_id() {
        return trustgroup_id;
    }

    // Setter for trustgroup_id
    public void setTrustgroup_id(int trustgroup_id) {
        this.trustgroup_id = trustgroup_id;
    }

    // Getter for agent_id
    public String getAgent_id() {
        return agent_id;
    }

    // Setter for agent_id
    public void setAgent_id(String agent_id) {
        this.agent_id = agent_id;
    }
    
	@Override
	public String toString() {
