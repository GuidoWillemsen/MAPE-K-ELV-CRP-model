			agent.simulationWorkspace.get(ei).policy_value = pValue;//write the new value to the active value
			
	
			traceln("Sales is not configured in this beer game");
	} else {
 		traceln("Policy "+pPolicy_id+"is not relevant for execution");
	}
	agent.simulationWorkspace.get(ei).status = "Processed";
 } catch (Exception e) {
        // Handle any exceptions that may occur during the workspace processing
        traceln("No simulation record found");
 }*/	

//} else { 


//start execution space

//			agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase

agent.ENDCD_sim = 0;//initialize the ENDCD value for this new cycle
//retrieve current order book
if (vSim_id == null){
	agent.simulationWorkspace.get(agent.si).status = "Processed";	
}
	agent.IO_sim = 0;//reset IO
	agent.ENDCD_sim = 0;//reset ENDCD
//for first cycle
if (agent.vN == 0){
	traceln("Initialization");
	
	agent.IO_sim = main.pStartOrderQty;//4;	
	
for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 

 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&& (this.main.cBeerGameSim.get(k).t == agent.vN
 	||this.main.cBeerGameSim.get(k).t == agent.vN+1)){
	
	this.main.cBeerGameSim.get(k).agent_id = main.validate.vSimAgent;
	this.main.cBeerGameSim.get(k).agent_type = main.validate.vSimAgentType;
	this.main.cBeerGameSim.get(k).i = main.validate.vSimAgent;
	this.main.cBeerGameSim.get(k).t = agent.vN;
	this.main.cBeerGameSim.get(k).IO = agent.IO_sim;	
	this.main.cBeerGameSim.get(k).Status = "Processed";
	existingResult = true;
 }
}	

if (!existingResult == true){
	 BeerGame_Results new_result = new BeerGame_Results();
	 new_result.agent_id = main.validate.vSimAgent;
	 new_result.agent_type = main.validate.vSimAgentType;
	 new_result.i = main.validate.vSimAgent; //changed from agent type
	 new_result.t = agent.vN;
//	 new_result.order_id = this.main.Orders.get(j).Order_id;
	 new_result.IO = agent.IO_sim;
	 new_result.Status = "Processed";//To be processed
	 if (vSim_id != null) {
		new_result.Sim_id = vSim_id.toString();
		}	
	this.main.cBeerGameSim.add(new_result);
	}
  		
	} else if (agent.vN == 1) {	
	  agent.IO_sim = main.pStartOrderQty;//4;
	  agent.ENDCD_sim = agent.IO_sim;
	  newResult = true;		
	} else {// cycle > 1


	

//sort the this.main.Orders collection   
this.main.SimOrders.sort(new Comparator<Order>() {
    @Override
    public int compare(Order o1, Order o2) {
        // First compare by Cycle_id
        int cycleCompare = Integer.compare(o1.Cycle_id, o2.Cycle_id);
        if (cycleCompare != 0) {
            return cycleCompare;
        }   
        // If Cycle_id is the same, compare by Agent_type
        return o1.Agent_type.compareTo(o2.Agent_type);
    }
});   

for (int j = 0; j < this.main.SimOrders.size();j++){// only for the retailer ENDCD

	if (this.main.SimOrders.get(j).Partner == null
		&& this.main.SimOrders.get(j).Cycle_id == (agent.vN)//CHANGE to 0 retrieve the order from the previous cycle
		&& agent.vN > 1){
		
		//assign the order to te active agent
		if (this.main.SimOrders.get(j).Agent_type.equals("AT1")
			&&agent.type.equals("AT2")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//customer orders for retailer 
			this.main.SimOrders.get(j).Partner = main.validate.vSimAgent;
			agent.ENDCD_sim = (int) Math.ceil(agent.ENDCD_sim + this.main.SimOrders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			this.main.SimOrders.get(j).Status = "Assigned";
			newResult = true;
		}
	}
}

   	
for (int j = 0; j < this.main.SimOrders.size();j++){

	if (this.main.SimOrders.get(j).Partner == null
		&& this.main.SimOrders.get(j).Cycle_id == (agent.vN)-1//CHANGE to -1 retrieve the order from the previous cycle
		&& agent.vN > 1){
		
		//assign the order to te active agent
		if (this.main.SimOrders.get(j).Agent_type.equals("AT1")
			&&main.validate.vSimAgentType.equals("AT2")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//customer orders for retailer 
			this.main.SimOrders.get(j).Partner = main.validate.vSimAgent;
//			agent.ENDCD = (int) Math.ceil(agent.ENDCD + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			this.main.SimOrders.get(j).Status = "Assigned";
			newResult = true;
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT2")
			&&main.validate.vSimAgentType.equals("AT3")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//retailer orders for wholesaler	
			this.main.SimOrders.get(j).Partner = main.validate.vSimAgent;
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);
			this.main.SimOrders.get(j).Status = "Assigned";
			newResult = true;							
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT3")
			&&main.validate.vSimAgentType.equals("AT4")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//wholesaler orders for distributor	
			this.main.SimOrders.get(j).Partner = main.validate.vSimAgent;
			agent.IO_sim = (int) Math.ceil (agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[51]add order to Incoming Orders 
			this.main.SimOrders.get(j).Status = "Assigned";
			newResult = true;				
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT4")
			&&main.validate.vSimAgentType.equals("AT5")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//distributor orders for manufacturer	
			this.main.SimOrders.get(j).Partner = main.validate.vSimAgent;
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[52]add order to Incoming Orders 
			this.main.SimOrders.get(j).Status = "Assigned";
			newResult = true;
		}		
	} else if (this.main.SimOrders.get(j).Partner != null
		&& this.main.SimOrders.get(j).Cycle_id == (agent.vN)//retrieve the order from the previous cycle
		&& agent.vN > 1){
		
		//assign the order to te active agent
		if (this.main.SimOrders.get(j).Agent_type.equals("AT1")
			&&main.validate.vSimAgentType.equals("AT2")){
//			agent.ENDCD = (int) Math.ceil(agent.ENDCD + this.main.Orders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[] for the retailer the IO is defined as ENDCD
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT2")
			&&main.validate.vSimAgentType.equals("AT3")){
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT3")
			&&main.validate.vSimAgentType.equals("AT4")){
			agent.IO_sim = (int) Math.ceil (agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[51]add order to Incoming Orders 
		} else if (this.main.SimOrders.get(j).Agent_type.equals("AT4")
			&&main.validate.vSimAgentType.equals("AT5")){
//			&&this.main.Orders.get(j).Cycle_id == agent.vCycle_id+1){//distributor orders for manufacturer	
			agent.IO_sim = (int) Math.ceil(agent.IO_sim + this.main.SimOrders.get(j).Quantity);//[52]add order to Incoming Orders 
	 	}
	  } else {
	traceln("No orders in the supply chain");
		 }
   		}
 }

//}

 //for the factory only as they don't receive goods in the regular process
		if (agent.type.equals("AT5")){
			
 			for (int m = 0 ; m < this.main.cBeerGameSim.size();m++){
 				if ( this.main.cBeerGameSim.get(m).agent_id == main.validate.vSimAgent
 					&& this.main.cBeerGameSim.get(m).t == (agent.vN-1)){
// 					agent.WIPI2 = this.main.cBeerGameResults.get(m).WIPI1;//[30]
 					agent.WIPI2_sim = this.main.cBeerGameSim.get(m).WIPI1;//[30]
 					WIPI2 = this.main.cBeerGameSim.get(m).WIPI2;
 					}			
				}	
				agent.I_sim = agent.I_sim + WIPI2;//[28]
				agent.WIPI1_sim = 0;//[32] after delivery WIPI becomes empty-> Consider to this after delivery
				newResult = true;
	}
// add record to Beer Game results 	

//if (newResult == true
//	&& !agent.type.equals("AT1")
//	&& agent.vCycle_id > 0){//create record for this agent in this cycle ->removed as it always should create a record expect for the first cycle

	//add the shipment to the results table of the current cycle
if (newResult == true){
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 

 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&& (this.main.cBeerGameSim.get(k).t == agent.vN)){
 	this.main.cBeerGameSim.get(k).S = agent.S_sim;
 	this.main.cBeerGameSim.get(k).WIPI2 = agent.WIPI2_sim;
// 	this.main.cBeerGameResults.get(k).ENDCD = agent.ENDCD;
 	this.main.cBeerGameSim.get(k).Status = "Processed";
 	existingResult = true;
	}
}
}

if (newResult == true
	&& !existingResult == true){
	 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){	
	
 	if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 			&& !existingResult == true){
 	 			if (this.main.cBeerGameSim.get(k).t == agent.vN){
 	
				traceln("No action required");
				} else {
				addResult = true;	

    	 }	
		}
 	 }

if (addResult == true){  
  	BeerGame_Results new_result = new BeerGame_Results();
	 new_result.agent_id = main.validate.vSimAgent;
	 new_result.agent_type = main.validate.vSimAgentType;
	 new_result.i = main.validate.vSimAgent;//CHANGED from agent.type to agent.id
	 new_result.t = agent.vN;
//	 new_result.order_id = this.main.Orders.get(j).Order_id;
//	 new_result.order_id = agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order only relevant for purchase
//	 new_result.IO = agent.IO;
	 new_result.S = agent.S_sim;
	 new_result.WIPI2 = agent.WIPI2_sim;
	 new_result.ENDCD = agent.ENDCD_sim;
	if (vSim_id != null) {
		new_result.Sim_id = vSim_id.toString();
		}	
	 new_result.Status = "Processed";//To be processed
		
	this.main.cBeerGameSim.add(new_result);
//	newResult = false;//reset newResult
  }	  
 traceln("New record added to cBeerGameResults"); 
//}
}

//reset
existingResult = false;
addResult = false;

//for the first cycle the data should be added to cycle 0
if (agent.vN == 0){
	if (newResult = true){
	
//for the initial cycle	
		 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 

 		if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 			&& (this.main.cBeerGameSim.get(k).t == agent.vN)){
 			this.main.cBeerGameSim.get(k).order_id = agent.order_id_sim;
			this.main.cBeerGameSim.get(k).IO = 0;//only for the initiation
			this.main.cBeerGameSim.get(k).ENDCD = 0;//only for the initiation
 			this.main.cBeerGameSim.get(k).Status = "Processed";
		}
		}
// for the first cycle
		 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 

 		if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 			&& (this.main.cBeerGameSim.get(k).t == agent.vN+1)){//CHANGE was 0
 			this.main.cBeerGameSim.get(k).order_id = agent.order_id_sim;
			this.main.cBeerGameSim.get(k).IO = main.pStartOrderQty;//4;//only for the first cycle
			this.main.cBeerGameSim.get(k).ENDCD = main.pStartOrderQty;//4;//only for the first cycle
 			this.main.cBeerGameSim.get(k).Status = "Processed";
 			existingResult = true;
		}
		}		
		
		}

	if (newResult == true
		&& !existingResult == true){
		 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){	
	
 		if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
