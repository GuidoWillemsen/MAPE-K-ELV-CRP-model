					<Body><![CDATA[agent.vplt = 0.0;


boolean newResult = false;

traceln("Execution of the Production Order");
//Sales order simulation
//if (vSim_id != null){//simulation space

	if (agent.simulationWorkspace.get(agent.si).object_type.equals("PROD")){// Process types are not included in this model yet


//			agent.simulationWorkspace.get(ei).previous_policy_value = agent.simulationWorkspace.get(ei).policy_value;//write the current value to the previous value
//			agent.simulationWorkspace.get(ei).policy_value = pValue;//write the new value to the active value

/*	for (int i = 0; i < agent.simulationWorkspace.size(); i++){
			if (agent.simulationWorkspace.get(ei).start_event.equals("E3")){
		
			if (agent.simulationWorkspace.get(ei).attribute.equals("plt")){
				agent.vplt = agent.simulationWorkspace.get(agent.ei).policy_value;
	  		} else {
	  		traceln("No parameter is relevant for execution");
			}

		   }
		}*/
		if (agent.vplt_sim == 0.0){
			try {
			agent.vplt_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND  policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "PROD", "plt", "Active","New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vplt_sim = 0.0; // or a default value
				}
			}
		
		
		
 /*//this is done in the exectution process			
			//remove the stock by simulating customer orders
			//randomly create a sales order value
			

			double production_order_qty = pValue;
			main.stock = main.stock + production_order_qty;
			vResult = main.stock;
			//End of specific process calculation    

			traceln("New stock level is "+vResult);
			agent.simulationWorkspace.get(agent.si).simulated_result = vResult;
	} else {
 	traceln("Policy "+pPolicy_id+"is not relevant for execution");
	}*/
	agent.simulationWorkspace.get(agent.si).status = "Processed";
	}
// } else {
//EXECUTION SPACE
//for (int i = 0; i < agent.executionWorkspace.size(); i++){
	if (agent.simulationWorkspace.get(agent.si).status.equals("Active")){
		if (agent.simulationWorkspace.get(agent.si).start_event.equals("E3")){
		
		if (agent.simulationWorkspace.get(agent.si).attribute.equals("plt")){//CHECK TO REMOVE - NOT USED
			vplt = agent.simulationWorkspace.get(agent.si).policy_value;
		  agent.simulationWorkspace.get(agent.si).status = "Processed";					
	  } else {
	  	traceln("No parameter is relevant for execution");
	 }
   } 




// agent.executionWorkspace.get(i).status = "Processed";
 }
