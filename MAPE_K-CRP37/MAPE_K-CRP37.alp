			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1734684836185</Id>
					<Name><![CDATA[fCheckConfiguration]]></Name>
					<X>400</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
// fill the learningWorkspace with all policies for the agent and the changed policy
if (agent.confChanged.size() > 0 || !agent.confChanged.isEmpty()){

	agent.configurationChanged = true;
//remove the content of confChanged as it will be processed once
//agent.confChanged.clear();
	
}
//agent.configurationChanged = 0;//reset

			
// Ensure agent configuration is initialized
//if (agent.configuration == null) {
//    agent.configuration = new ArrayList<>();
//}
for (int i = 0; i < agent.confChanged.size(); i++){

 if(agent.confChanged.get(i)!= 0){
try {
    // Validate that the database results are not null
    if (policy == null) {
        trace("Database results are null. Unable to retrieve policy IDs.");
        return;
    }

 
    // Retrieve the list of policies from the database
    List<Tuple> selectedTuples = selectFrom(policy)
    	.where(policy.agent_id.eq(agent.id), policy.higher_level_policy_id.eq(agent.confChanged.get(i)), policy.policy_type_id.eq(1))
    	.list();
    	
    // Check if the query returned any results
    if (selectedTuples != null || !selectedTuples.isEmpty()) {
        for (Tuple tuple : selectedTuples) {
            // Create a new Configuration object and populate its fields
            Learning configuration = new Learning();
            configuration.policy_id = (Integer) tuple.get(policy.policy_id);
            configuration.agent_id = (String) tuple.get(policy.agent_id);
            configuration.policy_name = (String) tuple.get(policy.policy_name);
            configuration.policy_type_id = (Integer) tuple.get(policy.policy_type_id);
            configuration.script = (String) tuple.get(policy.script);
            configuration.object_type = (String) tuple.get(policy.object_type);
            configuration.attribute = (String) tuple.get(policy.attribute);
            configuration.policy_value = (Double) tuple.get(policy.policy_value);
            configuration.policy_score = (Double) tuple.get(policy.score);
            configuration.expected_result = (Double) tuple.get(policy.expected_result);
            configuration.optimization_indicator = (String) tuple.get(policy.optimization_indicator);
            configuration.source = (String) tuple.get(policy.source);
            configuration.version = (Integer) tuple.get(policy.version);
            configuration.change_pointer = (Integer) tuple.get(policy.change_pointer);
            configuration.status = (String) tuple.get(policy.status);
            configuration.higher_level_policy_id = (Integer) tuple.get(policy.higher_level_policy_id);
            configuration.actual_result = (Double) tuple.get(policy.actual_result);    
            configuration.simulated_result = (Double) tuple.get(policy.simulated_result);
			configuration.learning_method = (String) tuple.get(policy.learning_method);
           
            // Add the mapped configuration object to the agent's configuration list
            configuration.status = "New"; // initial status for new learning records
            
            
//check if the policy is already in the learning workspace
		boolean new_value = true;
		
		for (int k = 0; k < agent.learningWorkspace.size(); k++){
			
			if (agent.learningWorkspace.get(k).policy_id == (configuration.policy_id)){
				new_value = false;
			}
		}	
		if (new_value == true){
			// add retrieved policy details and add to learning workspace
			agent.learningWorkspace.add( configuration );
		} else {
		traceln("Policy was already in the learning workspace Check config: ");
		}            
            
            
//            agent.learningWorkspace.add(configuration);
        }

        trace(selectedTuples.size() + " policy IDs successfully added to configuration.");
    } else {
        trace("No policy IDs found in the database.");
	}
	} catch (Exception e) {
    	// Log detailed error information
    	trace("Error adding data to topology: " + e.getClass().getName() + " - " + e.getMessage());
    	e.printStackTrace(); // Optional: Log the stack trace for debugging
	}
}
}

//remove the content of confChanged as it will be processed once
agent.confChanged.clear();
]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1735593297284</Id>
					<Name><![CDATA[fEvaluateResults]]></Name>
					<X>400</X><Y>480</Y>
					<Label><X>15</X><Y>5</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//retrieve tolerance limits and sensitivity
agent.vNeedtoLearn = false; //initialize the need to learn
double analyse_actual_result = 0.0; //initialize actual result analysis
double result_threshold_low = 0.0; //initialize the threshold value for results
double result_threshold_high = 0.0; //initialize the threshold value for results
int policyId = 0; // initialize policy Id
int agent_trustgroup = 0; //initialize agent_trustgroup
String check_trustgroup = ""; // initialize the agent in the trustgroup
double expected_result = 0.0;
double analyse_expected_result = 0.0;
double actual_result = 0.0;
String analyse_optimization = "";
double temp_avg_score = 0.0;
int temp_count_scores = 0;
double new_avg_score = 0.0;
int higher_level_policy = 0;

int updated_count_scores = 0;


List< Tuple > selected_policies = new ArrayList();

try{ 
agent.vResult_Tolerance = selectFirstValue(
					"SELECT dblearningtechnique.result_tolerance FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
					agent.id);
agent.learningsensitivity = selectFirstValue(
					"SELECT dblearningtechnique.learning_sensitivity FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
					agent.id);

String vTemp_Learning_Method = "";


//for (int i = 0; i < agent.configuration.size(); i++) {
// 		int analyse_policyId = agent.configuration.get(i).policy_id;

// Analyze the results from the Actual events which were retrieved from the operational environment

   } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No learning techniques found");
    }


 for (int i = 0; i < agent.eventWorkspace.size(); i++){//(1)

// check the process related to the actual events
 if	 (selectFrom(policy)
	.where(policy.policy_id.eq(agent.eventWorkspace.get(i).policy_id))//Actual events only has process policy id-s
	.where(policy.agent_id.eq(agent.id))
	.hasResults()) {//(2)

	 	int retrieved_policy_type = selectFirstValue(
 		"SELECT policy.policy_type_id FROM policy WHERE policy_id = ? AND agent_id = ?",
 		agent.eventWorkspace.get(i).policy_id, agent.id );
	
		
 	// only select decisions policies (in the future also process policies can be added)
 	if (retrieved_policy_type == 1){//(3)	// double check that only decision policies are retrieved
 		policyId = agent.eventWorkspace.get(i).policy_id;
 		
 //####retrieve trust group

 try { 	 	
 	 	String tmp_object_type = selectFirstValue(
 		"SELECT policy.object_type FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, agent.eventWorkspace.get(i).policy_id);
 	
 	 	String tmp_attribute = selectFirstValue(
 		"SELECT policy.attribute FROM policy WHERE agent_id = ? AND policy_id = ?",
 		agent.id, agent.eventWorkspace.get(i).policy_id);

		// Collection to store the selected trustgroup_ids
		List<Integer> trustgroupIds = new ArrayList<>();
		
		// Execute the query
		List<Tuple> results = selectFrom(trustgroups)
		    .where(trustgroups.object_type.eq(tmp_object_type))
		    .where(trustgroups.attribute.eq(tmp_attribute))
		    .list();
		
		// Iterate over the ResultSet and collect all trustgroup_ids
		for (Tuple row : results){
		int trustgroupId = row.get(5, Integer.class);
try {			
		int inTrustGroup = selectFirstValue(
 		"SELECT tg_agent.trustgroup_id FROM tg_agent WHERE tg_agent.trustgroup_id = ? AND tg_agent.agent_id = ?",
 		trustgroupId, agent.id);
			
		if (inTrustGroup == trustgroupId){

		    trustgroupIds.add(trustgroupId);
				//Check if policy for trust goup exists in policy_score table otherwise add value	
				try {	
						Integer content_policy_score = selectFrom(policy_score)
						.where(policy_score.policy_id.eq(policyId).and(policy_score.trustgroup_id.eq(trustgroupId))).
						firstResult(policy_score.count_scores);
						
						// Handle null case
						if (content_policy_score == null) {
						 	 content_policy_score = 0; // or throw an exception, log a warning, etc.
							}
				     
				     } catch (Exception e) {
				        // Handle any exceptions that may occur during the query execution
				        traceln("Policy does not exist in trust group");
				   
				
						insertInto(policy_score)
				                .columns(
				                policy_score.policy_id, 
				                policy_score.trustgroup_id,
				                policy_score.avg_policy_score,
				                policy_score.count_scores)
				                .values(
								policyId,
								trustgroupId,
								0.0,
								0)
								.execute();
				}

//		agent_trustgroup = selectUniqueValue(
//		"SELECT trustgroup_id FROM tg_agent WHERE agent_id = ?",
//		agent.id);




					
		//define if trigger is simulation, in that case retrieve the simulation result
	

// 		if (agent.simulationWorkspace.isEmpty() == true){//(6)when the mape cycle triggers learning (initial learning loop) it will compare the actual result.
			//add the policy parameters (not process types) to thelearning workspace that are related to the actual event
			if (selectFrom( policy ).where( policy.higher_level_policy_id.eq(policyId), policy.agent_id.eq(agent.id)).list().size()>0){ 
						
				selected_policies =  selectFrom( policy ).where( policy.higher_level_policy_id.eq(policyId), policy.agent_id.eq(agent.id)).list();
				
			} else {   			
   			// when there is no higher level policy, then select the current policy, which will be the highest level process
   				selected_policies = selectFrom( policy ).where( policy.policy_id.eq(policyId), policy.agent_id.eq(agent.id)).list();
   			}
   		
		for (int j = 0; j < selected_policies.size(); j++){
		
		Tuple sel = selected_policies.get(j);

//fill in learning environment for the random choosen policy

	Learning le = 
		new Learning(
			sel.get( policy.policy_id ),
			sel.get( policy.agent_id ), 
			sel.get( policy.policy_name ), 
			sel.get( policy.policy_type_id ),
			sel.get( policy.script ),
			sel.get( policy.object_type ),
			sel.get( policy.attribute ),
			sel.get( policy.policy_value ),
			sel.get( policy.previous_policy_value ),
			sel.get( policy.score ),
			sel.get( policy.expected_result ),
			sel.get( policy.optimization_indicator ),
			sel.get( policy.source ),
			sel.get( policy.version ),
			sel.get( policy.change_pointer ),
			sel.get( policy.status ),
			sel.get( policy.higher_level_policy_id ),
