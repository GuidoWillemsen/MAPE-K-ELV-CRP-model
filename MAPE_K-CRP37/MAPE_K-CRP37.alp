			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1745776591767</Id>
					<Name><![CDATA[fProcessResponse]]></Name>
					<X>400</X><Y>570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[boolean no_add_policy = false;
int ref_policy_id = 0;
int ref_policy_type_id = 0;
String ref_script = "";
String ref_optimization_indicator = "";
int ref_hl_policy = 0;

for (int i = 0; i < agent.crp_Workspace.size(); i++){

if ((agent.crp_Workspace.get(i).status.equals("Published"))
	&&(agent.crp_Workspace.get(i).requestor.equals(agent.id))){
	
//Add policy to policy table

int max_p = 0;
int max_ps = 0;

List<Tuple> p_rows = selectFrom(policy).list();

try {

for (Tuple p_row : p_rows) {
	traceln(p_row.get(policy.policy_id));
	if (p_row.get(policy.policy_id) > max_p)
		max_p = p_row.get(policy.policy_id);
		}

//find a reference policy for the same object type and attribute to retrieve the symptom

ref_policy_id = selectFirstValue(
			"SELECT policy.policy_id FROM policy WHERE policy.object_type = ? AND policy.attribute = ?",
			agent.crp_Workspace.get(i).object_type, agent.crp_Workspace.get(i).attribute);

ref_policy_type_id = selectFirstValue(
			"SELECT policy.policy_type_id FROM policy WHERE policy.policy_id = ?",
			ref_policy_id);
			
ref_script = selectFirstValue(
			"SELECT policy.script FROM policy WHERE policy.policy_id = ?",
			ref_policy_id);
ref_optimization_indicator = selectFirstValue(
			"SELECT policy.optimization_indicator FROM policy WHERE policy.policy_id = ?",
			ref_policy_id);			
ref_hl_policy = selectFirstValue(
			"SELECT policy.higher_level_policy_id FROM policy WHERE policy.policy_id = ?",
			ref_policy_id);	

	} catch (Exception e) {
	traceln("There is no reference policy available, so Knowledge Base could not be updated");
	}
	
//check if new entry already exists in policy table

double epsilon = 1e-6; // Tolerance for double comparison
List<Tuple> x_rows = selectFrom(policy).list();

for (Tuple x_row : x_rows) {
    // Retrieve values from the tuple
    Object rowAgentId = x_row.get(policy.agent_id);
    Object rowObjectType = x_row.get(policy.object_type);
    Object rowAttribute = x_row.get(policy.attribute);
    Object rowPolicyValueObj = x_row.get(policy.policy_value);

    // Skip if any value is null
    if (rowAgentId == null || rowObjectType == null || rowAttribute == null || rowPolicyValueObj == null) {
        continue;
    }

    // Compare non-double values using .equals()
    if (!rowAgentId.equals(agent.id) || !rowObjectType.equals(agent.crp_Workspace.get(i).object_type) || !rowAttribute.equals(agent.crp_Workspace.get(i).attribute)) {
        continue;
    }

    // Compare double values with tolerance
    double rowPolicyValue = (Double) rowPolicyValueObj;
    double targetValue = agent.crp_Workspace.get(i).value;
    if (Math.abs(rowPolicyValue - targetValue) == 0.0) {
        no_add_policy = true;
        break;
    }
}

if (no_add_policy == false){//value does not exists in policy table, so can be added 			
//add the new policy to the policy table
int value1 = max_p + 1;
			String value2 = agent.crp_Workspace.get(i).policy_name;	
			String value3 = agent.id;
			int value4 = ref_policy_type_id;
			String value5 = ref_script;
			String value6 = agent.crp_Workspace.get(i).object_type;
			String value7 = agent.crp_Workspace.get(i).attribute;
			double value8 = agent.crp_Workspace.get(i).value;
			double value9 = 0.0; //there is no previous policy value		
			double value10 = agent.crp_Workspace.get(i).score;
			double value11 = agent.crp_Workspace.get(i).expected_result;
			String value12 = ref_optimization_indicator;
			String value13 = agent.crp_Workspace.get(i).source;
			int value14 = ref_hl_policy;
			String value15 = "New";// set moved policy to new
			int value16 = 1;
			int value17 = 1;
			double value18 = 0;
			double value19 = 0;
			String value20 = "None";


				insertInto(policy).columns(
						policy.policy_id,
						policy.policy_name, 
						policy.agent_id,
						policy.policy_type_id,
						policy.script, 
						policy.object_type,
						policy.attribute,
						policy.policy_value,
						policy.previous_policy_value, 
						policy.score,
						policy.expected_result,
						policy.optimization_indicator,
						policy.source,
						policy.higher_level_policy_id,
						policy.status, 
						policy.version,
						policy.change_pointer,
						policy.actual_result,
						policy.simulated_result,
						policy.learning_method)
						.values(value1, value2, value3,
								value4, value5, value6,
								value7, value8, value9,
								value10, value11, value12,
								value13, value14, value15,
								value16, value17, value18, value19, value20)
						.execute();
						
						// Add changes to change log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.crp_Workspace.get(i).policy_id,
          		date(),
          		agent.crp_Workspace.get(i).value,
          		"-",
          		"New",
          		0,
          		0,
         		agent.crp_Workspace.get(i).source)
          		.execute();	
	
//	Add symptom_policy to the agents table
//retrieve symptom from a comparable policy based on object type and attribute

		List<Tuple> sp_rows = selectFrom(symptom_policy)
				.list();
		for (Tuple sp_row : sp_rows) {
			if (sp_row.get(
					symptom_policy.symptom_policy_id) > max_ps)
				max_ps = sp_row.get(symptom_policy.symptom_policy_id);
		}

	
// Add record to symptom_policy table
	    int add_symptom = selectFirstValue(
        "SELECT symptom_policy.symptom_id FROM symptom_policy WHERE symptom_policy.policy_id = ?",
		ref_hl_policy);
	
	    insertInto(symptom_policy)
        .columns(symptom_policy.agent_id,
        		symptom_policy.symptom_policy_id,
                symptom_policy.symptom_id,
                symptom_policy.policy_id,
                symptom_policy.status)
        .values(
        	agent.id, 
        	max_ps + 1, 
        	add_symptom, 
        	max_p + 1, 
        	"New")
        .execute();
        
        
  // Add changes to change log
			UUID uniqueID2 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
          		changelog.old_value,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID2,
         		"Symptom_Policy",
         		agent.id,
         		max_p + 1,
          		date(),
          		0,
          		max_ps + 1,
          		"-",
          		"New",
          		0,
          		0,
         		agent.crp_Workspace.get(i).source)
          		.execute();
          		
		agent.crp_Workspace.get(i).status = "Processed";
	
   }

  }
//		agent.crp_Workspace.remove(i);//remove the CRP workspace after processing
}]]></Body>
