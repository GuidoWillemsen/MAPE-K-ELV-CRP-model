if (agent.vN == 0){
	traceln("Initialization");
	}
//Calculate stock and Supply line values -> to Goods receipt
//if (agent.vCycle_id > 0){
if (agent.vN > 0){
if (!main.validate.vSimAgentType.equals("AT1")){//not for consumers
	if(!main.validate.vSimAgentType.equals("AT5")){//not for factory
/*		 for (int i = 0 ; i < this.main.cBeerGameResults.size();i++){
 
 		if (this.main.cBeerGameResults.get(i).agent_id.equals(agent.id)
 			&&this.main.cBeerGameResults.get(i).t == agent.vCycle_id-1){
			agent.ITI1 = this.main.cBeerGameResults.get(i).ITI1;//retrieve ITI1 from previous cycle
		  }
		}*/
 agent.I_sim = agent.I_sim + agent.ITI2_sim;//[27]
 
 for (int i = 0 ; i < this.main.cBeerGameSim.size();i++){
 
	 if (this.main.cBeerGameSim.get(i).agent_id.equals(main.validate.vSimAgent)
 		&&this.main.cBeerGameSim.get(i).t == agent.vN-1){
			agent.ITI2_sim = this.main.cBeerGameSim.get(i).ITI1;
	}
  }

//		agent.ITI2 = agent.ITI1;//[29] -> Consider this to do this after delivery
//		agent.ITI1 = 0;//[31] after delivery, ITI1 beccomes empty -> Consider to this after delivery
		newResult = true;

	} else { //for the factory only
	traceln("Receipt for Factory is not applicable");
