		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1739729665989</Id>
			<Name><![CDATA[Process]]></Name>
			<Text><![CDATA[import java.io.Serializable;

/**
 * Process
 */
public class Process implements Serializable {

    private String Agent_Id = "";
	private int Process_Instance = 0;
    private String Start_Event = "";
    private int Process_Id = 0;
    private String Process_name = "";
    private String End_Event = "";
    private double Sim_Result = 0.0;
    private int Sequence = 100; //default is 100 at the sequence could be decreased or increased

    /**
     * Default constructor
     */
    public Process() {
    }

    /**
     * Constructor initializing the fields
     */
    public Process(String Agent_Id, int Process_Instance, String Start_Event, int Process_Id, String Process_name, String End_Event, double Sim_Result, int Sequence) {
        this.Agent_Id = Agent_Id;
    	this.Process_Instance = Process_Instance;
        this.Start_Event = Start_Event;
        this.Process_Id = Process_Id;
        this.Process_name = Process_name;
        this.End_Event = End_Event;
        this.Sim_Result = Sim_Result;
        this.Sequence = Sequence;
    }

    // Getter for agent_id
    public String getAgent_Id() {
        return Agent_Id;
    }
    
    // Setter for Agent_Id
    public void setAgent_Id(String Agent_Id) {
        this.Agent_Id = Agent_Id;
    }
    
    // Getter for Process_Instance
    public int getProcess_Instance() {
        return Process_Instance;
    }

    // Setter for Process_Instance
    public void setProcess_Instance(int Process_Instance) {
        this.Process_Instance = Process_Instance;
    }

    // Getter for Start_Event
    public String getStart_Event() {
        return Start_Event;
    }

    // Setter for Start_Event
    public void setStart_Event(String Start_Event) {
        this.Start_Event = Start_Event;
    }

    
    // Getter for Process_Id
    public int getProcess_Id() {
        return Process_Id;
    }

    // Setter for Process_Id
    public void setProcess_Id(int Process_Id) {
        this.Process_Id = Process_Id;
    }

    // Getter for Process_name
    public String getProcess_name() {
        return Process_name;
    }

    // Setter for Process_name
    public void setProcess_name(String Process_name) {
        this.Process_name = Process_name;
    }

    // Getter for End_Event
    public String getEnd_Event() {
        return End_Event;
    }

    // Setter for End_Event
    public void setEnd_Event(String End_Event) {
        this.End_Event = End_Event;
    }

    // Getter for Sim_Result
    public double getSim_Result() {
        return Sim_Result;
    }

    // Setter for Sim_Result
    public void setSim_Result(double Sim_Result) {
        this.Sim_Result = Sim_Result;
    }

    // Getter for Sequence
    public int getSequence() {
        return Sequence;
    }
    
    // Setter for Sequence
    public void setSequence(int Sequence) {
        this.Sequence = Sequence;
    }
    
    @Override
    public String toString() {
        return "Agent_Id =  " + Agent_Id + " " +
        		"Process_Instance = " + Process_Instance + " " +
               "Start_Event = " + Start_Event + " " +
               "Process_Id = " + Process_Id + " " +
               "Process_name = " + Process_name + " " +
               "End_Event = " + End_Event + " " +
               "Sim_Result = " + Sim_Result + " " +
               "Sequence = " + Sequence + " ";
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */
    private static final long serialVersionUID = 1L;
}
]]></Text>
		</JavaClass>
