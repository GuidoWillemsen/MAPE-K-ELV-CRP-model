		<JavaClass>
			<Id>1738959696111</Id>
			<Name><![CDATA[Outcome]]></Name>
			<Text><![CDATA[/**
 * Outcome
 */	
public class Outcome implements Serializable {

	 String agent_id = "";

	 int policy_id = 0;
	 
	 int higher_level_policy = 0;

	 String evaluation_result = "";

	 String learning_method = "";

	 double actual_result = 0.0;
	 
	 double previous_result = 0.0;

	 double expected_result = 0.0;
	 
	 double temp_avg_score = 0.0;
	 
	 double new_avg_score = 0.0;
	 
	 int updated_count_scores = 0;
	 
	 
	 String status = "";

    /**
     * Default constructor
     */
    public Outcome() {
    }

    /**
     * Constructor initializing the fields
     */
    public Outcome(String agent_id, int policy_id, int higher_level_policy, String evaluation_result, String learning_method, double actual_result, double previous_result, double expected_result, double temp_avg_score, double new_avg_score, int updated_count_scores, String status) {
		this.agent_id = agent_id;
		this.policy_id = policy_id;
		this.higher_level_policy = higher_level_policy;
		this.evaluation_result = evaluation_result;
		this.learning_method = learning_method;
		this.actual_result = actual_result;
		this.previous_result = previous_result;
		this.expected_result = expected_result;
		this.temp_avg_score = temp_avg_score;
		this.new_avg_score = new_avg_score;
		this.updated_count_scores = updated_count_scores;
		this.status = status;
    }

	@Override
	public String toString() {
		return  
			"agent_id = " + agent_id +" " +
			"policy_id = " + policy_id +" " +
			"higher_level_policy = " + higher_level_policy +" " +
			"evaluation_result = " + evaluation_result +" " +
			"learning_method = " + learning_method +" " +
			"actual_result = " + actual_result +" " +
			"previous_result = " + previous_result +" " +
			"expected_result = " + expected_result +" " +
			"temp_avg_score = " + temp_avg_score + " " +
			"new_avg_score = " + new_avg_score + " " +
			"updated_count_scores = " + updated_count_scores + " " +
			"status = " + status +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
