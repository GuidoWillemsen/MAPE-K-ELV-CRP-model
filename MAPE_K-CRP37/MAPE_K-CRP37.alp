/*//remove this as it will be calculated in the execution process			
			//calculate the stock after receiving the goods from the order
			//retrieve the order quantity
			double order_qty = agent.simulationWorkspace.get(ei-1).simulated_result;//order qty retrieved from previous process
			main.simStock = main.simStock + order_qty;
			vResult = main.simStock;
			//End of specific process calculation    

			traceln("New stock level is "+vResult);
			agent.simulationWorkspace.get(agent.si).simulated_result = vResult;
			
			// Create a new instance of the Order class
			Order newOrder = new Order();

			// Set the properties of the new order
			newOrder.Sim_id = vSim_id;
			newOrder.Cycle_id = agent.si;//cycle id
			newOrder.Order_id = String.valueOf(main.sim_Last_Order_id++);
			newOrder.Agent_id = agent.id;
			newOrder.Type = "Purchase Order";
			newOrder.Partner = "Supplier";
//			newOrder.Quantity = ((double) Math.ceil((vROP - main.simStock) / vOS)) * vOS;
			newOrder.Status = "Ordered";
	*/		
//   } else {
    traceln("Policy "+pPolicy_id+"is not relevant for execution");
   }
