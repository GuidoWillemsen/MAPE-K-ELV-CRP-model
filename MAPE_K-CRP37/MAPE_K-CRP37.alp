			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758223411899</Id>
					<Name><![CDATA[fLaunchProcess]]></Name>
					<X>90</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//activate image

isActive = true;
/*
//define agent type of active agent

	String agent_type = selectFirstValue(
			"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
			agent.id);	
int i = ei;

if (vSim_id != null){
try {
   pProcess_id =    selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E5");//for each process define the start event here as a variable
	
	pPolicy_id = selectFirstValue(//Check the policy that is related to the MRP process
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E5");
  } catch (Exception e) {
    traceln("No process for this start event E5 for agent "+agent.id );
  } 

if (vSim_id != null){//only for simulation
	pPolicy_type = agent.simulationWorkspace.get(i).policy_type_id;
	pObject_type = agent.simulationWorkspace.get(i).object_type;
	pAttribute = agent.simulationWorkspace.get(i).attribute;
	pValue = agent.simulationWorkspace.get(i).policy_value;
	return;
 }
} else {//execution spaces	
		
	

}*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758223411901</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>5</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
traceln("Execution of the MRP run");

//SIMULATION WORKSPACE
//reset agent values
agent.vsat_sim = 0.0;
agent.vtheta_sim = 0.0;
agent.vmdt_sim = 0.0;
agent.vplt_sim = 0.0;
agent.vst_sim = 0.0;
agent.vwsl_sim = 0.0;

  	 agent.simulationWorkspace.get(agent.si).status = "Processed";		
  		
// 	}
// add the default policy value for the missing policy values from the policy table

		if (agent.vsat_sim == 0.0){
			try {
 			   agent.vsat_sim = selectFirstValue(
     			   "SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
      				 main.validate.vSimAgent, "MRP", "sat", "Active", "New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vsat_sim = 0.1; // or a default value prevent 0.0
				}
			}
		if (agent.vtheta_sim == 0.0){
			try {
			agent.vtheta_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "MRP", "theta", "Active", "New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vtheta_sim = 0.1; // or a default value prevent 0.0
				}
			}					
		if (agent.vmdt_sim == 0.0){
			try {
			agent.vmdt_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "MRP", "mdt", "Active", "New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vmdt_sim = 0.1; // or a default value prevent 0.0
				}
			}		
		if (agent.vplt_sim == 0.0){
			try {
			agent.vplt_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "MRP", "plt", "Active","New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vplt_sim = 0.1; // or a default value prevent 0.0
				}
			}
		if (agent.vst_sim == 0.0){
			try {		
			agent.vst_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "MRP", "st", "Active","New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vst_sim = 0.1; // or a default value prevent 0.0
				}
			}			
		if (agent.vwsl_sim == 0.0){
			try {		
			agent.vwsl_sim = selectFirstValue(
					"SELECT policy.policy_value FROM policy WHERE policy.agent_id = ? AND policy.object_type = ? AND policy.attribute = ? AND policy.status IN (?,?,?)",
					main.validate.vSimAgent, "MRP", "wsl", "Active","New","Selected");
				} catch (Exception e) {
    			// Handle cases where no value is found or multiple values exist
    			agent.vwsl_sim = 0.1; // or a default valueprevent 0.0
				}			 
			}			
	 				
//CONTINUE FOR BOTH SIMULATION AND EXECUTION	
int incoming_order = 0;
String status = "";
double theta = 0.0;
double EO = 0.0;
double EECD= 0.0;

//if (this.main.validate.vSimCycle_id == 0){
if (agent.vN == 0){
	traceln("Initialization");
}
	//calculate the expected order quantity 									
	if (main.validate.vSimAgentType.equals("AT1")){//when the agent is a customer)
		traceln("No action to be done");
	
			
 		} else if (main.validate.vSimAgentType.equals("AT2")){
 			if (agent.vN == 0 ){
 
			agent.EECD_sim = main.pStartOrderQty;//4;//[8] expected end customer demand at the start
 		  	agent.EO_sim = main.pStartOrderQty;//4;// [9] expected orders			
			} else {

			agent.EECD_sim = agent.EECD_sim + (agent.vtheta_sim * (agent.ENDCD_sim - agent.EECD_sim)); //[47] agent.EECD is the value of previous cycle

//add EECD to results table

		BeerGame_Results addEECD = new BeerGame_Results();
   		agent.order_id_sim = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		addEECD.agent_id = "A8";//for now hard coded, should be dynamic
  		addEECD.agent_type = "AT1";//for now hard coded, should be dynamic
 		addEECD.i = "A8";//for now hard coded, should be dynamic
		addEECD.t = (agent.vN);//CHANGE was +1 
		addEECD.order_id = agent.order_id_sim;
 		addEECD.EECD = agent.EECD_sim;
 		addEECD.EO = agent.EO_sim;
		addEECD.Status = "EECD added";

		this.main.cBeerGameSim.add(addEECD);

			}  	

try {
		for (int a = 0; a < this.main.subject.size(); a++){
			if (this.main.subject.get(a).type.equals("AT2")
				&& this.main.subject.get(a).active == true){
				theta = main.subject.get(a).vtheta;
				}
			}
 	} catch (Exception e) {	
 		traceln("Issue with agent parameters");
 		

 	}		

 		 } else if ( main.validate.vSimAgentType.equals("AT3")){
 		 
 		  if (agent.vN <= 1){
 		  	
 		  	agent.EO_sim = main.pStartOrderQty;//4;// [9] expected orders
 		  } else {


try {
		for (int a = 0; a < this.main.subject.size(); a++){
			if (this.main.subject.get(a).type.equals("AT3")
				&& this.main.subject.get(a).active == true){
				theta = main.subject.get(a).vtheta;
				}
			}
 	} catch (Exception e) {	
 		traceln("Issue with agent parameters");
 		

 	}		

		    for (int i = 0;i < this.main.SimOrders.size();i++){
 		    if (this.main.SimOrders.get(i).Cycle_id == (agent.vN-1)
 			  && this.main.SimOrders.get(i).Agent_type.equals("AT2")){//CHANGED FROM AT3 to AT2
 		  	  	incoming_order = incoming_order + (int) this.main.SimOrders.get(i).Quantity;
 		  	   		  		}
 		  		} 		  		


 		  
 		  	agent.EO_sim = agent.EO_sim + (theta * (incoming_order - agent.EO_sim)); //[48] agent.EO is the value of previous cycle 		  	
 		  }
 
 		 
 		 } else if ( main.validate.vSimAgentType.equals("AT4")){
 		  if (agent.vN <= 1){
 		  	
 		  	agent.EO_sim = main.pStartOrderQty;//4;// [9] expected orders
 		  } else {

			
try {
		for (int a = 0; a < this.main.subject.size(); a++){
			if (this.main.subject.get(a).type.equals("AT4")
				&& this.main.subject.get(a).active == true){
				theta = main.subject.get(a).vtheta;
				}
			}
 	} catch (Exception e) {	
 		traceln("Issue with agent parameters");
 		


	}		


		    for (int i = 0;i < this.main.SimOrders.size();i++){

 		    if (this.main.SimOrders.get(i).Cycle_id == (agent.vN-1)
 			  && this.main.SimOrders.get(i).Agent_type.equals("AT3")){
 		  	  	incoming_order = incoming_order + (int) this.main.SimOrders.get(i).Quantity; // calculate EO of next echelon
 		  	   		  		}
 		  		}
 		  
//calculate the EO of this agent
 		  	agent.EO_sim = agent.EO_sim + (theta * (incoming_order - agent.EO_sim)); //[49] agent.EO is the value of previous cycle	
 		  }
 		 } else if( main.validate.vSimAgentType.equals("AT5")){
 		   if (agent.vN <= 1){
 		  	
 		  	agent.EO_sim = 4;// [9] expected orders
 		  } else {
try {
		for (int a = 0; a < this.main.subject.size(); a++){
			if (this.main.subject.get(a).type.equals("AT5")
				&& this.main.subject.get(a).active == true){
				theta = main.subject.get(a).vtheta;
				}
			}
 	} catch (Exception e) {	
 		traceln("Issue with agent parameters");
 		

	}	

		    for (int i = 0;i < this.main.SimOrders.size();i++){
 		    if (this.main.SimOrders.get(i).Cycle_id == (agent.vN-1)
 			  && this.main.SimOrders.get(i).Agent_type.equals("AT4")){
 		  	  	incoming_order = incoming_order + (int) this.main.SimOrders.get(i).Quantity; // calculate EO of next echelon
 		  	   		  		}
 		  		}
 //calculate the EO of this agent
 		  	agent.EO_sim = agent.EO_sim + (theta * (incoming_order - agent.EO_sim)); //[50] agent.EO is the value of previous cycle	
 			}
 		  } else {
	  		 traceln("No expected order quantity to be calculated");
 		 }


double SL_st = 0.0;
int slCounter = 0;
	//calculate the desired inventory and the desired supply line
	if (!main.validate.vSimAgentType.equals("AT1")){//not for consumer
	
		agent.I_des_sim = 0;// in all cases the desired inventory should be zero [10]
	
		if (agent.vN == 0){//for the first cycle
			if (main.validate.vSimAgentType.equals("AT2")){//for retailers only
				for (int a = 0; a < this.main.subject.size(); a++){
					if (this.main.subject.get(a).active == true){

					if (this.main.subject.get(a).type.equals("AT3")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(a).st)/(slCounter+1);//calculate the new average value
						slCounter++;	
					}
			      }
			   }
				agent.SL_des_sim =  EECD * (agent.vmdt_sim + SL_st); // mdt is specific for the retailer, vst for the wholesaler. 
			} else if (main.validate.vSimAgentType.equals("AT3")){ //for wholesaler
				for (int a = 0; a < this.main.subject.size(); a++){
					if (this.main.subject.get(a).active == true){

					if (this.main.subject.get(a).type.equals("AT4")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(a).st)/(slCounter+1);//calculate the new average value
						slCounter++;	
				 }
				}
			   }	
				agent.SL_des_sim =  EO * (agent.vmdt_sim + SL_st); // mdt is specific for the wholesaler, vst for the distributor. 
	   		} else if (main.validate.vSimAgentType.equals("AT4")){//for distributor
				for (int a = 0; a < this.main.subject.size(); a++){
					if (this.main.subject.get(a).active == true){

					if (this.main.subject.get(a).type.equals("AT5")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(a).st)/(slCounter+1);//calculate the new average value
						slCounter++;	
				 }
				}
			   }	
				agent.SL_des_sim = EO * (agent.vmdt_sim + SL_st); // mdt is specific for the distrubutor, vst for the manufacturer.
			} else if (main.validate.vSimAgentType.equals("AT5")){//for manufacturer

				agent.SL_des_sim = agent.EO_sim * (agent.vplt_sim);// plt is specific for the manufacturer. Value is retrieved in the Launch Process method
	   		} else { ////end of condition for first cycle
	   			traceln("no update necessary");
	   		} // end of condition for zero cycle

	 		agent.B = 0;//[15]
	 		agent.B_sim = 0;
	 		agent.I = this.main.pStartInventory;//[16] Start inventory retrieved from dynamic parameter on start page
			agent.I_sim = this.main.pStartInventory;
		}
	}//end of condition for <> consumer
// for cycle 0
if (agent.vN == 0){
	 		if (!main.validate.vSimAgentType.equals("AT5")){
	 			agent.ITI1_sim = 4;//[17]
	 			agent.ITI2_sim = 4;//[19]
	 		} else {
		 		agent.WIPI1_sim = 4;//[18]
	 			agent.WIPI2_sim = 4;//[20]
	 		}			
			agent.TC_sim = 0;//[24] set TC to 0 for first cycle
}
	
//Calculate the Purchase requisition with the MRP planning
if (agent.vN > -1){//changed from 0 to -1
	
//Calculate expected stock. 
int IO = 0;
int B = 0;
double mdt = 0.0;


	if (main.validate.vSimAgentType.equals("AT1")){//for the consumer
		traceln("for the consumer no action is required");
	} else if (main.validate.vSimAgentType.equals("AT2")){//for the retailer
		for (int l = 0; l < this.main.subject.size(); l++){
			 if (this.main.subject.get(l).active == true){

				if (this.main.subject.get(l).type.equals("AT3")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(l).st)/(slCounter+1);//calculate the new average value
						slCounter++;
					}
				   }
				}			
		for (int k = 0; k < this.main.cBeerGameSim.size();k++){						
			if (this.main.cBeerGameSim.get(k).t == (agent.vN-1)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT1")){//retrieve the IO for the next echelon


				 }
			if (this.main.cBeerGameSim.get(k).t == (agent.vN)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT3")){
				B = this.main.cBeerGameSim.get(k).B;	//retrieve backlog for this agent type in this cycle			
				}
		}				
		for (int i = 0; i < this.main.SimOrders.size(); i++){
			if (this.main.SimOrders.get(i).Agent_type.equals(main.validate.vSimAgentType)
				&& this.main.SimOrders.get(i).Cycle_id == agent.vN){
				IO = (int) Math.round(this.main.SimOrders.get(i).Quantity);
				}				
			}			 

				agent.SL_des_sim = agent.EECD_sim *(agent.vmdt_sim + SL_st);//[54]
				agent.SL_sim = IO + B + agent.ITI1_sim + agent.ITI2_sim;//[59] -> calculate first the IO, B, ITI1 and ITI2 for this agent based on te assiged orders

	} else if (main.validate.vSimAgentType.equals("AT3")){//for the wholesaler
		for (int l = 0; l < this.main.subject.size(); l++){
				if (this.main.subject.get(l).active == true){

				if (this.main.subject.get(l).type.equals("AT4")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(l).st)/(slCounter+1);//calculate the new average value
						slCounter++;
					}
				  }	
				}
		for (int k = 0; k < this.main.cBeerGameSim.size();k++){
			if (this.main.cBeerGameSim.get(k).t == (agent.vN-1)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT2")){//retrieve the IO and B for the next echelon

				}
			if (this.main.cBeerGameSim.get(k).t == (agent.vN)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT4")){
				B = this.main.cBeerGameSim.get(k).B;	//retrieve backlog for this agent type in this cycle			
				}

			}
		for (int i = 0; i < this.main.SimOrders.size(); i++){
			if (this.main.SimOrders.get(i).Agent_type.equals(main.validate.vSimAgentType)
				&& this.main.SimOrders.get(i).Cycle_id == agent.vN){
				IO = (int) Math.round(this.main.SimOrders.get(i).Quantity);
				}				
			}	

				agent.SL_des_sim = agent.EO_sim *(agent.vmdt_sim + SL_st);//[55]
				agent.SL_sim = IO + B + agent.ITI1_sim + agent.ITI2_sim;//[59] -> calculate first the IO, B, ITI1 and ITI2 for this agent based on te assiged orders

	} else if (main.validate.vSimAgentType.equals("AT4")){//for the distributor
		for (int l = 0; l < this.main.subject.size(); l++){
				if (this.main.subject.get(l).active == true){		

				if (this.main.subject.get(l).type.equals("AT5")){
						SL_st = ((SL_st * slCounter) + this.main.subject.get(l).st)/(slCounter+1);//calculate the new average value
						slCounter++;
					}
				  }	
				}
		for (int k = 0; k < this.main.cBeerGameSim.size();k++){
			if (this.main.cBeerGameSim.get(k).t == (agent.vN-1)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT3")){//retrieve the IOfor the next echelon

				}
			if (this.main.cBeerGameSim.get(k).t == (agent.vN)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT5")){
				B = this.main.cBeerGameSim.get(k).B;	//retrieve backlog for this agent type in this cycle			
				}
			
			}
		for (int i = 0; i < this.main.SimOrders.size(); i++){
			if (this.main.SimOrders.get(i).Agent_type.equals(main.validate.vSimAgentType)
				&& this.main.SimOrders.get(i).Cycle_id == agent.vN){
				IO = (int) Math.round(this.main.SimOrders.get(i).Quantity);
				}				
			}	

				agent.SL_des_sim = agent.EO_sim *(agent.vmdt_sim + SL_st);//[56]
				agent.SL_sim = IO + B + agent.ITI1_sim + agent.ITI2_sim;//[59] -> calculate first the IO, B, ITI1 and ITI2 for this agent based on te assiged orders

	} else if (main.validate.vSimAgentType.equals("AT5")){//for the producer

		agent.SL_des_sim = agent.EO_sim * agent.vplt_sim;//[57]
		
		for (int k = 0; k < this.main.cBeerGameSim.size();k++){
			if (this.main.cBeerGameSim.get(k).t == (agent.vN)
				&& this.main.cBeerGameSim.get(k).agent_type.equals("AT5")){		
				agent.SL_sim = this.main.cBeerGameSim.get(k).WIPI1 + this.main.cBeerGameSim.get(k).WIPI2;//[62]
			}
		}
		
		
	} else {
	traceln("No MRP to be executed");
	}

	agent.EI_sim = agent.I_sim - agent.B_sim;//[58]//calulate expected inventory like free On Hand 


	if (!main.validate.vSimAgentType.equals("AT1")){
		

		agent.SLA_sim = agent.vwsl_sim * ((agent.SL_des_sim - agent.SL_sim)/agent.vsat_sim);//[63]

		agent.IA_sim = (agent.I_des_sim - agent.EI_sim)/agent.vsat_sim;	
		status = "MRP Completed";
		
 		if (main.validate.vSimAgentType.equals("AT2")){//for the retailer
			
			agent.order_id_sim = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vN ) < 5){//plain orders for first cycles -> recovered to =< 5  - was cycle id +1
				agent.O_sim = main.pStartOrderQty;//4;//[65]
			} else {
			agent.O_sim = Math.max((int)Math.round(agent.EECD_sim + agent.IA_sim + agent.SLA_sim), 0);//[65]/correction on paper -> not an absolute value but negative values become 0
			}
			status = "MRP Completed";	
		} else if (main.validate.vSimAgentType.equals("AT3")){//for the wholesaler
			agent.order_id_sim = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vN )< 5){//plain orders for first cycles -> recovered to =< 5  - was cycle id +1
				agent.O_sim = main.pStartOrderQty;//4;//[66]
			} else {

					agent.O_sim = Math.max((int)Math.round(agent.EO_sim + agent.IA_sim + agent.SLA_sim), 0);//[65]/correction on paper -> not an absolute value but negative values become 0		
			}	
			status = "MRP Completed";
		} else if (main.validate.vSimAgentType.equals("AT4")){//for the distributor
			agent.order_id_sim = java.util.UUID.randomUUID().toString();//generate an unique ID for the order
			if ((agent.vN) < 5){//plain orders for first cycles -> recovered to =< 5 - was cycle id +1
				agent.O_sim = main.pStartOrderQty;//4;//[67]
			} else {
					agent.O_sim = Math.max((int)Math.round(agent.EO_sim + agent.IA_sim + agent.SLA_sim), 0);//[65]correction on paper -> not an absolute value but negative values become 0
			}	
			status = "MRP Completed";	
		} else if (main.validate.vSimAgentType.equals("AT5")){//for the producer
			agent.order_id_sim = java.util.UUID.randomUUID().toString();//generate an unique ID for the production order
			if ((agent.vN )< 5){//plain orders for first cycles -> recovered to=< 5  - was cycle id +1
				agent.PSR_sim = main.pStartOrderQty;//4;//[68]
			} else {
					agent.PSR_sim = Math.max((int)Math.round(agent.EO_sim + agent.IA_sim + agent.SLA_sim), 0);//[65]/correction on paper -> not an absolute value but negative values become 0				
				  }				
			//moved from Produce Goods -> as the factory does not receive, the PSR is used in the MRP as receipt
	 		agent.WIPI1_sim = agent.PSR_sim;// [38]
	 		agent.SL_des_sim = (int)Math.ceil(agent.EO_sim * agent.vplt_sim);//[57]
		    agent.SL_sim = agent.WIPI1_sim + agent.WIPI2_sim;//[62]
	 		
			status = "Produced";	
		} else {
		traceln("No agents to be processed");
		}	
   }

}
//add the parameters to the results table
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN){
	

//add results to a new BeerGame record for this cycle

		this.main.cBeerGameSim.get(k).sat = agent.vsat_sim;//sat
		this.main.cBeerGameSim.get(k).mdt = agent.vmdt_sim;//mdt
		this.main.cBeerGameSim.get(k).st = agent.vst_sim;//st
		this.main.cBeerGameSim.get(k).plt = agent.vplt_sim;//plt
		this.main.cBeerGameSim.get(k).wsl = agent.vwsl_sim;//wsl
		this.main.cBeerGameSim.get(k).θ = agent.vtheta_sim;//θ
		this.main.cBeerGameSim.get(k).EECD = agent.EECD_sim;//EECD
		this.main.cBeerGameSim.get(k).EO = agent.EO_sim;//EO
		this.main.cBeerGameSim.get(k).SL = agent.SL_sim;//SL
		this.main.cBeerGameSim.get(k).SLA = agent.SLA_sim;//SLA
		this.main.cBeerGameSim.get(k).EI = agent.EI_sim;//EI
		this.main.cBeerGameSim.get(k).IA = agent.IA_sim;//IA
		this.main.cBeerGameSim.get(k).Status = status;//
		this.main.cBeerGameSim.get(k).order_id = agent.order_id_sim;
		this.main.cBeerGameSim.get(k).I_des = agent.I_des_sim;//I_des [10]
		this.main.cBeerGameSim.get(k).SL_des = agent.SL_des_sim;//SL_des			
		this.main.cBeerGameSim.get(k).B = agent.B_sim;//B
		this.main.cBeerGameSim.get(k).I = agent.I_sim;//I
		this.main.cBeerGameSim.get(k).uihc = agent.I_sim * agent.uihc_i;// calculate Inventory Holding cost for this cycle
		this.main.cBeerGameSim.get(k).ubc = agent.B_sim * agent.ubc_i;// calculate Backlog olding cost for this cycle
		this.main.cBeerGameSim.get(k).WIPI2 = agent.WIPI2_sim;//WIPI2
	if (agent.vCycle_id <= 1){
		this.main.cBeerGameSim.get(k).ITI1 = agent.ITI1_sim;//ITI1 - activated
		this.main.cBeerGameSim.get(k).ITI2 = agent.ITI2_sim;//ITI2 - activated
	}
  }
 } 		
boolean addRecord = true;
if (agent.vN == 0){//initialize for the first cycle

//for initialization
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN){  
		if (main.validate.vSimAgentType.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameSim.get(k).O = agent.O_sim;
		}
		this.main.cBeerGameSim.get(k).PSR = agent.PSR_sim;
		this.main.cBeerGameSim.get(k).WIPI1 = agent.WIPI1_sim;

  	}
  }
//for the first cycle
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN+1){  
		if (main.validate.vSimAgentType.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameSim.get(k).O = agent.O_sim;
		}
		this.main.cBeerGameSim.get(k).PSR = agent.PSR_sim;
		this.main.cBeerGameSim.get(k).WIPI1 = agent.WIPI1_sim;
		this.main.cBeerGameSim.get(k).EO = agent.EO_sim;
  		addRecord = false;
  	}
  }
}
//cycle > 0

for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN){ //CHANGE was +1 
		if (main.validate.vSimAgentType.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			this.main.cBeerGameSim.get(k).O = agent.O_sim;
		}
  		addRecord = false;
  	}
  }
  	
if (addRecord == true){		
		BeerGame_Results orderNextCycle = new BeerGame_Results();
   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		orderNextCycle.agent_id = main.validate.vSimAgent;
 		orderNextCycle.agent_type = main.validate.vSimAgentType;
 		orderNextCycle.i = main.validate.vSimAgent;
		orderNextCycle.t = (agent.vN);//CHANGE was +1 
		orderNextCycle.order_id = agent.order_id_sim;
		if (main.validate.vSimAgentType.equals("AT1")){//Store order value only for consumer, other agents do this at the purchase order
			orderNextCycle.O = agent.O_sim;
		}

  		orderNextCycle.EO = agent.EO_sim;		
		orderNextCycle.Status = "SO Created";

		this.main.cBeerGameSim.add(orderNextCycle);
	}	

addRecord = true;

for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN+1
 	&& main.validate.vSimAgentType.equals("AT5")){
		this.main.cBeerGameSim.get(k).PSR = agent.PSR_sim;
		this.main.cBeerGameSim.get(k).WIPI1 = agent.WIPI1_sim;
  		addRecord = false;
  	}
  }
if (addRecord == true
	&& main.validate.vSimAgentType.equals("AT5")){		
		BeerGame_Results orderNextCycle = new BeerGame_Results();
   		agent.order_id = java.util.UUID.randomUUID().toString();//generate an unique ID for the order   	
 		orderNextCycle.agent_id = main.validate.vSimAgent;
 		orderNextCycle.agent_type = main.validate.vSimAgentType;
 		orderNextCycle.i = main.validate.vSimAgent;
		orderNextCycle.t = (agent.vN+1);
		orderNextCycle.order_id = agent.order_id_sim;
		orderNextCycle.PSR = agent.PSR_sim;
 		orderNextCycle.WIPI1 = agent.WIPI1_sim;
	}

	if (vSim_id == null){
				agent.simulationWorkspace.get(agent.si).status = "Processed";
	}
//}		]]></Body>
