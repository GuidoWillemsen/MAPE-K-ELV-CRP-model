				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1736787379006</Id>
					<Name><![CDATA[fFindAlternatives]]></Name>
					<X>260</X><Y>640</Y>
					<Label><X>10</X><Y>5</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[if (agent.vi < agent.learningWorkspace.size()) {

pProcessChange = false;
//boolean search_new_policy = false;

int i = agent.vi;


 if (agent.learningWorkspace.get(i).status == "New"){//2


	List<Tuple> selected_alt_policies = selectFrom(policy)
			.where(policy.agent_id.eq(agent.id),
					policy.policy_type_id
							.eq(1),
					policy.object_type.eq(agent.learningWorkspace.get(i).object_type),		
					policy.attribute.eq(agent.learningWorkspace.get(i).attribute),		
					policy.higher_level_policy_id
							.eq(agent.learningWorkspace
									.get(i).higher_level_policy_id),
					policy.status.eq("Inactive"))
			.list();

 if (!selected_alt_policies.isEmpty() ){//3
	Random rand = new Random();
	
// while (search_new_policy == false){	//4
	int random_number = rand.nextInt(selected_alt_policies.size());
try {
	Tuple selalt = selected_alt_policies.get(random_number);

	// fill in learning environment for the random choosen
	// policy

	Learning lealt = new Learning(
			selalt.get(policy.policy_id),
			selalt.get(policy.agent_id),
			selalt.get(policy.policy_name),
			selalt.get(policy.policy_type_id),
			selalt.get(policy.script),
			selalt.get(policy.object_type),
			selalt.get(policy.attribute),
			selalt.get(policy.policy_value),
			selalt.get(policy.previous_policy_value),
			selalt.get(policy.score),
			selalt.get(policy.expected_result),
			selalt.get(policy.optimization_indicator),
			selalt.get(policy.source),
			selalt.get(policy.version),
			selalt.get(policy.change_pointer),
			selalt.get(policy.status),
			selalt.get(policy.higher_level_policy_id),
			selalt.get(policy.actual_result),
			selalt.get(policy.simulated_result),
			selalt.get(policy.learning_method)

	);
	lealt.status = "Selected";
	agent.learningWorkspaceTemp.add(lealt);

//add update to policy table

		update(policy)
    		.where(policy.policy_id.eq(lealt.policy_id))
   			.set(policy.status, "Selected")
   			.execute();
  			


//temporarily set the existing policy status to status hold

		update(policy)
    		.where(policy.policy_id.eq(agent.learningWorkspace.get(i).policy_id))
   			.set(policy.status, "Hold")
   			.execute();
//add selected and hold policy to log

// Create a new SelectedPolicy object with the desired values
SelectedPolicy newPolicy = new SelectedPolicy(
    agent.learningWorkspace.get(i).policy_id,
    lealt.policy_id,
    "Hold",
    "Selected"
);

// Add the object to the ArrayList
agent.cUpdatedPolicies.add(newPolicy);		
		
   			
/*   		agent.cTempPolicy.add(
   							lealt.policy_id,
   							lealt.policy_type_id,
   							lealt.object_type,
   							lealt.attribute
   					);*///add the new policy characteristics to the agent workspace	
//symptoms relate to processes, so no update required   		
/*   			update(symptom_policy)
    		.where(symptom_policy.agent_id.eq(agent.id)
   		     .and(symptom_policy.policy_id.eq(lealt.policy_id)))
   			.set(symptom_policy.status,"Active")
   			.execute();/*

//dactivate the new policy


		update(policy)
    		.where(policy.policy_id.eq(agent.learningWorkspace.get(i).policy_id))
   			.set(policy.status, "Inactive")
   			.execute();

//symptoms relate to processes, so no update required     		
/*   			update(symptom_policy)
    		.where(symptom_policy.agent_id.eq(agent.id)
   		     .and(symptom_policy.policy_id.eq(agent.learningWorkspace.get(i).policy_id)))
   			.set(symptom_policy.status, "Inactive")
   			.execute();*/
   			
   			
	//add changes to log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by,
          		changelog.previous_result,
          		changelog.new_result)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		lealt.policy_id,
          		date(),
//          		old_policy_value,
//          		agent.learningWorkspaceTemp.get(i).policy_value,
          		"Inactive",
          		"Selected",
         		"Guido Willemsen",
         		agent.learningWorkspace.get(i).actual_result,
         		agent.learningWorkspace.get(i).simulated_result
         		)
          		.execute();	
//symptoms relate to processes, so no update required      
/*	UUID uniqueID2 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by,
          		changelog.previous_result,
          		changelog.new_result)
          	.values(
         		uniqueID2,
         		"Symptom_Policy",
         		agent.id,
         		lealt.policy_id,
          		date(),
          		"New",
          		"Active",
         		"Guido Willemsen",
         		agent.learningWorkspace.get(i).actual_result,
         		agent.learningWorkspace.get(i).simulated_result
         		)
          		.execute();	*/
          		
	UUID uniqueID3 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
//          		changelog.old_value,
//         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by,
          		changelog.previous_result,
          		changelog.new_result)
          	.values(
         		uniqueID3,
         		"Policy",
         		agent.id,
         		agent.learningWorkspace.get(i).policy_id,
          		date(),
//          		old_policy_value,
//          		agent.learningWorkspaceTemp.get(i).policy_value,
          		"Inactive",
          		"Selected",
         		"Guido Willemsen",
         		agent.learningWorkspace.get(i).actual_result,
         		agent.learningWorkspace.get(i).simulated_result
         		)
          		.execute();	
//symptoms relate to processes, so no update required      
/*	UUID uniqueID4 = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
         		changelog.old_status,
         		changelog.new_status,
          		changelog.changed_by,
          		changelog.previous_result,
          		changelog.new_result)
          	.values(
         		uniqueID4,
         		"Symptom_Policy",
         		agent.id,
         		agent.learningWorkspace.get(i).policy_id,
          		date(),
          		"New",
          		"Inactive",
         		"Guido Willemsen",
         		agent.learningWorkspace.get(i).simulated_result
         		)
          		.execute();	*/

    } catch (Exception e) {
        // Log the exception details when no record was found
        traceln("No symptom policy could be found: " + e.getMessage());
    }	
	   
//      }
//	tvi++;
	
	agent.learningWorkspace.get(i).status = "Alternative policy assigned";
	
	// only when the policy was a process, the process configuratoin has been changed.
	if (agent.learningWorkspace.get(i).policy_type_id == 0){
		pProcessChange = true;

	} else {
	} 

//	ArrayList<Integer> index_remove = new ArrayList<>(); // check why this is needed
   } else {
    agent.learningWorkspace.get(i).status = "No alternative";
   traceln("No alternative policy selected");
   }//3

  }//2
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737138814209</Id>
					<Name><![CDATA[fExploreSolutions]]></Name>
					<X>260</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[if (agent.vi < agent.learningWorkspace.size()) {
pProcessChange = false;
int i = agent.vi;

//for (int i = vi; i < agent.learningWorkspace.size();i++) {
// if (agent.learningWorkspace.get(i).status == "New"){//when policy was added to learning workspace
// if (i == vi) { //select the instance from the learning workspace collection that is subject to analyze
	List<Tuple> selected_new_policies = selectFrom(policy)//select all policies  for the same policy type, same object type and same attributes
			.where(policy.agent_id.eq(agent.id),
					policy.policy_type_id
							.eq(agent.learningWorkspace
									.get(i).policy_type_id),
					policy.object_type
							.eq(agent.learningWorkspace
									.get(i).object_type),
					policy.attribute
							.eq(agent.learningWorkspace
									.get(i).attribute))
			.list();
if (!selected_new_policies.isEmpty()) {
	Random rand = new Random();
	int random_number = rand
			.nextInt(selected_new_policies.size()); // select a random record from the collection of policies of the same type

	Tuple selnew = selected_new_policies.get(random_number);

	// fill in learning environment for the random choosen
	// policy

	Learning lenew = new Learning(
			selnew.get(policy.policy_id),
			selnew.get(policy.agent_id),
			selnew.get(policy.policy_name),
			selnew.get(policy.policy_type_id),
			selnew.get(policy.script),
			selnew.get(policy.object_type),
			selnew.get(policy.attribute),
			selnew.get(policy.policy_value),
			selnew.get(policy.previous_policy_value),
			selnew.get(policy.score),
			selnew.get(policy.expected_result),
			selnew.get(policy.optimization_indicator),
			selnew.get(policy.source),
			selnew.get(policy.version),
			selnew.get(policy.change_pointer),
			selnew.get(policy.status),
			selnew.get(policy.higher_level_policy_id),
			selnew.get(policy.actual_result),
			selnew.get(policy.simulated_result),
			selnew.get(policy.learning_method)

	);
	lenew.status = "Explored";

	double minValue = selectFirstValue(
			"SELECT policy_value_range.min_value FROM policy_value_range WHERE policy_type_id = ? AND object_type = ? AND attribute = ? ",
			lenew.policy_type_id, lenew.object_type,lenew.attribute);
	double maxValue = selectFirstValue(
			"SELECT policy_value_range.max_value FROM policy_value_range WHERE policy_type_id = ? AND object_type = ? AND attribute = ? ",
			lenew.policy_type_id, lenew.object_type,
			lenew.attribute);

			//define list of existing policy values

			List <Object> list_policy_values = new ArrayList<>();

			for (int j = 0; j < agent.learningWorkspace.size(); j++) {
 				Object selected_policy_values = selectFrom (policy).
 				where(policy.policy_type_id.eq(agent.learningWorkspace.get(j).policy_type_id)).
 				list(policy.policy_value);
 	
 			list_policy_values.add(selected_policy_values);
		}


	double random_number_value = 0.0;
	
	do { // create a new random value for the policy and check if this already exists. When it exist, select a new random value untill it does not exist in the current policy values

		Random rand_value = new Random();
		random_number_value = rand_value
				.nextDouble(minValue, maxValue);
			
	    } while (list_policy_values.contains(random_number_value));
		
	lenew.previous_policy_value = lenew.policy_value;//list_policy_values;//CORRECTED
		lenew.policy_value = random_number_value;

	agent.learningWorkspaceTemp.add(lenew);
//	tvi++;
	
// check if this record is related to a process type in the learning workspace
	if (agent.learningWorkspace.get(i).policy_type_id == 0)
		pProcessChange = true;
	}
	agent.learningWorkspace.get(i).status = "Explored";
//  }
//}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1737144310254</Id>
					<Name><![CDATA[fProcess_Update]]></Name>
					<X>260</X><Y>810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[String previous_attribute = "";
double highest_policy_score = 0.0;

//int vi = 0; // initialization of the index of the learning Workspace which has the highest score)



/*List<Learning> sortedByAttributeAsc = agent.learningWorkspace.stream()				                   		
										.sorted(Comparator.comparing(learning -> learning.attribute))
                                        .collect(Collectors.toList());*/
                                        
List<Learning> sortedByAttributeScore = agent.learningWorkspaceTemp.stream()
    .sorted(Comparator.comparing(Learning::getAttribute) // First sort by 'attribute'
            .thenComparing(Learning::getPolicyScore, Comparator.reverseOrder()))    // Then sort by 'policy_score'
    .collect(Collectors.toList());
                                        
agent.learningWorkspaceTemp.clear();

//List sortedByAttributeAsc = sortAscending( agent.learningWorkspace, a -> a.attribute );

for (int j = 0; j < sortedByAttributeScore.size(); j++) {//(1)
		
    if (!sortedByAttributeScore.get(j).attribute.equals(previous_attribute)){//(2)
//	  if (sortedByAttributeAsc.get(j).policy_score > highest_policy_score){//(3)
//	  	highest_policy_score = sortedByAttributeAsc.get(j).policy_score;
	  	agent.learningWorkspaceTemp.add(sortedByAttributeScore.get(j));

//		 }//(3)
		}/*(2) else {//(4)
			highest_policy_score = sortedByAttributeAsc.get(j).policy_score;
//			previous_attribute = sortedByAttributeAsc.get(j).attribute;
		}//(4)*/
	   
	   previous_attribute = sortedByAttributeScore.get(j).attribute;
	 }//(1)
	
	// define the highest id in the policy table
	// ############################################
	int max_p = 0;

	List<Tuple> p_rows = selectFrom(policy).list();

try{
	for (Tuple p_row : p_rows) {//(5)
		traceln(p_row.get(policy.policy_id));
		if (p_row.get(policy.policy_id) > max_p)
			max_p = p_row.get(policy.policy_id);
		}//(5)
} catch (Exception e) {
	traceln("No policy found in rows");
}

highest_policy_score = 0.0;//reset the highest policy score
		
for (int i = 0; i < agent.learningWorkspaceTemp.size(); i++) { //(20)		
  if (agent.learningWorkspaceTemp.get(i).policy_score > highest_policy_score){//(6)
  	highest_policy_score = agent.learningWorkspaceTemp.get(i).policy_score;
	if ((agent.learningWorkspaceTemp
			.get(i).status == "Exploited" ||
			agent.learningWorkspaceTemp
			.get(i).status == "Explored")
			&& agent.learningWorkspaceTemp
					.get(i).policy_type_id == 0) {//(7)
					
//		old_policy_value = agent.learningWorkspaceTemp.get(i).policy_value;
		
		int value1 = max_p + 1;
		String value2 = agent.learningWorkspaceTemp
				.get(i).policy_name;
		String value3 = agent.learningWorkspaceTemp
				.get(i).agent_id;
		int value4 = agent.learningWorkspaceTemp
				.get(i).policy_type_id;
		String value5 = agent.learningWorkspaceTemp
				.get(i).script;
		String value6 = agent.learningWorkspaceTemp
				.get(i).object_type;
		String value7 = agent.learningWorkspaceTemp
				.get(i).attribute;
		double value8 = agent.learningWorkspaceTemp
				.get(i).policy_value;
		double value9 = agent.learningWorkspaceTemp
				.get(i).previous_policy_value;
		double value10 = agent.learningWorkspaceTemp
				.get(i).policy_score;
		double value11 = agent.learningWorkspaceTemp
				.get(i).expected_result;
		String value12 = agent.learningWorkspaceTemp
				.get(i).optimization_indicator;
		String value13 = agent.learningWorkspaceTemp
				.get(i).source;
		Integer value14 = agent.learningWorkspaceTemp
				.get(i).higher_level_policy_id;
		String value15 = "New";// set moved policy to new. After validation this is set to active
	
		int value16 = agent.learningWorkspaceTemp
				.get(i).version;
		int value17 = agent.learningWorkspaceTemp
				.get(i).change_pointer;
		double value18 = 0;
		double value19 = 0;
		String value20 = "None";
		try {//(8)
			if (agent.learningWorkspaceTemp
					.get(i) != null
					&& agent.learningWorkspaceTemp.get(i).previous_policy_value !=
						 agent.learningWorkspaceTemp.get(i).policy_value) { // (9)&&
										// agent.learningWorkspaceTemp.get(i).policy_id
										// != null) {
				insertInto(policy).columns(
						policy.policy_id,
						policy.policy_name, 
						policy.agent_id,
						policy.policy_type_id,
						policy.script, 
						policy.object_type,
						policy.attribute,
						policy.policy_value,
						policy.previous_policy_value, 
						policy.score,
						policy.expected_result,
						policy.optimization_indicator,
						policy.source,
						policy.higher_level_policy_id,
						policy.status, 
						policy.version,
						policy.change_pointer,
						policy.actual_result,
						policy.simulated_result,
						policy.learning_method)
						.values(value1, value2, value3,
								value4, value5, value6,
								value7, value8, value9,
								value10, value11, value12,
								value13, value14, value15,
								value16, value17, value18, value19, value20)
						.execute();
						
						// Add changes to change log
	UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
          		changelog.old_value,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Policy",
         		agent.id,
         		agent.learningWorkspaceTemp.get(i).policy_id,
          		date(),
          		agent.learningWorkspaceTemp.get(i).previous_policy_value,
          		agent.learningWorkspaceTemp.get(i).policy_value,
          		"-",
          		"New",
          		0,
          		0,
         		"Guido Willemsen")
          		.execute();	
						
						
					
			}/*(9)*/ else {//(10)
				traceln("Null value encountered at index "
						+ i);
			}//(10)
		}/*(8)*/ catch (Exception e) {//(11)
			traceln("Error inserting data at index " + i
					+ " with policy_id "
					+ (agent.learningWorkspaceTemp
							.get(i) != null
									? agent.learningWorkspaceTemp
											.get(i).policy_id
									: "null")
					+ ": " + e.getMessage());
		}//(11)
	// define the highest value in the symptom_policy table
	// ############################################
	int max_ps = 0;

	List<Tuple> sp_rows = selectFrom(symptom_policy).list();

	for (Tuple sp_row : sp_rows) {//(12)
		traceln(sp_row.get(symptom_policy.symptom_policy_id)
				+ "\t"
				+ sp_row.get(symptom_policy.symptom_id)
				+ "\t"
				+ sp_row.get(symptom_policy.policy_id));
		if (sp_row.get(symptom_policy.symptom_policy_id) > max_ps)
			max_ps = sp_row.get(symptom_policy.symptom_policy_id);
			
			 Integer policyId = sp_row.get(symptom_policy.policy_id);

  			  // Check if policyId is null to avoid NullPointerException
  			  if (policyId == null) {
  			      traceln("policy_id is null for this tuple.");
  			      continue; // Skip to the next tuple if policy_id is null
  			  }

 			   // Compare policy_id with max_p + 1
   			 if (policyId.equals(max_p + 1)) {
     			   traceln("policy_id is equal to max_p + 1 for this tuple.");
      			  // Additional logic can be added here
   			 }

   			 // Log the values
    			traceln(sp_row.get(symptom_policy.symptom_policy_id) + "\t"
     			       + sp_row.get(symptom_policy.symptom_id) + "\t"
      			      + policyId);

   			 // Update max_ps if the current symptom_policy_id is greater
   			 Integer symptomPolicyId = sp_row.get(symptom_policy.symptom_policy_id);
   			 if (symptomPolicyId != null && symptomPolicyId > max_ps) {
     			   max_ps = symptomPolicyId;
    			}	
	}//(12)
	// write the new symptom to the policy_symptom table
	int add_symptom = selectFirstValue(
			"SELECT symptom_id FROM symptom_policy WHERE policy_id = ?",
			agent.learningWorkspaceTemp.get(i).policy_id);
			
			insertInto(symptom_policy)
			.columns(symptom_policy.agent_id,
					symptom_policy.symptom_policy_id,
					symptom_policy.symptom_id,
					symptom_policy.policy_id,
					symptom_policy.status)
			.values(agent.id, max_ps + 1, add_symptom, max_p+1,"New")// add a new symptom_policy_id, the exisiting symptom and a new policy id
			.execute();
			
	agent.learningWorkspaceTemp.get(i).status = "Processed";
	// Add changes to change log
			UUID uniqueID = UUID.randomUUID();//generate an unique ID

		insertInto(changelog)
        	  .columns(
          		changelog.log_id,
          		changelog.db_table,
          		changelog.agent_id,
          		changelog.policy_id,
          		changelog.change_date,
          		changelog.old_value,
         		changelog.new_value,
         		changelog.old_status,
         		changelog.new_status,
         		changelog.previous_result,
         		changelog.new_result,
          		changelog.changed_by)
          	.values(
         		uniqueID,
         		"Symptom_Policy",
         		agent.id,
         		agent.learningWorkspaceTemp.get(i).policy_id,
          		date(),
          		0,
          		max_ps + 1,
          		"-",
          		"New",
          		0,
          		0,
         		"Guido Willemsen")
          		.execute();
	
	}/*(7)// else {//(13)*/
//	}//(12)
//if (agent.learningWorkspaceTemp
//		.get(i).status == "Explored"
//		&& agent.learningWorkspaceTemp
//				.get(i).policy_type_id == 0) {//(14)
						
	
			
			// Activate process
//			update(policy)
//					.where(policy.policy_id
//							.eq(agent.learningWorkspace
//									.get(i).policy_id))
//					.set(policy.status, "Active").execute();
//		}//(14)
//	}//(13)

    }//(6)
  }//(20)

// set Learning completed when all the records in the learning workspace has been processed
//if (vi+1 > agent.learningWorkspaceTemp.size()) {
//	pLearningCompleted = true;
//}
]]></Body>
