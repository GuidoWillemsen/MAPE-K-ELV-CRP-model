					<Body><![CDATA[traceln("Execution of the Receipts");

boolean newResult = false;

//receive stock and virtual calculation of outcome of policy change
//if (vSim_id != null){//simulation space
	if (agent.simulationWorkspace.get(agent.si).object_type.equals("REC")){// Process types are not included in this model yet


//			agent.simulationWorkspace.get(ei).previous_policy_value = agent.simulationWorkspace.get(ei).policy_value;//write the current value to the previous value
