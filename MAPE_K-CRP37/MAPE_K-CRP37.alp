			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758223449902</Id>
					<Name><![CDATA[fLaunchProcess]]></Name>
					<X>90</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//activate image

isActive = true;

/*try {
   pProcess_id =    selectFirstValue(//Check the processs to execute derived from the start event)
		"SELECT process_repository.process_id FROM process_repository WHERE process_repository.agent_id = ? AND process_repository.start_event = ?",
		agent.id, "E6");//for each process define the star event here as a variable
  } catch (Exception e) {
    traceln("No process for this start event E6 for agent "+agent.id );
  } 
//   int process_id = pProcess_id.substring(0);  	  

for (int i = 0; i < agent.simulationWorkspace.size(); i++){

// if (agent.simulationWorkspace.get(i).policy_type_id == 1 
// 	&& agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){
 if (agent.simulationWorkspace.get(i).higher_level_policy_id == pProcess_id){
	
	pPolicy_id = agent.simulationWorkspace.get(i).policy_type_id;
	pPolicy_type = agent.simulationWorkspace.get(i).policy_type_id;
	pObject_type = agent.simulationWorkspace.get(i).object_type;
	pAttribute = agent.simulationWorkspace.get(i).attribute;
	pValue = agent.simulationWorkspace.get(i).policy_value;
	return;
   }
 }*/

/*  
   pPolicy_type = selectUniqueValue(//retrieve the policy type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.policy_type_id FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
   
   pObject_type = selectUniqueValue(//retrieve the object type from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.object_type FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
		
	pAttribute = selectUniqueValue(//retrieve the attribute from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.attribute FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);
		
	pValue = selectUniqueValue(//retrieve the value from the the higher level policy (process id - where type = 0)
		"SELECT agent.simulationWorkspace.value FROM agent.simulationWorkspace WHERE (agent.simulationWorkspace.higher_level_policy = ?), agent.simulationWorkspace.policy_type_id == 1",
		pProcess_id);		
*/
   ]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758223449904</Id>
					<Name><![CDATA[fExecute_Activity]]></Name>
					<X>90</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
boolean newEntry = true;

traceln("Execution of the Delivery");
//Sales order simulation
//define agent type of active agent

String agent_type = main.validate.vSimAgentType;	

//if (vSim_id != null){// simulation space


agent.simulationWorkspace.get(agent.si).status = "Processed";

// }	


for	(int p = 0; p < this.main.cBeerGameSim.size(); p++){
	if (this.main.cBeerGameSim.get(p).agent_id == main.validate.vSimAgentType
	&& this.main.cBeerGameSim.get(p).t == agent.vN){
		agent.IO = this.main.cBeerGameSim.get(p).IO;
	}
   }
//for (int i = 0; i < agent.executionWorkspace.size(); i++){

	
if (agent.vN == 0){
	traceln("Initialization");
/*	if 	(agent_type.equals("AT2")){//for the retailer
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT3")){//for the wholesaler
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT4")){//for the distributor		
		agent.ITI1 = 4;
		agent.ITI2 = 4;
	} else if ( agent_type.equals("AT5")){//for the producer
		traceln("No initialization to be done");
	}	*/	
	
} else {

// calculate the shipment quantity -> specifiy this also for the orders
	if (agent_type.equals("AT1")){//for consumer
		traceln("No delivery to create by the customer");
		}

	if 	(agent_type.equals("AT2")){//for the retailer
	
		if (agent.I_sim <= ( agent.B_sim + agent.ENDCD_sim )){//
			agent.S_sim = agent.I_sim;//[33}] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
			agent.S_sim = ( agent.B_sim + agent.ENDCD_sim );//[33] When there is enough inventory, send over the full backlog and demand
		}
			agent.B_sim = agent.B_sim +( agent.ENDCD_sim - agent.S_sim);//[39] backlog after sending the shipment	
			agent.I_sim = agent.I_sim - agent.S_sim;//[43] substratct the delivery from the stock
//			agent.IO = 0;//set the incoming orders to 0
        	agent.simulationWorkspace.get(agent.si).status = "Processed";
		
			for(int k = 0; k < this.main.cBeerGameSim.size(); k++){
				if (this.main.cBeerGameSim.get(k).agent_type.equals("AT2")
					&& this.main.cBeerGameSim.get(k).t == (agent.vN)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT1")){//CHECK: when multiple ageents are allowed per echelon this must be changed
//							this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
							this.main.subject.get(l).ITI1 = agent.S_sim;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
							}
						}
      }
     }				
	} else if (agent_type.equals("AT3")){//for the wholesaler
	
			if (agent.I_sim <= ( agent.B_sim + agent.IO_sim )){
				agent.S_sim = agent.I_sim;//[34} When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S_sim = ( agent.B_sim + agent.IO_sim );//34] When there is enough inventory, send over the full backlog and demand
		}
		agent.B_sim = agent.B_sim +( agent.IO_sim - agent.S_sim);//[40] backlog after sending the shipment	
		agent.I_sim = agent.I_sim - agent.S_sim;//[44] substratct the delivery from the stock
//		agent.IO = 0;//set the incoming orders to 0
		agent.simulationWorkspace.get(agent.si).status = "Processed";		
		
			for(int k = 0; k < this.main.cBeerGameSim.size(); k++){
				if (this.main.cBeerGameSim.get(k).agent_type.equals("AT3")
					&& this.main.cBeerGameSim.get(k).t == (agent.vN)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT2")){//CHECK: when multiple ageents are allowed per echelon this must be changed
//							this.main.subject.get(l).ITI1 = this.main.subject.get(l).ITI1 + this.main.cBeerGameResults.get(k).S;//[37]
							this.main.subject.get(l).ITI1_sim = agent.S_sim;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported						
							}
						}

		}
	}
						
	} else if (agent_type.equals("AT4")){//for the distributor
	
		if (agent.I_sim <= ( agent.B_sim + agent.IO_sim )){
				agent.S_sim = agent.I_sim;//[35] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S_sim = ( agent.B_sim + agent.IO_sim );//[35] When there is enough inventory, send over the full backlog and demand
		}
		agent.B_sim = agent.B_sim +( agent.IO_sim - agent.S_sim);//[41] backlog after sending the shipment		
		agent.I_sim = agent.I_sim - agent.S_sim;//[45] substratct the delivery from the stock
        agent.simulationWorkspace.get(agent.si).status = "Processed";		
		
			for(int k = 0; k < this.main.cBeerGameSim.size(); k++){
				if (this.main.cBeerGameSim.get(k).agent_type.equals("AT4")
					&& this.main.cBeerGameSim.get(k).t == (agent.vN)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
					for (int l = 0; l < this.main.subject.size();l++){
						if (this.main.subject.get(l).active == true
							&& this.main.subject.get(l).type.equals("AT3") ){//CHECK: when multiple ageents are allowed per echelon this must be changed
							this.main.subject.get(l).ITI1_sim = agent.S_sim;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
							}
						}

      }
    }				
	} else if (agent_type.equals("AT5")){//for the manufacturer
			if (agent.I_sim <= ( agent.B_sim + agent.IO_sim)){
				agent.S_sim = agent.I_sim;//[36] When the inventory is lower than the backlog + demand, send over the full inventory
			} else {
				agent.S_sim = ( agent.B_sim + agent.IO_sim );//[36] When there is enough inventory, send over the full backlog and demand
		}

		agent.B_sim = agent.B_sim +( agent.IO_sim - agent.S_sim);//[42] backlog after sending the shipment		
		agent.I_sim = agent.I_sim - agent.S_sim;//[46] substratct the delivery from the stock
        agent.simulationWorkspace.get(agent.si).status = "Processed";
        
		for(int k = 0; k < this.main.cBeerGameSim.size(); k++){
			if (this.main.cBeerGameSim.get(k).agent_type.equals("AT5")
				&& this.main.cBeerGameSim.get(k).t == (agent.vN)){//retrieve the outgoing shipment of the previous echelon in the previous cycle: CHANGE to the current cycle according Edali
				for (int l = 0; l < this.main.subject.size();l++){
					if (this.main.subject.get(l).active == true
						&& this.main.subject.get(l).type.equals("AT4")){//CHECK: when multiple ageents are allowed per echelon this must be changed
						this.main.subject.get(l).ITI1_sim = agent.S_sim;//[37]	removed sum as only one agent is active CHANGE if multi agent is supported			
						}
					}

      }
    }				
	}	
   } 
//  }//end of assigned
// agent.executionWorkspace.get(i).status = "Processed";

//add ITI1 of next agent to results for this cycle

for(int l = 0; l < this.main.cBeerGameSim.size(); l++){
		if (this.main.cBeerGameSim.get(l).agent_id.equals(main.validate.vSimAgent)
 			&&this.main.cBeerGameSim.get(l).t == agent.vN){
			this.main.cBeerGameSim.get(l).ITI1 = agent.ITI1_sim;//write the ITI1 to the results table
			newEntry = false;			
		}			
	}

 
boolean addRecord = true;



for (int m = 0; m < this.main.cBeerGameSim.size(); m++) {
    if (main.validate.vSimAgentType.equals("AT5")) {
        if (this.main.cBeerGameSim.get(m).agent_type.equals("AT4")
            && this.main.cBeerGameSim.get(m).t == agent.vN) {
            addRecord = false;
        }
    } else if (main.validate.vSimAgentType.equals("AT4")) {
        if (this.main.cBeerGameSim.get(m).agent_type.equals("AT3")
            && this.main.cBeerGameSim.get(m).t == agent.vN) {
            addRecord = false;
        }
    } else if (main.validate.vSimAgentType.equals("AT3")) {
        if (this.main.cBeerGameSim.get(m).agent_type.equals("AT2")
            && this.main.cBeerGameSim.get(m).t == agent.vN) {
            addRecord = false;
        }
    } else if (main.validate.vSimAgentType.equals("AT2")) {
        if (this.main.cBeerGameSim.get(m).agent_type.equals("AT1")
            && this.main.cBeerGameSim.get(m).t == agent.vN) {
            addRecord = false;
        }
    }
}  
 
 if (newEntry == true){
 	if (main.validate.vSimAgentType.equals("AT5")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT4")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameSim.size();j++){
   						 if (this.main.cBeerGameSim.get(j).agent_type.equals("AT4")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameSim.get(j).t == agent.vN){  
   							this.main.cBeerGameSim.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameSim.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameSim.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameSim.get(j).t = agent.vN;
							this.main.cBeerGameSim.get(j).ITI1 = agent.ITI1_sim;
							this.main.cBeerGameSim.get(j).Status = "ITI1 Added";
   						}
   					}
				} else {
	   		   			BeerGame_Results  newRecord = new BeerGame_Results();
						newRecord.agent_id = this.main.subject.get(k).id;
						newRecord.agent_type = this.main.subject.get(k).type;
						newRecord.i = this.main.subject.get(k).id; 	
   						newRecord.t = agent.vN;
   						newRecord.ITI1 = agent.ITI1_sim;
						newRecord.Status = "ITI1 Added";
						if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
						}
   						this.main.cBeerGameSim.add(newRecord);
   				}
   				}
   			}				
 		
 	} else if (main.validate.vSimAgentType.equals("AT4")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT3")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameSim.size();j++){
   						 if (this.main.cBeerGameSim.get(j).agent_type.equals("AT3")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameSim.get(j).t == agent.vN){ 
   							this.main.cBeerGameSim.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameSim.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameSim.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameSim.get(j).t = agent.vN;
							this.main.cBeerGameSim.get(j).ITI1 = agent.ITI1_sim;
							this.main.cBeerGameSim.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vN;
   					newRecord.ITI1 = agent.ITI1_sim;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
					newRecord.Sim_id = vSim_id.toString();
					}
   					this.main.cBeerGameSim.add(newRecord);
   				}
   				}
   			}	
 	} else if (main.validate.vSimAgentType.equals("AT3")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT2")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameSim.size();j++){
   						 if (this.main.cBeerGameSim.get(j).agent_type.equals("AT2")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameSim.get(j).t == agent.vN){ 
   							this.main.cBeerGameSim.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameSim.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameSim.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameSim.get(j).t = agent.vN;
							this.main.cBeerGameSim.get(j).ITI1 = agent.ITI1_sim;
							this.main.cBeerGameSim.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vN;
   					newRecord.ITI1 = agent.ITI1_sim;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
					}					
   					this.main.cBeerGameSim.add(newRecord);
   				}
   				}
   			}	
 	} else if (main.validate.vSimAgentType.equals("AT2")){
 		for (int k = 0; k < this.main.subject.size(); k++){
	   			if (this.main.subject.get(k).active == true
	   				&& this.main.subject.get(k).type.equals("AT1")){
   				if (addRecord == false){
   					 for (int j = 0 ; j < this.main.cBeerGameSim.size();j++){
   						 if (this.main.cBeerGameSim.get(j).agent_type.equals("AT1")//make this dynamic in a genuine multi-agent situation
 							&&this.main.cBeerGameSim.get(j).t == agent.vN){ 
   							this.main.cBeerGameSim.get(j).agent_id = this.main.subject.get(k).id;
							this.main.cBeerGameSim.get(j).agent_type = this.main.subject.get(k).type;
							this.main.cBeerGameSim.get(j).i = this.main.subject.get(k).id; 	
							this.main.cBeerGameSim.get(j).t = agent.vN;
							this.main.cBeerGameSim.get(j).ITI1 = agent.ITI1_sim;
							this.main.cBeerGameSim.get(j).Status = "ITI1 Added";
   						}
   						}
				} else {
	   		   		BeerGame_Results  newRecord = new BeerGame_Results();
					newRecord.agent_id = this.main.subject.get(k).id;
					newRecord.agent_type = this.main.subject.get(k).type;
					newRecord.i = this.main.subject.get(k).id; 	
   					newRecord.t = agent.vN;
   					newRecord.ITI1 = agent.ITI1_sim;
					newRecord.Status = "ITI1 Added";
					if (vSim_id != null) {
						newRecord.Sim_id = vSim_id.toString();
					}					
   					this.main.cBeerGameSim.add(newRecord);
   				}
   				}
   			}		 		
	} else {
		traceln("No records to be added");
	}
 }
	
 //add the result to the results collection
 
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN){
		this.main.cBeerGameSim.get(k).st = agent.vst_sim;
 		this.main.cBeerGameSim.get(k).S = agent.S_sim;
 		this.main.cBeerGameSim.get(k).B = agent.B_sim;
 		this.main.cBeerGameSim.get(k).Status = "Delivered";
 	} else{
 		traceln("No results to be processed");
 	}	
  }// end of result processing
]]></Body>
				</Function>
