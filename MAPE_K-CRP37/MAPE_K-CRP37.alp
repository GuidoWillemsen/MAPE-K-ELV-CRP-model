				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1736614768135</Id>
					<Name><![CDATA[fSelectLearningMethod]]></Name>
					<X>260</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[vLearning_Balance = selectFirstValue(// define the learning balance for ..
		"SELECT dblearningtechnique.explore_percentage FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
		agent.id);
vML_Exploit = selectFirstValue(//Check if Machine Learning for Exploitation for this agent is active
		"SELECT dblearningtechnique.ml_exploit FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
		agent.id);
vML_Explore = selectFirstValue(//Check if Machine Learning for Exploration for this agent is active
		"SELECT dblearningtechnique.ml_explore FROM dblearningtechnique WHERE dblearningtechnique.agent_id = ?",
		agent.id);
//add 1 to the index
agent.vi++;


if (agent.vi < agent.learningWorkspace.size()) {


vLearningMethod = agent.learningWorkspace.get(agent.vi).learning_method;

}



]]></Body>
