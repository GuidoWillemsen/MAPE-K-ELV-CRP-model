		<JavaClass>
			<Id>1736086958062</Id>
			<Name><![CDATA[Learning]]></Name>
			<Text><![CDATA[/**
 * Learning
*/
public class Learning implements Serializable {

	 int policy_id;
	 
	 String agent_id;
	 
	 String policy_name;
	 
	 int policy_type_id;
	 
	 String script;
	 
	 String object_type;
	 
	 String attribute;
	 
	 double policy_value;
	 
	 double previous_policy_value;
	 
	 double policy_score; 
	 
	 double expected_result;
	 
	 String optimization_indicator;
	 
	 String source;
	 
	 int version;
	 
	 int change_pointer;
	 
	 String status;

	 int higher_level_policy_id;

	 double actual_result;

	 double simulated_result;
	 
	 String learning_method;

    /**
     * Default constructor
     */
    public Learning() {
    }

    /**
     * Constructor initializing the fields
     */
    //
    public Learning( int policy_id, String agent_id, String policy_name, int policy_type_id, String script, String object_type, String attribute, double policy_value, double previous_policy_value, double policy_score, double expected_result, String optimization_indicator, String source, int version, int change_pointer, String status, int higher_level_policy_id, double actual_result, double simulated_result, String learning_method) {
		this.policy_id = policy_id;
    	this.agent_id = agent_id;
		this.policy_name = policy_name;
		this.policy_type_id = policy_type_id;
		this.script = script;
		this.object_type = object_type;
		this.attribute = attribute;
		this.policy_value = policy_value;
		this.previous_policy_value = previous_policy_value;
		this.policy_score = policy_score;
		this.expected_result = expected_result;
		this.optimization_indicator = optimization_indicator;
		this.source = source;
		this.version = version;
		this.change_pointer = change_pointer;
		this.status = status;
		this.higher_level_policy_id = higher_level_policy_id;
		this.actual_result = actual_result;
		this.simulated_result = simulated_result;
		this.learning_method = learning_method;
    }

 // Getters and Setters
    public int getPolicyId() {
        return policy_id;
    }

    public void setPolicyId(int policyId) {
        this.policy_id = policyId;
    }

    public String getAgentId() {
        return agent_id;
    }

    public void setAgentId(String agentId) {
        this.agent_id = agentId;
    }

    public String getPolicyName() {
        return policy_name;
    }

    public void setPolicyName(String policyName) {
        this.policy_name = policyName;
    }

    public int getPolicyTypeId() {
        return policy_type_id;
    }

    public void setPolicyTypeId(int policyTypeId) {
        this.policy_type_id = policyTypeId;
    }

    public String getScript() {
        return script;
    }

    public void setScript(String script) {
        this.script = script;
    }

    public String getObjectType() {
        return object_type;
    }

    public void setObjectType(String objectType) {
        this.object_type = objectType;
    }

    public String getAttribute() {
        return attribute;
    }

    public void setAttribute(String attribute) {
        this.attribute = attribute;
    }

    public double getPolicyValue() {
        return policy_value;
    }

    public void setPolicyValue(double policyValue) {
        this.policy_value = policyValue;
    }

    public double getPreviousPolicyValue() {
        return previous_policy_value;
    }

    public void setPreviousPolicyValue(double previousPolicyValue) {
        this.previous_policy_value = previousPolicyValue;
    }

    public double getPolicyScore() {
        return policy_score;
    }

    public void setPolicyScore(double policyScore) {
        this.policy_score = policyScore;
    }

    public double getExpectedResult() {
        return expected_result;
    }

    public void setExpectedResult(double expectedResult) {
        this.expected_result = expectedResult;
    }

    public String getOptimizationIndicator() {
        return optimization_indicator;
    }

    public void setOptimizationIndicator(String optimizationIndicator) {
        this.optimization_indicator = optimizationIndicator;
    }

    public String getSource() {
        return source;
    }

    public void setSource(String source) {
        this.source = source;
    }

    public int getVersion() {
        return version;
    }

    public void setVersion(int version) {
        this.version = version;
    }

    public int getChangePointer() {
        return change_pointer;
    }

    public void setChangePointer(int changePointer) {
        this.change_pointer = changePointer;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public int getHigherLevelPolicyId() {
        return higher_level_policy_id;
    }

    public void setHigherLevelPolicyId(int higherLevelPolicyId) {
        this.higher_level_policy_id = higherLevelPolicyId;
    }

    public double getActualResult() {
        return actual_result;
    }

    public void setActualResult(double actualResult) {
        this.actual_result = actualResult;
    }

    public double getSimulatedResult() {
        return simulated_result;
    }

    public void setSimulatedResult(double simulatedResult) {
        this.simulated_result = simulatedResult;
    }

    public String getLearningMethod() {
        return learning_method;
    }

    public void setLearningMethod(String learningMethod) {
        this.learning_method = learningMethod;
    }
    
    
	@Override
	public String toString() {
		return  
			"policy_id = " + policy_id +" " +
			"agent_id = " + agent_id +" " +
			"policy_name = " + policy_name + " " +
			"policy_type_id = " + policy_type_id + " "+
			"script = " + script + " "+
			"object_type = " + object_type + " "+
			"attribute = " + attribute + " " +
			"policy_value = " + policy_value + " "+
			"previous_policy_value = " + previous_policy_value + " " +
			"policy_score = " + policy_score + " "+
			"expected_result = " + expected_result + " " +
			"optimization_indicator = " + optimization_indicator + " " +
			"scource = " + source + " " +
			"version = " + version + " " +
			"change_pointer = " + change_pointer + " "+
			"status = " + status +" " +
			"higher_level_policy_id = " + higher_level_policy_id +" " +
			"actual_result = " + actual_result +"  " +
			"simulated_result = " + simulated_result +" " +
			"learning_method = " + learning_method + " ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
