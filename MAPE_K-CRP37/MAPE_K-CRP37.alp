		<JavaClass>
			<Id>1748205880282</Id>
			<Name><![CDATA[Execution]]></Name>
			<Text><![CDATA[/**
 * Execution
 */	
public class Execution implements Serializable {

	 int process_id = 0;

	 String process_name = "";

	 String process_type = "";
	 
	 String role = "";

	 String start_event = "";

	 String end_event = "";

	 String event_type = "";

	 int policy = 0;
	 
	 int policy_type_id = 0;
	 
	 String policy_name = "";

	 String object_type = "";

	 String attribute = "";

	 Double value = 0.0;
	 
	 String script = "";
	 
	 Double expected_result = 0.0;
	 
     Date execution_date;
     
     String status;

    /**
     * Default constructor
     */
    public Execution() {
    }

    /**
     * Constructor initializing the fields
     */
    public Execution(int process_id, String process_name, String process_type, String role, String start_event, String end_event, String event_type, int policy, int policy_type_id, String policy_name, String object_type, String attribute, Double value, String script, Double expected_result, Date execution_date, String status) {
		this.process_id = process_id;
		this.process_name = process_name;
		this.process_type = process_type;
		this.role = role;
		this.start_event = start_event;
		this.end_event = end_event;
		this.event_type = event_type;
		this.policy = policy;
		this.policy_type_id = policy_type_id;
		this.policy_name = policy_name;
		this.object_type = object_type;
		this.attribute = attribute;
		this.value = value;
		this.script = script;
		this.expected_result = expected_result;
		this.execution_date = execution_date;
		this.status = status;
    }

    // Getter for Start_Event
    public String getStart_Event() {
        return start_event;
    }  

    // Setter for Start_Event
    public void setStart_Event(String start_event) {
        this.start_event = start_event;
    }    
 
    // Getter for Policy
    public int getPolicy() {
        return policy;
    }  

    // Setter for Policy
    public void setPolicy(int policy) {
        this.policy = policy;
    }      
    
	@Override
	public String toString() {
		return  
			"process_id = " + process_id +" " +
			"process_name = " + process_name +" " +
			"process_type = " + process_type +" " +
			"role = " + role +" " +
			"start_event = " + start_event +" " +
			"end_event = " + end_event +" " +
			"event_type = " + event_type +" " +
			"policy = " + policy +" " +
			"policy_type_id = " + policy_type_id + " " +
			"policy_name = " + policy_name + " "+
			"object_type = " + object_type +" " +
			"attribute = " + attribute +" " +
			"value = " + value +" " +
			"script = " + script +" " +
			"expected_result = " + expected_result + " "+
			"execution_date = " + execution_date +"  "+
			"status = " + status +"  ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
