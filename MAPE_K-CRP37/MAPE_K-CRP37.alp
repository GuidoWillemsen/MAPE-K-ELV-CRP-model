			String status = "New";			
			
			Execution new_process = new Execution(
						process_id,
						process_name,
						process_type,
						role,
						start_event,
						end_event,
						event_type,
						policy,
						policy_type_id,
						policy_name,
						object_type,
						attribute,
						value,
						script,
						expected_result,
						execution_date,
						status);
						
			agent.executionWorkspace.add(new_process);
						
		}
	}
}
