			"policy_id = " + policy_id +" " +
			"expected_result = " + expected_result +" " +
			"actual_result = " + actual_result +" " +
			"optimization_indicator = " + optimization_indicator +" " +
			"evaluationResult = " + evaluationResult +" " +
			"learningMethod = " + learningMethod +" " +
			"needtoLearn = " + needtoLearn +" ";
	}

