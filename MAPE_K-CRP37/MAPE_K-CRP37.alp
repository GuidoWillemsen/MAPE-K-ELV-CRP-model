			<Text><![CDATA[/**
 * Order
 */	
import java.util.UUID; // Import the UUID class

public class Order implements Serializable {

	UUID Sim_id; 
	
	 String Order_id = "";
	 
	 int Cycle_id = 0;
	 
	 String Agent_id = "";
	 
	 String Agent_type = "";

	 String Type;

	 double Quantity;

	 String Partner;

	 String Status;

    /**
     * Default constructor
     */
    public Order() {
    }

    /**
     * Constructor initializing the fields
     */
    public Order(UUID Sim_id, int Cycle_id, String Order_id, String Agent_id, String Agent_type, String Type, double Quantity, String Partner, String Status) {
		this.Sim_id = Sim_id;
		this.Cycle_id = Cycle_id;
    	this.Order_id = Order_id;
		this.Agent_id = Agent_id;
		this.Agent_type = Agent_type;
		this.Type = Type;
		this.Quantity = Quantity;
		this.Partner = Partner;
		this.Status = Status;
    }

	@Override
	public String toString() {
		return  
			"Sim_id = " + Sim_id + " " +
			"Cycle_id = " + Cycle_id +" " +
			"Order_id = " + Order_id +" " +
			"Agent_id = " + Agent_id +" " +
			"Agent_type = " + Agent_type +" " +
			"Type = " + Type +" " +
			"Quantity = " + Quantity +" " +
			"Partner = " + Partner +" " +
			"Status = " + Status +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
