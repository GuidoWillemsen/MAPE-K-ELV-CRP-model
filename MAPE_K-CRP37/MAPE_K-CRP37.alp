				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764763381861</Id>
					<Name><![CDATA[fSelectTrustGroup]]></Name>
					<X>400</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// Clear existing collections
agent.agent_TrustGroups.clear();
agent.selected_TrustGroups.clear();
agent.publish_TrustGroups.clear();

    // Track added trust groups to avoid duplicates
   Set<Integer> addedTrustGroups = new HashSet<>();

// Fetch trust groups for the current agent
List<Tuple> agent_trustGroup = selectFrom(tg_agent)
    .where(tg_agent.agent_id.eq(agent.id))
    .list();

// Populate agent_TrustGroups
for (Tuple row : agent_trustGroup) {
    int trustGroup_Id = row.get(tg_agent.trustgroup_id);
    String trustAgent = row.get(tg_agent.agent_id);
    agent.agent_TrustGroups.add(new trustgroup(trustGroup_Id, trustAgent));
}

// For each workspace policy, find matching trust groups
for (Gesture workspacePolicy : agent.crp_Workspace) {
    if (workspacePolicy == null) continue;

    List<Tuple> selected_TrustGroup = selectFrom(trustgroups)
        .where(
            trustgroups.object_type.eq(workspacePolicy.object_type)
                .and(trustgroups.attribute.eq(workspacePolicy.attribute))
        )
        .list();

    // Track added trust groups to avoid duplicates
//   Set<Integer> addedTrustGroups = new HashSet<>();

    for (Tuple selection : selected_TrustGroup) {
        int tg = selection.get(trustgroups.trustgroup_id);

        // Check if the current agent is in this trust group
        for (trustgroup agentTG : agent.agent_TrustGroups) {
            if (agentTG.trustgroup_id == tg && !addedTrustGroups.contains(tg)) {
                agent.selected_TrustGroups.add(new trustgroup(tg, agent.id));
                addedTrustGroups.add(tg);
                break; // No need to check other agent trust groups for this tg
            }
        }
    }
}

// For each selected trust group, find all agents (excluding self) to publish to
for (trustgroup selectedTG : agent.selected_TrustGroups) {
    List<Tuple> publish_Agents = selectFrom(tg_agent)
        .where(tg_agent.trustgroup_id.eq(selectedTG.trustgroup_id))
        .list();

    for (Tuple p_agent : publish_Agents) {
        String agent_id = p_agent.get(tg_agent.agent_id);
        if (!agent_id.equals(agent.id)) { // Exclude self
            agent.publish_TrustGroups.add(
                new trustgroup(selectedTG.trustgroup_id, agent_id)
            );
        }
    }
}


/*//initalize agent collections


agent.agent_TrustGroups.clear();
agent.selected_TrustGroups.clear();
agent.publish_TrustGroups.clear();
int trustGroup_Id = 0;
String trustAgent = "";
int tg = 0;
String ag = "";
int lastTG = 0;


//select the trustgroups where this active agent is part of

List<Tuple> agent_trustGroup = selectFrom(tg_agent)
   	 .where(tg_agent.agent_id.eq(agent.id))
    	.list();
    	

for (Tuple row : agent_trustGroup) {
    // Process each row

    trustGroup_Id = row.get(tg_agent.trustgroup_id);
    trustAgent = row.get(tg_agent.agent_id);
    trustgroup tgr = new trustgroup (trustGroup_Id, trustAgent);
    
// add agent to active collection of agents
	agent.agent_TrustGroups.add(tgr);


}
//for the scope of the workspace, find the corresponding trustgroups
for (int i = 0; i < agent.crp_Workspace.size(); i++){


  for (int j = 0; j < agent.agent_TrustGroups.size(); j++){//retrieve the trustgroups that belong to the agents policies in the learning workspace
	
		if (agent.crp_Workspace.get(i) != null) {
	
List <Tuple> selected_TrustGroup = selectFrom(trustgroups)
    .where(
        trustgroups.object_type.eq(agent.crp_Workspace.get(i).object_type)
            .and(trustgroups.attribute.eq(agent.crp_Workspace.get(i).attribute))
    )
    .list();

	   	
	for (Tuple selection : selected_TrustGroup) {
	
	boolean new_value = false;
	
//		for (int j = 0; j < agent.agent_TrustGroups.size(); j++){//retrieve the trustgroups that belong to the agents policies in the learning workspace
				

				if (agent.agent_TrustGroups.get(j).trustgroup_id == selection.get(trustgroups.trustgroup_id)){
			
				tg = selection.get(trustgroups.trustgroup_id);
				ag = agent.id;
//		for (int k = 0; k < agent.selected_TrustGroups.size(); k++){
				
//		}

			if (lastTG == tg){
				traceln("Do nothing in Response");
			} else {
				trustgroup selTrust = new trustgroup(tg,ag);
				agent.selected_TrustGroups.add(selTrust);
				lastTG = tg;
			}
		
		}
	  }
	}
   }	
}

for (int i = 0; i < agent.selected_TrustGroups.size(); i++){//retrieve all agents that belong to the selected trustgroups

	if (agent.selected_TrustGroups.get(i) != null){

	List <Tuple> publish_Agents = selectFrom (tg_agent)
		.where(tg_agent.trustgroup_id.eq(agent.selected_TrustGroups.get(i).trustgroup_id))
		.list();

		
for (Tuple p_agent : publish_Agents) {

	int trustgroup_id = p_agent.get(tg_agent.trustgroup_id);
	String agent_id = p_agent.get(tg_agent.agent_id);
	
	if (agent_id != agent.id){ //only add other agents to the publication list
	trustgroup pag = new trustgroup (trustgroup_id, agent_id);
	agent.publish_TrustGroups.add(pag);
	}
	}
  }
}
*/

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764766617187</Id>
					<Name><![CDATA[fSendResponse]]></Name>
					<X>400</X><Y>530</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[

int subject_index = 0;
Gesture tmp_msg = new Gesture();
Subject tmp_receiver = new Subject();
ArrayList agents_In_TG = new ArrayList<>();

//loop through all the responses to publish
for (int i = 0; i < agent.responseList.size(); i++){
 if((agent.responseList.get(i) != null)
 	&& (!agent.responseList.get(i).requestor.equals(agent.id))){


//loop through all the agents that have to be published to
	for (int j = 0; j < agent.publish_TrustGroups.size(); j++){
	
//	boolean isPresent = agents_In_TG.contains(agent.publish_TrustGroups.get(i).agent_id);
	
//	if((agent.publish_TrustGroups.get(j) != null)&& isPresent == false){
	if((agent.publish_TrustGroups.get(j) != null)&& !agent.publish_TrustGroups.get(j).agent_id.equals(agent.id)){
	Gesture add_message_old = new Gesture();
		for (int k = 0; k < main.subject.size(); k++){
			if ((main.subject.get(k).id.equals(agent.publish_TrustGroups.get(j).agent_id))){
				subject_index = k; 
		
		
		String sagent = agent.publish_TrustGroups.get(j).agent_id;
	
	Gesture add_message = new Gesture();
	
	add_message.message_id = agent.responseList.get(i).message_id;

	add_message.policy_id = agent.responseList.get(i).policy_id;
	
	add_message.requestor = agent.responseList.get(i).requestor;

//	add_message.requestor = agent.id;
	
	add_message.policy_name = agent.responseList.get(i).policy_name;
	
	add_message.object_type = agent.responseList.get(i).object_type;

	add_message.attribute = agent.responseList.get(i).attribute;

	add_message.value = agent.responseList.get(i).value;

	add_message.score = agent.responseList.get(i).score;
	
//	add_message.source = agent.responseList.get(i).source;	

	add_message.source = agent.id;

	add_message.status = "Published";
	
 if ((add_message.object_type.equals(agent.responseList.get(i).object_type))
 	&& (add_message.attribute.equals(agent.responseList.get(i).attribute))){//7	 
		
	if (add_message_old.message_id != add_message.message_id){
	if (main.subject.get(subject_index).crp_Workspace != null &&
    !main.subject.get(subject_index).crp_Workspace.isEmpty()){
  
 
    
    	boolean addCRP = false;//initialize the parameter to add a record to the local CRP workspace of the agent

		for (int m = 0; m < (main.subject.get(subject_index).crp_Workspace.size()); m++){

		if (main.subject.get(subject_index).crp_Workspace.get(m).policy_id != add_message.policy_id
			&& main.subject.get(subject_index).crp_Workspace.get(m).requestor.equals(main.subject.get(k).id)){
			addCRP = true;	
			}
			}
		if (addCRP == true){
			main.subject.get(subject_index).crp_Workspace.add(add_message);//add this gesture to all related agents in the CRP workspace
	
			agents_In_TG.add(agent.publish_TrustGroups.get(j).agent_id);			
		}
	} else {	
// add when no CRP Workspace for other agent exists
			main.subject.get(subject_index).crp_Workspace.add(add_message);//add this gesture to all related agents in the CRP workspace
	
			agents_In_TG.add(agent.publish_TrustGroups.get(j).agent_id);
	}
		
	}
	add_message_old = add_message; //keep this record for the The previous process is already processed sequence
	} else {//7
		traceln("No relevant object types have to be requested");
	}//7
	}
	}
	}
	}
  }		
 }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1764766672064</Id>
					<Name><![CDATA[fDefineResponse]]></Name>
					<X>400</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[ 
agent.responseList.clear();//initialize the response list

for (int i = 0; i< agent.crp_Workspace.size(); i++){

if ((!agent.crp_Workspace.get(i).requestor.equals(agent.id)) 
	&& (agent.crp_Workspace.get(i).status.equals("Requested"))){
	
// find the highest score of the policy in the agents table.
	
	List<Tuple> highest_policy = selectFrom(policy)
	.orderBy(policy.score.desc())
	.where(policy.agent_id.eq(agent.id))
	.where(policy.object_type.eq(agent.crp_Workspace.get(i).object_type))
	.where(policy.attribute.eq(agent.crp_Workspace.get(i).attribute))
	.list();
	
	for (Tuple hp_record : highest_policy) {
	
	Gesture applyResponse = new Gesture();
	String uuid = java.util.UUID.randomUUID().toString();
	
	applyResponse.message_id = uuid;
	applyResponse.requestor = agent.crp_Workspace.get(i).requestor;
	applyResponse.policy_id = agent.crp_Workspace.get(i).policy_id;
	applyResponse.policy_name = agent.crp_Workspace.get(i).policy_name;
	applyResponse.object_type = agent.crp_Workspace.get(i).object_type;
	applyResponse.attribute = agent.crp_Workspace.get(i).attribute;
	applyResponse.value = agent.crp_Workspace.get(i).value;
	applyResponse.score = agent.crp_Workspace.get(i).score;
//	applyResponse.source = agent.crp_Workspace.get(i).source;
	applyResponse.source = agent.id;
	applyResponse.status = "Published";
	
	// Add the Response object to the ArrayList
    agent.responseList.add(applyResponse);

	break;

   }
   agent.crp_Workspace.get(i).status = "Published";
  }
}
if (agent.responseList.isEmpty()){
	traceln ("No CRP messages selected");
	agent.noCRPPossible = true;
	}]]></Body>
