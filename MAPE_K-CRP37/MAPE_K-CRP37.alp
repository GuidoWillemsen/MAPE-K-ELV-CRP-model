				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735777</Id>
					<Name><![CDATA[fGetEventCollector]]></Name>
					<X>530</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[/* This function checks the last event index that has been
   checked in the main.ActualEvents collection
 and gathers all event_id numbers in ActualEvent that have
 larger index than
 LastIndex --> Those event_id numbers are put in the
 agent's specific collection named ActualEvents_New
/* Select the event collector that is required for this specific agent
and then select the event */

/* first the total number of records are counted and stored in the counter
 that is used to loop the collection. As the collection records could be removed, the counter will be corrected (incl the i value)*/
int counter = agent.eventWorkspace.size();

for (int i = 0; i < counter; i++) {

agent.eventWorkspace.get(i).deletion_indicator = false;//reset indicator
// For each actual event retrieve the even collectors that are applicable and mark the records that are not collected
List<String> selectedCollector = selectFrom(event_collector)
	.where(event_collector.event_type.eq(agent.eventWorkspace.get(i).event_type).and(event_collector.agent_id.eq(agent.id)))
	.list(event_collector.event_type);

// check if there is a collector, then only write this to the log
	 if (selectedCollector != null && !selectedCollector.isEmpty()){
		if (selectedCollector.equals(agent.eventWorkspace.get(i).event_type)){
			traceln("Event collected: "+selectedCollector); 
		}
	} else {
//no collector found, so the record should be removed from the event workspace
 			agent.eventWorkspace.remove(i);
 			counter = counter-1;
 			i = i-1;
	 } 

 }
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735780</Id>
					<Name><![CDATA[fCollectEvent]]></Name>
					<X>530</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[
//retrieve all events which are place in the Actual Events blackboard
for (int i = 0; i < main.ActualEvents.size(); i++) {
	if (main.ActualEvents.get(i).included == true 
		&& main.ActualEvents.get(i).agent_id == agent.id){
	
try {	
	int retrieved_policy = selectFirstValue(
			"SELECT process_repository.policy_id FROM process_repository WHERE process_repository.event_type = ? AND process_repository.agent_id = ?", 
			main.ActualEvents.get(i).event_type, agent.id);
	 
	Events add_events = new Events();
	
	add_events.event_id = main.ActualEvents.get(i).event_id;

	add_events.event_name = main.ActualEvents.get(i).event_name;

	add_events.event_type = main.ActualEvents.get(i).event_type;
	
	add_events.policy_id = retrieved_policy;
	
	add_events.actual_result = main.ActualEvents.get(i).actual_result;
	
	add_events.included = main.ActualEvents.get(i).included;
	
		
 	agent.eventWorkspace.add(add_events);
 	
 	} catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No policy found");
    }
 	}
}

							]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735782</Id>
					<Name><![CDATA[fGetEventNormalizer]]></Name>
					<X>530</X><Y>730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// This function selects the normalizer that is applicable
// for the specific agent type (as given in the Normalizer
// table).
List<Events> all_added_records = new ArrayList<>();
List<Events> all_removed_records = new ArrayList<>();
List<Events> tempEventWorkspace = new ArrayList<>();


int counter = agent.eventWorkspace.size(); // as records to the eventWorkspace are added, the original scope is fixed in the counter

for (int i = 0; i < counter; i++) {


// For each actual event retrieve the even normalizer ids that are applicable and place them in a temporary table
try {

List<Integer> selectedNormalizer = selectFrom(event_normalizer)
	.where(event_normalizer.event_id.eq(agent.eventWorkspace.get(i).event_id).and(event_normalizer.agent_id.eq(agent.id)))
	.list(event_normalizer.normalized_event);

    boolean new_record = false;
    
	for (Integer normalizer : selectedNormalizer){
	 if (new_record == false){ 
	traceln("Selected event before normalization: "+agent.eventWorkspace.get(i).event_id);
	agent.eventWorkspace.get(i).normalized_event = String.valueOf(agent.eventWorkspace.get(i).event_id);
	agent.eventWorkspace.get(i).event_id = normalizer;	
	traceln("Normalized event replaced: "+agent.eventWorkspace.get(i).event_id);
	new_record = true;

	} else {
	new_record = true;
	traceln("Selected event before normalization: "+agent.eventWorkspace.get(i).event_id);
	Events add_new_record = (Events)agent.eventWorkspace.get(i);
	add_new_record.normalized_event = String.valueOf(agent.eventWorkspace.get(i).event_id);
	add_new_record.event_id = normalizer;
	
	all_added_records.add(add_new_record);
	traceln("Normalized event replaced: "+agent.eventWorkspace.get(i).event_id);
	    }
	   }
	   
	 } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No normalizer found");
    }
  }
  for (int j = 0; j < all_added_records.size(); j++){
      agent.eventWorkspace.add(all_added_records.get(j));
	} 




	
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735784</Id>
					<Name><![CDATA[fTransformEvent]]></Name>
					<X>530</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[/* This function will transform the source event based on
 the Event Normalizer table mapping and will store the
 transformed events into the Event Workspace collection.
 This method is not relevant as the step was already completed 
 in the GetEvenNormalizer method */
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735786</Id>
					<Name><![CDATA[fGetEventFilter]]></Name>
					<X>530</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// This function retrieves the relevant filter ID for the
// specific agent type

//as the collection records can be removed, first the counter is stored(and after removal of the record corrected)


for (int i = 0; i < agent.eventWorkspace.size(); i++) {

// For each actual event retrieve the even filter ids that are applicable and place them in a temporary table
List<Integer> selectedFilter = selectFrom(event_filter)
	.where(event_filter.event_id.eq(agent.eventWorkspace.get(i).event_id).and(event_filter.agent_id.eq(agent.id)))
	.list(event_filter.event_id);
	

	for (Integer eventFilter : selectedFilter){
		traceln("Events to be filtered: "+eventFilter);
		agent.eventWorkspace.get(i).deletion_indicator = true;
	}
}

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735788</Id>
					<Name><![CDATA[fDiscardEvent]]></Name>
					<X>530</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[/* This function has been combined with the GetEventFilter method.
So no further action is needed*/

int counter = agent.eventWorkspace.size();

for (int i = 0; i < agent.eventWorkspace.size(); i++) {

// Retrieve the list of policy IDs
List<Integer> selectedPolicyAgent = selectFrom(policy)
    .where(policy.attribute.eq(String.valueOf(agent.eventWorkspace.get(i).policy_id))
    .and(policy.agent_id.eq(agent.id)))
    .list(policy.policy_id);

// Iterate over each policy ID to retrieve the status

boolean all_inactive = true; // boolean value which is set to false as soon as there is one active policy

for (Integer policyId : selectedPolicyAgent) {
    try {
        String selectedPolicyStatus = selectUniqueValue(
            "SELECT policy.status FROM policy WHERE policy.policy_id = ? AND policy.agent_id = ?",
            policyId, agent.id
        );

        if (selectedPolicyStatus == null) {
            // Handle the case where no status is found
            System.out.println("No status found for policy ID: " + policyId);				
            agent.eventWorkspace.get(i).deletion_indicator = true;
		} else {
            // Proceed with the selectedPolicyStatus
            System.out.println("Status for policy ID " + policyId + ": " + selectedPolicyStatus);
       // remove events with an inactive policy	
       		
			}
			if (selectedPolicyStatus.equals("Active")){
			all_inactive = false;
			}
    } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        System.err.println("An error occurred while retrieving the policy status for policy ID " + policyId + ": " + e.getMessage());
    }

  }
  	if (all_inactive == true){//remove and event without active policies
  		agent.eventWorkspace.get(i).deletion_indicator = true;
	}
}
			//remove all records from the Event Workspace that have an active deletion indicator

for (int j = 0; j < counter; j++) {
	if (agent.eventWorkspace.get(j).deletion_indicator == true){
		agent.eventWorkspace.remove(j);
		j--;
		counter--;
	}
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735790</Id>
					<Name><![CDATA[fGetEventMask]]></Name>
					<X>730</X><Y>710</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// This function retrieves the relevant mask ID for the
// specific agent type an removed the masked records from the workspace

//as the collection records can be removed, first the counter is stored(and after removal of the record corrected)
int counter = agent.eventWorkspace.size();

for (int i = 0; i < counter; i++) {

// For each actual event retrieve the even mask ids that are applicable and place them in a temporary table
List<Integer> selectedMask= selectFrom(event_mask)
	.where(event_mask.event_id.eq(agent.eventWorkspace.get(i).event_id).and(event_mask.agent_id.eq(agent.id)))
	.list(event_mask.event_id);
	

	for (Integer eventMask : selectedMask){
		traceln("Events to be masked: "+eventMask);
		agent.eventWorkspace.remove(i);
// correct the counter an i value as a record has been removed
		counter = counter - 1;
		i = i - 1;
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735792</Id>
					<Name><![CDATA[fIgnoreEvent]]></Name>
					<X>730</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[// This function removes all events in the Event Workspace
// collection that are recorded in the Event Mask table.
try{
	List<Integer> events_list = selectValues(
		"SELECT event_mask.event_id FROM event_mask WHERE event_mask.mask_id = ?",
		agent.maskID);

		traceln("Event workspace size @ignore event: " +events_list.size());
		traceln("Mask id: "+agent.maskID);
		traceln("Agent id: "+agent.id);
		agent.eventWorkspace.removeAll(events_list);

	 } catch (Exception e) {
        // Handle any exceptions that may occur during the query execution
        traceln("No mask found");
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735794</Id>
					<Name><![CDATA[fMergeDuplicates]]></Name>
					<X>730</X><Y>770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[Integer previous_event = 0;

int counter = agent.eventWorkspace.size();

for (int i = 0; i < counter; i++) {


if (previous_event == (agent.eventWorkspace.get(i).event_id)){
	previous_event = agent.eventWorkspace.get(i).event_id;

	agent.eventWorkspace.get(i).deletion_indicator = true;
	} else {
	 previous_event = agent.eventWorkspace.get(i).event_id;
 	}
} 

for (int i = 0; i < counter; i++) {

if (agent.eventWorkspace.get(i).deletion_indicator == true){
	agent.eventWorkspace.remove(i);
	counter--;
	i--;
  }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1719864735796</Id>
					<Name><![CDATA[fInferSymptom]]></Name>
					<X>730</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("Event workspace size @infersymptom: " +agent.eventWorkspace.size());

for (int i = 0; i < agent.eventWorkspace.size(); i++) {
agent.noSymptom = true;
List<Integer> selectedSymptom = selectFrom(event_symptom)
	.where(event_symptom.event_id.eq(agent.eventWorkspace.get(i).event_id).and(event_symptom.agent_id.eq(agent.id)))
	.list(event_symptom.symptom_id);


	for (Integer symptom : selectedSymptom){
	agent.eventWorkspace.get(i).symptom_id = symptom;	
	traceln("Symptom added: "+agent.eventWorkspace.get(i).symptom_id);
	agent.noSymptom = false;
	traceln("Symptom found");
	}
//	return;
}]]></Body>
				</Function>
