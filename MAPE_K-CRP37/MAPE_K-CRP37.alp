			<StartupCode><![CDATA[deleteFrom(changelog).execute();
int sel_c = 0;//selected consumers
int sel_r = 0; //selected retailers
int sel_w = 0; //selected wholesalers
int sel_d = 0;//selected distributors
int sel_p = 0;//selected producers

int sequence_counter_at1 = 0;
int sequence_counter_at2 = 0;
int sequence_counter_at3 = 0;
int sequence_counter_at4 = 0;
int sequence_counter_at5 = 0;

Subject sel_agent = null;

//pCount_run = 36;//check to make dynamic

/*for (int i = 0; i < subject.size(); i++) {
   if (this.subject.get(i).type != null){
    if (this.subject.get(i).type.equals("AT1")){
        	subject.get(i).sequence = 100 + sequence_counter_at1;
    		sequence_counter_at1++;
    } else if (this.subject.get(i).type.equals("AT2")){
    		subject.get(i).sequence = 100 + sequence_counter_at2;
    		sequence_counter_at2++;
    } else if (this.subject.get(i).type.equals("AT3")){
    		subject.get(i).sequence = 100 + sequence_counter_at3;
    		sequence_counter_at3++;
    } else if (this.subject.get(i).type.equals("AT4")){
    		subject.get(i).sequence = 100 + sequence_counter_at4;
    		sequence_counter_at4++;         		            
   	} else if (this.subject.get(i).type.equals("AT5")){
    		subject.get(i).sequence = 100 + sequence_counter_at5;
    		sequence_counter_at5++;   	    
   	} else {
    	traceln(" No agent found in subject table");
    	}
    }
  }*/

for (int i = 0; i < this.subject.size(); i++) {
    if (this.subject.get(i).type == null){
    		traceln("Null value");
     } else if (this.subject.get(i).type.equals("AT1")){
    		this.subject.get(i).sequence = 1;    		      
    } else if (this.subject.get(i).type.equals("AT2")){
    		this.subject.get(i).sequence = 2; 
    } else if (this.subject.get(i).type.equals("AT3")){
    		this.subject.get(i).sequence = 3;
    } else if (this.subject.get(i).type.equals("AT4")){
    		this.subject.get(i).sequence = 4;
    } else if (this.subject.get(i).type.equals("AT5")){
    		this.subject.get(i).sequence = 5;
    } else {
    		traceln("No sequence needs to be added");
    }
   } 
    		    		    		    		    		
//sort agent list based on agent type
List<Subject> sortedByTypeAsc = sortAscending( this.subject, s -> s.sequence );
 

//add agents according to the slider value in the simulation environment

/*for (Subject s : sortedByTypeAsc){
	if (s.getSequence() == 1){
	selected_agent = s;
	enter.take(sel_agent);
	sel_c++;
	selectedAgents.add(sel_agent);	
	}
	}
*/
for (int i = 0; i < sortedByTypeAsc.size(); i++) {
   if (sortedByTypeAsc.get(i).type != null){
    if (sortedByTypeAsc.get(i).type.equals("AT1")){
    	if (sel_c < this.pCount_c){
    		enter.take(sortedByTypeAsc.get(i));
    		sel_c++;
    		selectedAgents.add(sortedByTypeAsc.get(i));
   
    	  }
    	}
      }
    } 
    
for (int i = 0; i < sortedByTypeAsc.size(); i++) {
   if (sortedByTypeAsc.get(i).type != null){
    if (sortedByTypeAsc.get(i).type.equals("AT2")){  
    	 if (sel_r < this.pCount_r){
    		enter.take(sortedByTypeAsc.get(i));
    		sel_r++;
    		selectedAgents.add(sortedByTypeAsc.get(i));
    		}
    } 
   }
  }
  
for (int i = 0; i < sortedByTypeAsc.size(); i++) {
   if (sortedByTypeAsc.get(i).type != null){
    if (sortedByTypeAsc.get(i).type.equals("AT3")){
    	 if (sel_w < this.pCount_w){
    		enter.take(sortedByTypeAsc.get(i));
    		sortedByTypeAsc.get(i).active = true;
    		selectedAgents.add(sortedByTypeAsc.get(i));
    		sel_w++;
    	 }	
    	}
       }
      }

for (int i = 0; i < sortedByTypeAsc.size(); i++) {
   if (sortedByTypeAsc.get(i).type != null){
    if (sortedByTypeAsc.get(i).type.equals("AT4")){
    	 if (sel_d < this.pCount_d){
    		enter.take(sortedByTypeAsc.get(i));
    		selectedAgents.add(sortedByTypeAsc.get(i));
    		sel_d++;
    	  }
    	}
       }
    }
    
for (int i = 0; i < sortedByTypeAsc.size(); i++) {
   if (sortedByTypeAsc.get(i).type != null){
    if (sortedByTypeAsc.get(i).type.equals("AT5")){ 
	   	if (sel_p < this.pCount_p){
    		enter.take(sortedByTypeAsc.get(i));
    		selectedAgents.add(sortedByTypeAsc.get(i));
    		sel_p++;
    	  }
    	 }
    	}
      }

count_agents = sel_c + sel_r + sel_w + sel_d + sel_p; //define # agents




deleteFrom(db_beergame_results).execute();

//define highest sequence number for agents
int highestSeq = 0; //define the highest sequence number for agents
for (int i = 0; i < subject.size(); i++){
	if (subject.get(i).sequence > highestSeq){
		highestSeq = subject.get(i).sequence;
	}
}

vHighestSeq = highestSeq;


//initialize active agents as not selected. It will be selected again when the agents are activated

update(agents)
  .set(agents.selected, false)
  .execute();]]></StartupCode>
