     */
    public BeerGame_Results(String agent_id, String agent_type, String i, int t, String order_id, double sat, double mdt, double st, double plt, double wsl, double θ, int I_des, double SL_des, double uihc_i, double ubc_i, int ENDCD, double EECD, double EO, int B, int I, int ITI1, int ITI2, int WIPI1, int WIPI2, int O, int PSR, int S, int IO, double TC, double uihc, double ubc, int SL, double SLA, int EI, double IA, String Status, String Sim_id, int TI) {
		this.agent_id = agent_id;
		this.agent_type = agent_type;
		this.i = i;
		this.t = t;
		this.order_id = order_id;
		this.sat = sat;
		this.mdt = mdt;
		this.st = st;
		this.plt = plt;
		this.wsl = wsl;
		this.θ = θ;
		this.I_des = I_des;
		this.SL_des = SL_des;
		this.uihc_i = uihc_i;
		this.ubc_i = ubc_i;
		this.ENDCD = ENDCD;
		this.EECD = EECD;
		this.EO = EO;
		this.B = B;
		this.I = I;
		this.ITI1 = ITI1;
		this.ITI2 = ITI2;
		this.WIPI1 = WIPI1;
		this.WIPI2 = WIPI2;
		this.O = O;
		this.PSR = PSR;
		this.S = S;
		this.IO = IO;
		this.TC = TC;
		this.uihc = uihc;
		this.ubc = ubc;
		this.SL = SL;
		this.SLA = SLA;
		this.EI = EI;
		this.IA = IA;
		this.Status = Status;
		this.Sim_id = Sim_id;
		this.TI = TI;
    }

	@Override
	public String toString() {
		return  
			"agent_id = " + agent_id +" " +
			"agent_type = " + agent_type +" " +
			"i = " + i +" "+	
			"t = " + t +" " +
			"order_id = " + order_id + " " +
			"sat = " + sat +" " +
			"mdt = " + mdt +" " +
			"st = " + st +" " +
			"plt = " + plt +" " +
			"wsl = " + wsl +" " +
			"θ = " + θ +" " +
			"I_des = " + I_des +" " +
			"SL_des = " + SL_des +" " +
			"uihc_i = " + uihc_i +" " +
			"ubc_i = " + ubc_i +" " +
			"ENDCD = " + ENDCD +" " +
			"EECD = " + EECD +" " +
			"EO = " + EO +" " +
			"B = " + B +" " +
			"I = " + I +" " +
			"ITI1 = " + ITI1 +" " +
			"ITI2 = " + ITI2 +" " +
			"WIPI1 = " + WIPI1 +" " +
			"WIPI2 = " + WIPI2 +" " +
			"O = " + O +" " +
			"PSR = " + PSR +" " +
			"S = " + S +" " +
			"IO = " + IO +" " +
			"TC = " + TC +" " +
			"uihc = " + uihc +" " +
			"ubc = " + ubc +" " +
			"SL = " + SL +" " +
			"SLA = " + SLA +" " +
			"EI = " + EI +" " +
			"IA = " + IA +" " +
			"Status = " + Status + " "+
			"Sim_id = " + Sim_id + " " +
			"TI = " + TI + " " ;
	}

	
	public String getOrder_id() {
	       return order_id;
	    }
	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
