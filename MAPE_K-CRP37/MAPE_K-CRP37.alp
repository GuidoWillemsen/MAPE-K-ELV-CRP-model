								<Code><![CDATA[agent.I = pStartInventory;//initialize start stock
agent.uihc_i = 0.5;//[25] Fixed costs (could be made adaptive) 
agent.ubc_i = 1.0;//[26] Fixed costs (could be made adaptive)
agent.active = true;
vNextAgent = 5 ;//start with the highest agent type


update(agents)
  .where(agents.agent_id.eq(agent.id))
  .set(agents.selected, true)
  .execute();
  
/*for (int i = 0; i < policy.size(); i++){
	if (policy.get(i).agent_id.equals(agent.id)){
