}
//add the incoming order for the next cycle
} else {
if (newResult == true){
 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 

 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&& (this.main.cBeerGameSim.get(k).t == agent.vN)){//CHANGE was +1 CHECK NEXT TIME
 	this.main.cBeerGameSim.get(k).order_id = agent.order_id_sim;
	this.main.cBeerGameSim.get(k).IO = agent.IO_sim;
	this.main.cBeerGameSim.get(k).ENDCD = agent.ENDCD_sim;
 	this.main.cBeerGameSim.get(k).Status = "Processed";
 	existingResult = true;
	}
}
