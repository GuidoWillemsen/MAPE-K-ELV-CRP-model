				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750414455008</Id>
					<Name><![CDATA[fRetrieveAvg]]></Name>
					<X>90</X><Y>870</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//initialize variables
vstw = 0;
vstd = 0;
vstf = 0;
int counter_st = 0;//counter can be generic as this loops for 1 agent which is always of the same type

if (vSim_id != null){//for simulation)
	if (agent.type.equals("AT3")){//average wholesaler values)
		if (agent.simulationWorkspace.get(agent.ei).attribute.equals("st")){
			counter_st++;//increase st counter
			vstw = (vstw + agent.simulationWorkspace.get(agent.ei).policy_value)/counter_st;//
		}
	} else if (agent.type.equals("AT4")){//average wholesaler values)
		if (agent.simulationWorkspace.get(agent.ei).attribute.equals("st")){
			counter_st++;//increase st counter
			vstd = (vstd + agent.simulationWorkspace.get(agent.ei).policy_value)/counter_st;//
		}
	} else if (agent.type.equals("AT5")){//average wholesaler values)
		if (agent.simulationWorkspace.get(agent.ei).attribute.equals("st")){
			counter_st++;//increase st counter
			vstf = (vstf + agent.simulationWorkspace.get(agent.ei).policy_value)/counter_st;//
		}
	} else {
	traceln("No average value should be counteed");
		}


} else {

//calculate average values to enable anonymous supplier)
for (int i = 0;i < agent.executionWorkspace.size(); i++){
	if (agent.type.equals("AT3")){//average wholesaler values)
		if (agent.executionWorkspace.get(i).attribute.equals("st")){
			counter_st++;//increase st counter
			vstw = (vstw + agent.executionWorkspace.get(i).value)/counter_st;//
		}
	} else if (agent.type.equals("AT4")){//average wholesaler values)
		if (agent.executionWorkspace.get(i).attribute.equals("st")){
			counter_st++;//increase st counter
			vstd = (vstd + agent.executionWorkspace.get(i).value)/counter_st;//
		}
	} else if (agent.type.equals("AT5")){//average wholesaler values)
		if (agent.executionWorkspace.get(i).attribute.equals("st")){
			counter_st++;//increase st counter
			vstf = (vstf + agent.executionWorkspace.get(i).value)/counter_st;//
		}
	} else {
	traceln("No average value should be counteed");
		}
	}
}		]]></Body>
