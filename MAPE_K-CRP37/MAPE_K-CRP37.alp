		<JavaClass>
			<Id>1737576614089</Id>
			<Name><![CDATA[SimResults]]></Name>
			<Text><![CDATA[/**
 * SimResults
 */	
public class SimResults implements Serializable {

	int sim_cycle = 0;
	
	String sim_id = "";
	
	String start_event = "";
	
	int sequence = 0;
	
	String execute_process = "";
	
	String end_event = "";

	 int policy_id;
	 
	 String agent_id;
	 
	 String agent_type;
	 
	 String policy_name;
	 
	 int policy_type_id;
	 
	 String script;
	 
	 String object_type;
	 
	 String attribute;
	 
	 double policy_value;
	 
	 double previous_policy_value;
	 
	 double policy_score; 
	 
	 double expected_result;
	 
	 String optimization_indicator;
	 
	 String source;
	 
	 int version;
	 
	 int change_pointer;
	 
	 String status;

	 int higher_level_policy_id;

	 double actual_result;

	 double simulated_result;
	 
	 String learning_method;


    /**
     * Default constructor
     */
    public SimResults() {
    }

    /**
     * Constructor initializing the fields
     */
    public SimResults(int sim_cycle, String sim_id, String start_event, int sequence, String execute_process, String end_event, int policy_id, String agent_id, String agent_type, String policy_name, int policy_type_id, String script, String object_type, String attribute, double policy_value, double previous_policy_value, double policy_score, double expected_result, String optimization_indicator, String source, int version, int change_pointer, String status, int higher_level_policy_id, double actual_result, double simulated_result, String learning_method) {
		this.sim_cycle = sim_cycle;
    	this.sim_id = sim_id;
    	this.start_event = start_event;
    	this.sequence = sequence;
		this.execute_process = execute_process;
		this.end_event = end_event;
		this.policy_id = policy_id;
    	this.agent_id = agent_id;
    	this.agent_type = agent_type;
		this.policy_name = policy_name;
		this.policy_type_id = policy_type_id;
		this.script = script;
		this.object_type = object_type;
		this.attribute = attribute;
		this.policy_value = policy_value;
		this.previous_policy_value = previous_policy_value;
		this.policy_score = policy_score;
		this.expected_result = expected_result;
		this.optimization_indicator = optimization_indicator;
		this.source = source;
		this.version = version;
		this.change_pointer = change_pointer;
		this.status = status;
		this.higher_level_policy_id = higher_level_policy_id;
		this.actual_result = actual_result;
		this.simulated_result = simulated_result;
		this.learning_method = learning_method;
    }

	@Override
	public String toString() {
		return  
				"sim_cycle = " + sim_cycle + " " +
				"sim_id = " + sim_id + " " +
				"start_event = " + start_event +" "+
				"sequence = " + sequence +" " +
				"execute_process = " + execute_process + " " +
				"end_event = " + end_event + " " +
				"policy_id = " + policy_id +" " +
				"agent_id = " + agent_id +" " +
				"agent_type = " + agent_type +" " +
				"policy_name = " + policy_name + " " +
				"policy_type_id = " + policy_type_id + " "+
				"script = " + script + " "+
				"object_type = " + object_type + " "+
				"attribute = " + attribute + " " +
				"policy_value = " + policy_value + " "+
				"previous_policy_value = " + previous_policy_value + " " +
				"policy_score = " + policy_score + " "+
				"expected_result = " + expected_result + " " +
				"optimization_indicator = " + optimization_indicator + " " +
				"scource = " + source + " " +
				"version = " + version + " " +
				"change_pointer = " + change_pointer + " "+
				"status = " + status +" " +
				"higher_level_policy_id = " + higher_level_policy_id +" " +
				"actual_result = " + actual_result +"  " +
				"simulated_result = " + simulated_result +" " +
				"learning_method = " + learning_method + " ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
