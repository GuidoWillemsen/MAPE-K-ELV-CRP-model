					</Parameter>
					<Body><![CDATA[if (vSimAgentType.equals("AT1")){
	agent.B_simAT1 = agent.B_sim;
	agent.I_simAT1 = agent.I_sim;
	agent.IO_simAT1 = agent.IO_sim;
	agent.ENDCD_simAT1 = agent.ENDCD_sim;
	agent.EECD_simAT1 = agent.EECD_sim;
	agent.O_simAT1 = agent.O_sim;
} else if (vSimAgentType.equals("AT2")){
	agent.B_simAT2 = agent.B_sim;
	agent.I_simAT2 = agent.I_sim;
	agent.IO_simAT2 = agent.IO_sim;
	agent.ENDCD_simAT2 = agent.ENDCD_sim;
	agent.EECD_simAT2 = agent.EECD_sim;
	agent.O_simAT2 = agent.O_sim;
} else if (vSimAgentType.equals("AT3")){
	agent.B_simAT3 = agent.B_sim;
	agent.I_simAT3 = agent.I_sim;
	agent.IO_simAT3 = agent.IO_sim;	
	agent.O_simAT3 = agent.O_sim;
} else if (vSimAgentType.equals("AT4")){
	agent.B_simAT4 = agent.B_sim;
	agent.I_simAT4 = agent.I_sim;
	agent.IO_simAT4 = agent.IO_sim;
	agent.O_simAT4 = agent.O_sim;
} else if (vSimAgentType.equals("AT5")){
	agent.B_simAT5 = agent.B_sim;
	agent.I_simAT5 = agent.I_sim;
	agent.IO_simAT5 = agent.IO_sim;	
	agent.O_simAT5 = agent.O_sim;
}
]]></Body>
