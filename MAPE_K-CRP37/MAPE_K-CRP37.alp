	}
  }	
}	// end of goods receipt	

//add the parameters to the results table
if (newResult == true){

 for (int k = 0 ; k < this.main.cBeerGameSim.size();k++){
 
 if (this.main.cBeerGameSim.get(k).agent_id.equals(main.validate.vSimAgent)
 	&&this.main.cBeerGameSim.get(k).t == agent.vN){
		this.main.cBeerGameSim.get(k).I = agent.I_sim;
//		this.main.cBeerGameResults.get(k).ITI1 = agent.ITI1;
		this.main.cBeerGameSim.get(k).ITI2 = agent.ITI2_sim;
//		this.main.cBeerGameResults.get(k).WIPI1 = agent.WIPI1;
//		this.main.cBeerGameResults.get(k).WIPI2 = agent.WIPI2;
		this.main.cBeerGameSim.get(k).Status = "Goods Received";
	}
  }
 } 	

//calcluate values
