				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758571028471</Id>
					<Name><![CDATA[fCalculateTotalResult]]></Name>
					<X>160</X><Y>1020</Y>
					<Label><X>5</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[int I = 0;
int B = 0;
agent.TTCagentSim = 0;//reset total cost per agent
agent.TCSim = 0;//reset sub total cost per agent

String agent_type = selectFirstValue(
		"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?", 
		agent.id);	
if (!agent_type.equals("AT1")
	&&agent.vCycle_id > 0){//not for consumers


for (int i = 0; i < this.main.cBeerGameSim.size(); i++){
	if (this.main.cBeerGameSim.get(i).agent_id.equals(agent.id)){
		I = this.main.cBeerGameSim.get(i).I;
		B = this.main.cBeerGameSim.get(i).B;


agent.TCSim = agent.uihc_i * I + agent.ubc_i * B;//[69] Calculate Total cost for this agent

agent.TTCagentSim = agent.TTCagentSim + agent.TCSim;
 }
}
}
int guido = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1762378212860</Id>
					<Name><![CDATA[fFillSimulationWorkspaceAll]]></Name>
					<X>160</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Subject]]></Type>
					</Parameter>
					<Body><![CDATA[//Initialize simulationWorkspaceInit
	agent.simulationWorkspace.clear();
	agent.simulationWorkspaceInit.clear();
	agent.simulationWorkspaceLog.clear();                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             

	List<Tuple> processes = selectFrom(policy)
	.where(policy.policy_type_id.eq(0)
	.and(policy.default_policy.isTrue()))
	.list();


 for (Tuple aproc : processes){


	SimResults aprocess = new SimResults(
		
	0,//sim_cycle
	"",//sim_id
	"",//start_event
	0,//sequence
	"",//execute_process
	"",//end_event
	aproc.get(policy.policy_id),//policy_id
  	aproc.get(policy.agent_id),//agent_id
  	"",//agent_type
  	aproc.get(policy.policy_name),//policy_name
  	aproc.get(policy.policy_type_id),//policy_type_id
  	aproc.get(policy.script),//script
  	aproc.get(policy.object_type),//object_type
  	aproc.get(policy.attribute),//attribute
  	aproc.get(policy.policy_value),//policy_value
  	aproc.get(policy.previous_policy_value),//previous_policy_value
  	aproc.get(policy.score),//policy_score
  	aproc.get(policy.expected_result),//expected_result
  	aproc.get(policy.optimization_indicator),//optimization_indicator
  	aproc.get(policy.source),//source
  	aproc.get(policy.version),//version
  	aproc.get(policy.change_pointer),//change pointer
 	aproc.get(policy.status),//status
 	aproc.get(policy.higher_level_policy_id),//higher_level_policy_id
  	aproc.get(policy.actual_result),//actual_result
  	aproc.get(policy.simulated_result),//simulated_result
  	aproc.get(policy.learning_method)//learning_method
  	);
  	aprocess.agent_type = 	selectFirstValue(
    		"SELECT agents.agent_type FROM agents WHERE agents.agent_id = ?",
    		aprocess.agent_id
    	);
  	agent.vExpectedResult = aprocess.expected_result;//write the expected result for this policy to the agent for later analysis. As all poliies for this process have the same result, the last entry is ok
  	agent.simulationWorkspaceInit.add(aprocess);
  	
	}


//sort execution workspace

Comparator<SimResults> simSorting = new Comparator<SimResults>() {
    @Override
     public int compare(SimResults s1, SimResults s2) {
		int simComparison = s2.agent_type.compareTo(s1.agent_type);//descendng sorting
        if (simComparison != 0) {
        	
        return simComparison;
    }
// If agent types are equal, compare sequence
        int sequenceComparison = Integer.compare(s1.sequence, s2.sequence);
        if (sequenceComparison != 0) {
            return sequenceComparison;
        }
    
		return 0;
	  }
	};

// Sort the list using the comparator
	agent.simulationWorkspaceInit.sort(simSorting);



 agent.sli = -1;//initialize the SLI index that loops over the full simulation workspace to simulate all results
 agent.ai = -1;//initialize the AI index that loops over the simulation workspace for analysis and (de_activation of the policies
 ]]></Body>
				</Function>
