			<Name><![CDATA[Result]]></Name>
			<Text><![CDATA[/**
 * Result
 */	
public class Result implements Serializable {

	 String agent_id;

	 int cycle;
	 
	 int IO;
	 
	 int S;

	 int I;

	 int B;
	 
	 int O;
	 
	 int ITI1;
	 
	 int ITI2;
	 
	 int WIPI1;
	 
	 int WIPI2;
	 
	 int PSR;

	 double uihc;

	 double ubc;

	 double TC;
	 
	 double sl_des;
	 
	 double eecd;
	 
	 int ei;
	 
	 double eo;
	 
	 double ia;
	 
	 int sl;
	 
	 double sla;
	 
	 int ti;
	 

    /**
     * Default constructor
     */
    public Result() {
    }

    /**
     * Constructor initializing the fields
     */
    public Result(String agent_id, int cycle, int IO, int S, int I, int B, int O, int ITI1, int ITI2, int WIPI1, int WIPI2, int PSR, double uihc, double ubc, double TC, double sl_des, double eecd, int ei, double eo, double ia, int sl, double sla, int ti ) {
		this.agent_id = agent_id;
		this.cycle = cycle;
		this.IO = IO;
		this.S = S;
		this.I = I;
		this.B = B;
		this.O = O;
		this.ITI1 = ITI1;
		this.ITI2 = ITI2;
		this.WIPI1 = WIPI1;
		this.WIPI2 = WIPI2;
		this.PSR = PSR;
		this.uihc = uihc;
		this.ubc = ubc;
		this.TC = TC;
		this.sl_des = sl_des;
		this.eecd = eecd;
		this.ei = ei;
		this.eo = eo;
		this.ia = ia;
		this.sl = sl;
		this.sla = sla;
		this.ti = ti;
    }

	@Override
	public String toString() {
		return  
			"agent_id = " + agent_id +" " +
			"cycle = " + cycle +" " +
			"IO = " + IO + " "+
			"S = " + S + " " + 
			"I = " + I +" " +
			"B = " + B +" " +
			"O = " + O +" " +
			"ITI1 = " + ITI1 +" " +
			"ITI2 = " + ITI2 +" " +
			"WIPI1 = " + WIPI1 +" " +
			"WIPI2 = " + WIPI2 +" " +
			"PSR = " + PSR +" " +			
			"uihc = " + uihc +" " +
			"ubc = " + ubc +" " +
			"TC = " + TC +" " +
			"sl_des = " + sl_des +" " +
			"eecd = " + eecd +" " +
			"ei = " + ei +" " +
			"eo = " + eo +" " +
			"ia = " + ia +" " +
			"sl = " + sl + " " +
			"sla = " + sla + " " +
			"ti = " + ti + " ";
 	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
